---
import Layout from '../../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
import { whatsappLink } from '../../config/site';

const requisitos = [
	"Antes de pensar en fecha o festividades, acercarse al sacerdote mediante WhatsApp para agendar la primera cita de preparación",
	"Presentarse a la parroquia al menos 3 meses antes de la fecha propuesta",
	"Llenar el expediente matrimonial con el sacerdote",
	"Presentar dos testigos que los conozcan a ambos",
	"Partida de nacimiento de ambos contrayentes",
	"Copia de identidad de los contrayentes",
	"Copia de identidad de los testigos",
	"Fotografía tamaño carné de ambos contrayentes",
	"Fe de bautismo de los contrayentes",
	"Constancia de comunión de los contrayentes",
	"Constancia de confirmación de los contrayentes",
	"Constancia de matrimonio civil"
];

const preparacion = [
	{
		titulo: "Primera cita por WhatsApp",
		descripcion: "Antes de fijar fecha, contáctanos por WhatsApp para agendar la primera cita de preparación con el sacerdote.",
		paso: 1
	},
	{
		titulo: "Encuentro inicial",
		descripcion: "Reunión presencial con el sacerdote para conocer su situación y entregar documentación.",
		paso: 2
	},
	{
		titulo: "Expediente matrimonial",
		descripcion: "Completar el expediente canónico con toda la información requerida.",
		paso: 3
	},
	{
		titulo: "Curso prematrimonial",
		descripcion: "Participación en las charlas de preparación al matrimonio.",
		paso: 4
	},
	{
		titulo: "Celebración",
		descripcion: "Coordinación de la fecha, horario y detalles de la ceremonia.",
		paso: 5
	}
];
---

<Layout
	title="Matrimonio | Sacramentos | Parroquia El Salvador del Mundo"
	description="Todo sobre el sacramento del Matrimonio: requisitos, documentos necesarios y preparación para unirse en matrimonio sacramental."
>
	<!-- Hero -->
	<section class="relative min-h-[50vh] lg:min-h-[60vh] flex items-center justify-center overflow-hidden bg-primary hero-clip">
		<div class="absolute inset-0 opacity-30 mix-blend-overlay">
			<div class="absolute inset-0 bg-cover bg-center" style="background-image: url('https://images.unsplash.com/photo-1519741497674-611481863552?q=80&w=2400');"></div>
		</div>
		<div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 50px 50px;"></div>

		<div class="container-tight relative z-10 text-center">
			<div class="inline-flex items-center justify-center w-20 h-20 rounded-3xl bg-white/10 backdrop-blur-sm mb-8">
				<Icon name="lucide:heart" class="w-10 h-10 text-on-primary" />
			</div>
			<h1 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold text-on-primary mb-6">Matrimonio</h1>
			<p class="font-body text-lg lg:text-xl text-primary-fixed max-w-2xl mx-auto">
				Sacramento que une a un hombre y una mujer en alianza perpetua de amor, fidelidad y servicio mutuo.
			</p>
		</div>
	</section>

	<!-- ¿Qué es? -->
	<section class="py-24 lg:py-28 bg-surface border-y border-outline-variant/30">
		<div class="px-6 md:px-margin-desktop max-w-[1280px] mx-auto">

			<!-- Header editorial -->
			<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 mb-16 lg:mb-20 items-end reveal">
				<div class="lg:col-span-7">
					<div class="flex items-center gap-3 mb-6">
						<span class="h-px w-10 bg-secondary"></span>
						<span class="font-label text-xs font-bold uppercase tracking-[0.3em] text-secondary">Sacramento del Amor</span>
					</div>
					<h2 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold text-primary leading-[1.05] tracking-tight">
						¿Qué es el<br/>
						<span class="italic font-medium text-secondary">Matrimonio?</span>
					</h2>
				</div>
				<div class="lg:col-span-5 lg:pb-3">
					<p class="font-body text-base lg:text-lg text-on-surface-variant leading-relaxed">
						La alianza sagrada entre un varón y una mujer, elevada por Cristo a la dignidad de sacramento.
					</p>
				</div>
			</div>

			<!-- Descripción principal -->
			<div class="bg-surface-container-low rounded-2xl p-8 lg:p-12 mb-16 border border-outline-variant/30 reveal">
				<p class="font-display text-xl lg:text-2xl italic text-on-surface leading-relaxed border-l-2 border-secondary pl-6 lg:pl-8 max-w-4xl">
					"El Matrimonio cristiano es una alianza por la cual un varón y una mujer constituyen entre sí un consorcio de toda la vida, ordenado al bien de los cónyuges y a la generación y educación de la prole. Es signo del amor de Cristo a su Iglesia: un amor fiel, total y fecundo."
				</p>
			</div>

			<!-- Pilares — 3 cards numeradas -->
			<div class="grid grid-cols-1 sm:grid-cols-3 gap-px bg-outline-variant/30 border border-outline-variant/30 rounded-xl overflow-hidden">
				<article class="group bg-surface-container-lowest p-8 lg:p-10 flex flex-col hover:bg-surface transition-colors duration-500 reveal h-full min-h-[260px]">
					<div class="flex items-start justify-between mb-6">
						<span class="font-display text-xs font-semibold text-secondary tracking-widest">01</span>
						<div class="w-12 h-12 rounded-full border border-outline-variant/60 flex items-center justify-center text-primary group-hover:border-secondary group-hover:text-secondary transition-all duration-500">
							<Icon name="lucide:infinity" class="w-6 h-6" />
						</div>
					</div>
					<h3 class="font-display text-lg lg:text-xl font-bold text-primary mb-2 leading-tight">Unidad</h3>
					<p class="font-body text-sm text-on-surface-variant leading-relaxed">Una sola carne, una sola vida.</p>
				</article>
				<article class="group bg-surface-container-lowest p-8 lg:p-10 flex flex-col hover:bg-surface transition-colors duration-500 reveal stagger-1 h-full min-h-[260px]">
					<div class="flex items-start justify-between mb-6">
						<span class="font-display text-xs font-semibold text-secondary tracking-widest">02</span>
						<div class="w-12 h-12 rounded-full border border-outline-variant/60 flex items-center justify-center text-primary group-hover:border-secondary group-hover:text-secondary transition-all duration-500">
							<Icon name="lucide:shield-check" class="w-6 h-6" />
						</div>
					</div>
					<h3 class="font-display text-lg lg:text-xl font-bold text-primary mb-2 leading-tight">Fidelidad</h3>
					<p class="font-body text-sm text-on-surface-variant leading-relaxed">Amor exclusivo y eterno.</p>
				</article>
				<article class="group bg-surface-container-lowest p-8 lg:p-10 flex flex-col hover:bg-surface transition-colors duration-500 reveal stagger-2 h-full min-h-[260px]">
					<div class="flex items-start justify-between mb-6">
						<span class="font-display text-xs font-semibold text-secondary tracking-widest">03</span>
						<div class="w-12 h-12 rounded-full border border-outline-variant/60 flex items-center justify-center text-primary group-hover:border-secondary group-hover:text-secondary transition-all duration-500">
							<Icon name="lucide:users" class="w-6 h-6" />
						</div>
					</div>
					<h3 class="font-display text-lg lg:text-xl font-bold text-primary mb-2 leading-tight">Fecundidad</h3>
					<p class="font-body text-sm text-on-surface-variant leading-relaxed">Abiertos a la vida y al amor.</p>
				</article>
			</div>

		</div>
	</section>

	<!-- Requisitos + Importante -->
	<section class="py-24 lg:py-28 bg-surface-container-low">
		<div class="px-6 md:px-margin-desktop max-w-[1280px] mx-auto">

			<!-- Header editorial -->
			<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 mb-16 lg:mb-20 items-end reveal">
				<div class="lg:col-span-7">
					<div class="flex items-center gap-3 mb-6">
						<span class="h-px w-10 bg-secondary"></span>
						<span class="font-label text-xs font-bold uppercase tracking-[0.3em] text-secondary">Documentación</span>
					</div>
					<h2 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold text-primary leading-[1.05] tracking-tight">
						Requisitos<br/>
						<span class="italic font-medium text-secondary">y Documentos</span>
					</h2>
				</div>
				<div class="lg:col-span-5 lg:pb-3">
					<p class="font-body text-base lg:text-lg text-on-surface-variant leading-relaxed">
						Todo lo que la pareja debe presentar para celebrar el matrimonio en nuestra parroquia.
					</p>
				</div>
			</div>

			<!-- Banner de Importante -->
			<div class="bg-primary text-on-primary rounded-2xl p-8 lg:p-12 mb-10 lg:mb-12 reveal shadow-xl">
				<div class="grid grid-cols-1 md:grid-cols-12 gap-6 lg:gap-10 items-center">
					<div class="md:col-span-2 flex justify-center md:justify-start">
						<div class="w-16 h-16 rounded-full border border-on-primary/30 flex items-center justify-center text-primary-fixed">
							<Icon name="lucide:info" class="w-8 h-8" />
						</div>
					</div>
					<div class="md:col-span-10">
						<span class="font-label text-[10px] font-bold uppercase tracking-[0.25em] text-secondary-fixed mb-2 block">Importante</span>
						<p class="font-display text-xl lg:text-2xl italic text-primary-fixed leading-snug">
							<strong class="not-italic font-semibold">Antes de pensar en fecha o festividades,</strong> la pareja debe acercarse al sacerdote mediante WhatsApp para agendar la primera cita de preparación. Es fundamental presentarse con al menos 3 meses de anticipación.
						</p>
					</div>
				</div>
			</div>

			<div class="grid grid-cols-1 lg:grid-cols-12 gap-px bg-outline-variant/30 border border-outline-variant/30 rounded-xl overflow-hidden">

				<!-- Requisitos (8 cols) -->
				<div class="lg:col-span-8 bg-surface-container-lowest p-8 lg:p-12 reveal">
					<div class="space-y-6">
						{requisitos.map((req, i) => (
							<div class="flex items-start gap-5 pb-5 border-b border-outline-variant/30 last:border-0 last:pb-0">
								<span class="font-display text-2xl font-bold text-outline-variant/60 flex-shrink-0">{String(i + 1).padStart(2, '0')}</span>
								<div class="flex-1 pt-1">
									<p class="font-body text-base lg:text-lg text-on-surface leading-relaxed" set:html={i === 0 ? `<strong class="text-primary font-semibold">${req}</strong>` : req}></p>
								</div>
								<Icon name="lucide:check" class="w-5 h-5 text-secondary flex-shrink-0 mt-1" />
							</div>
						))}
					</div>
				</div>

				<!-- Sidebar (4 cols, dark) -->
				<aside class="lg:col-span-4 bg-primary text-on-primary p-8 lg:p-10 reveal stagger-1">
					<span class="font-label text-[10px] font-bold uppercase tracking-[0.25em] text-secondary-fixed mb-6 block">Información Práctica</span>
					<div class="space-y-8">
						<div class="flex items-start gap-4">
							<div class="w-10 h-10 rounded-full border border-on-primary/30 flex items-center justify-center flex-shrink-0 text-primary-fixed">
								<Icon name="lucide:clock" class="w-5 h-5" />
							</div>
							<div>
								<p class="font-label text-xs text-on-primary/70 uppercase tracking-wider mb-1">Anticipación</p>
								<p class="font-body text-sm font-medium text-primary-fixed">3 meses antes</p>
							</div>
						</div>
						<div class="flex items-start gap-4">
							<div class="w-10 h-10 rounded-full border border-on-primary/30 flex items-center justify-center flex-shrink-0 text-primary-fixed">
								<Icon name="lucide:message-circle" class="w-5 h-5" />
							</div>
							<div>
								<p class="font-label text-xs text-on-primary/70 uppercase tracking-wider mb-1">Reserva tu cita</p>
								<p class="font-body text-sm font-medium text-primary-fixed">Por WhatsApp</p>
							</div>
						</div>
					</div>
				</aside>
			</div>

		</div>
	</section>

	<!-- Proceso de Preparación -->
	<section class="py-24 lg:py-28 bg-surface border-y border-outline-variant/30">
		<div class="px-6 md:px-margin-desktop max-w-[1280px] mx-auto">

			<!-- Header editorial -->
			<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 mb-16 lg:mb-20 items-end reveal">
				<div class="lg:col-span-7">
					<div class="flex items-center gap-3 mb-6">
						<span class="h-px w-10 bg-secondary"></span>
						<span class="font-label text-xs font-bold uppercase tracking-[0.3em] text-secondary">Preparación</span>
					</div>
					<h2 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold text-primary leading-[1.05] tracking-tight">
						Pasos<br/>
						<span class="italic font-medium text-secondary">del Proceso</span>
					</h2>
				</div>
				<div class="lg:col-span-5 lg:pb-3">
					<p class="font-body text-base lg:text-lg text-on-surface-variant leading-relaxed">
						Cinco pasos para prepararse y celebrar este sacramento en la parroquia.
					</p>
				</div>
			</div>

			<!-- Pasos — grid bento con 5 cards -->
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-px bg-outline-variant/30 border border-outline-variant/30 rounded-xl overflow-hidden">
				{preparacion.map((item, index) => (
					<article class={`group bg-surface-container-lowest p-8 lg:p-10 flex flex-col hover:bg-surface transition-colors duration-500 reveal stagger-${(index % 4) + 1} h-full min-h-[220px] ${index === 0 ? 'md:col-span-2 lg:col-span-2 bg-surface-container-low' : ''}`}>
						<div class="flex items-start justify-between mb-6">
							<span class="font-display text-5xl lg:text-6xl font-bold text-secondary leading-none tracking-tighter">{String(item.paso).padStart(2, '0')}</span>
							<div class="w-12 h-12 rounded-full border border-outline-variant/60 flex items-center justify-center text-primary group-hover:border-secondary group-hover:text-secondary transition-all duration-500">
								{index === 0 && <Icon name="lucide:message-circle" class="w-6 h-6" />}
								{index === 1 && <Icon name="lucide:users" class="w-6 h-6" />}
								{index === 2 && <Icon name="lucide:file-text" class="w-6 h-6" />}
								{index === 3 && <Icon name="lucide:book-open" class="w-6 h-6" />}
								{index === 4 && <Icon name="lucide:calendar-check" class="w-6 h-6" />}
							</div>
						</div>
						<h3 class="font-display text-xl lg:text-2xl font-bold text-primary mb-3 leading-tight">{item.titulo}</h3>
						<p class="font-body text-sm lg:text-base text-on-surface-variant leading-relaxed">{item.descripcion}</p>
					</article>
				))}
			</div>

		</div>
	</section>

	<!-- Curso Prematrimonial -->
	<section class="py-24 lg:py-28 bg-surface-container-low border-y border-outline-variant/30">
		<div class="px-6 md:px-margin-desktop max-w-[1280px] mx-auto">

			<!-- Header editorial -->
			<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 mb-16 lg:mb-20 items-end reveal">
				<div class="lg:col-span-7">
					<div class="flex items-center gap-3 mb-6">
						<span class="h-px w-10 bg-secondary"></span>
						<span class="font-label text-xs font-bold uppercase tracking-[0.3em] text-secondary">Formación</span>
					</div>
					<h2 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold text-primary leading-[1.05] tracking-tight">
						Curso<br/>
						<span class="italic font-medium text-secondary">Prematrimonial</span>
					</h2>
				</div>
				<div class="lg:col-span-5 lg:pb-3">
					<p class="font-body text-base lg:text-lg text-on-surface-variant leading-relaxed">
						Requisito indispensable que ayuda a las parejas a prepararse para el matrimonio desde una perspectiva cristiana.
					</p>
				</div>
			</div>

			<!-- Temas del curso — 6 cards en grid 3x2 -->
			<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-px bg-outline-variant/30 border border-outline-variant/30 rounded-xl overflow-hidden">
				<article class="group bg-surface-container-lowest p-8 flex flex-col hover:bg-surface transition-colors duration-500 reveal h-full min-h-[180px]">
					<div class="flex items-start justify-between mb-4">
						<span class="font-display text-xs font-semibold text-secondary tracking-widest">01</span>
						<div class="w-10 h-10 rounded-full border border-outline-variant/60 flex items-center justify-center text-primary group-hover:border-secondary group-hover:text-secondary transition-all duration-500">
							<Icon name="lucide:message-circle" class="w-5 h-5" />
						</div>
					</div>
					<h3 class="font-display text-lg font-bold text-primary leading-tight">Comunicación</h3>
					<p class="font-body text-sm text-on-surface-variant leading-relaxed mt-2">En la pareja y la familia.</p>
				</article>
				<article class="group bg-surface-container-lowest p-8 flex flex-col hover:bg-surface transition-colors duration-500 reveal stagger-1 h-full min-h-[180px]">
					<div class="flex items-start justify-between mb-4">
						<span class="font-display text-xs font-semibold text-secondary tracking-widest">02</span>
						<div class="w-10 h-10 rounded-full border border-outline-variant/60 flex items-center justify-center text-primary group-hover:border-secondary group-hover:text-secondary transition-all duration-500">
							<Icon name="lucide:heart" class="w-5 h-5" />
						</div>
					</div>
					<h3 class="font-display text-lg font-bold text-primary leading-tight">Espiritualidad</h3>
					<p class="font-body text-sm text-on-surface-variant leading-relaxed mt-2">Conyugal y vida de fe.</p>
				</article>
				<article class="group bg-surface-container-lowest p-8 flex flex-col hover:bg-surface transition-colors duration-500 reveal stagger-2 h-full min-h-[180px]">
					<div class="flex items-start justify-between mb-4">
						<span class="font-display text-xs font-semibold text-secondary tracking-widest">03</span>
						<div class="w-10 h-10 rounded-full border border-outline-variant/60 flex items-center justify-center text-primary group-hover:border-secondary group-hover:text-secondary transition-all duration-500">
							<Icon name="lucide:users" class="w-5 h-5" />
						</div>
					</div>
					<h3 class="font-display text-lg font-bold text-primary leading-tight">Paternidad</h3>
					<p class="font-body text-sm text-on-surface-variant leading-relaxed mt-2">Responsable y consciente.</p>
				</article>
				<article class="group bg-surface-container-lowest p-8 flex flex-col hover:bg-surface transition-colors duration-500 reveal stagger-3 h-full min-h-[180px]">
					<div class="flex items-start justify-between mb-4">
						<span class="font-display text-xs font-semibold text-secondary tracking-widest">04</span>
						<div class="w-10 h-10 rounded-full border border-outline-variant/60 flex items-center justify-center text-primary group-hover:border-secondary group-hover:text-secondary transition-all duration-500">
							<Icon name="lucide:banknote" class="w-5 h-5" />
						</div>
					</div>
					<h3 class="font-display text-lg font-bold text-primary leading-tight">Economía</h3>
					<p class="font-body text-sm text-on-surface-variant leading-relaxed mt-2">Familiar y planificación.</p>
				</article>
				<article class="group bg-surface-container-lowest p-8 flex flex-col hover:bg-surface transition-colors duration-500 reveal stagger-4 h-full min-h-[180px]">
					<div class="flex items-start justify-between mb-4">
						<span class="font-display text-xs font-semibold text-secondary tracking-widest">05</span>
						<div class="w-10 h-10 rounded-full border border-outline-variant/60 flex items-center justify-center text-primary group-hover:border-secondary group-hover:text-secondary transition-all duration-500">
							<Icon name="lucide:scale" class="w-5 h-5" />
						</div>
					</div>
					<h3 class="font-display text-lg font-bold text-primary leading-tight">Conflictos</h3>
					<p class="font-body text-sm text-on-surface-variant leading-relaxed mt-2">Resolución sana y diálogo.</p>
				</article>
				<article class="group bg-surface-container-lowest p-8 flex flex-col hover:bg-surface transition-colors duration-500 reveal stagger-5 h-full min-h-[180px]">
					<div class="flex items-start justify-between mb-4">
						<span class="font-display text-xs font-semibold text-secondary tracking-widest">06</span>
						<div class="w-10 h-10 rounded-full border border-outline-variant/60 flex items-center justify-center text-primary group-hover:border-secondary group-hover:text-secondary transition-all duration-500">
							<Icon name="lucide:church" class="w-5 h-5" />
						</div>
					</div>
					<h3 class="font-display text-lg font-bold text-primary leading-tight">Sacramento</h3>
					<p class="font-body text-sm text-on-surface-variant leading-relaxed mt-2">El matrimonio en la Iglesia.</p>
				</article>
			</div>

		</div>
	</section>

	<!-- CTA -->
	<section class="section-padding bg-primary">
		<div class="container-tight max-w-3xl text-center">
			<Icon name="mdi:whatsapp" class="w-12 h-12 lg:w-16 lg:h-16 text-on-primary mx-auto mb-6" />
			<h2 class="font-display text-2xl lg:text-3xl font-bold text-on-primary mb-4">Comienza tu camino juntos</h2>
			<p class="font-body text-base lg:text-lg text-on-primary/90 mb-8">
				Contáctanos para iniciar el proceso de preparación al matrimonio sacramental.
			</p>
			<div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
				<a
					href={whatsappLink('Hola, quisiera información sobre el Matrimonio')}
					target="_blank"
					class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-on-primary text-primary px-6 lg:px-8 py-3 lg:py-4 rounded-lg font-label text-sm font-semibold hover:bg-surface-container-low transition-all duration-300"
				>
					<Icon name="mdi:whatsapp" class="w-5 h-5" />
					Contactar por WhatsApp
				</a>
				<a
					href="/sacramentos"
					class="w-full sm:w-auto inline-flex items-center justify-center gap-2 border-2 border-on-primary text-on-primary px-6 lg:px-8 py-3 lg:py-4 rounded-lg font-label text-sm font-semibold hover:bg-white/10 transition-all duration-300"
				>
					Ver todos los sacramentos
				</a>
			</div>
		</div>
	</section>
</Layout>
