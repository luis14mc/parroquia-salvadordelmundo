---
import Layout from '../../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';

const requisitos = [
	"Presentarse a la parroquia al menos 3 meses antes de la fecha propuesta",
	"Llenar el expediente matrimonial con el sacerdote",
	"Presentar dos testigos que los conozcan a ambos",
	"Partida de nacimiento de ambos contrayentes",
	"Copia de identidad de los contrayentes",
	"Copia de identidad de los testigos",
	"Fotografía tamaño carné de ambos contrayentes",
	"Fe de bautismo de los contrayentes",
	"Constancia de comunión de los contrayentes",
	"Constancia de confirmación de los contrayentes",
	"Constancia de matrimonio civil"
];

const preparacion = [
	{
		titulo: "Encuentro inicial",
		descripcion: "Reunión con el sacerdote para conocer su situación y entregar documentación.",
		paso: 1
	},
	{
		titulo: "Expediente matrimonial",
		descripcion: "Completar el expediente canónico con toda la información requerida.",
		paso: 2
	},
	{
		titulo: "Curso prematrimonial",
		descripcion: "Participación en las charlas de preparación al matrimonio.",
		paso: 3
	},
	{
		titulo: "Celebración",
		descripcion: "Coordinación de la fecha, horario y detalles de la ceremonia.",
		paso: 4
	}
];
---

<Layout 
	title="Matrimonio | Sacramentos | Parroquia El Salvador del Mundo"
	description="Todo sobre el sacramento del Matrimonio: requisitos, documentos necesarios y preparación para unirse en matrimonio sacramental."
>
	<!-- Hero -->
	<section class="relative min-h-[50vh] lg:min-h-[60vh] flex items-center justify-center overflow-hidden bg-gradient-to-br from-rose-900 to-rose-800">
		<div class="absolute inset-0 opacity-10">
			<div class="absolute inset-0" style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 50px 50px;"></div>
		</div>
		
		<div class="container-tight relative z-10 text-center">
			<div class="inline-flex items-center justify-center w-16 h-16 lg:w-20 lg:h-20 rounded-2xl lg:rounded-3xl bg-white/10 backdrop-blur-sm mb-6 lg:mb-8">
				<Icon name="lucide:heart" class="w-8 h-8 lg:w-10 lg:h-10 text-white" />
			</div>
			<h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-4 lg:mb-6">Matrimonio</h1>
			<p class="text-lg lg:text-xl text-white/80 max-w-2xl mx-auto">
				Sacramento que une a un hombre y una mujer en alianza perpetua de amor, fidelidad y servicio mutuo.
			</p>
		</div>
	</section>

	<!-- ¿Qué es? -->
	<section class="section-padding bg-white">
		<div class="container-tight max-w-4xl">
			<div class="text-center mb-12 lg:mb-16">
				<span class="text-xs font-bold uppercase tracking-[0.3em] text-primary mb-4 block">Sacramento del Amor</span>
				<h2 class="text-3xl lg:text-4xl font-bold text-slate-900 mb-6">¿Qué es el Matrimonio?</h2>
			</div>

			<div class="prose prose-slate max-w-none">
				<div class="bg-slate-50 rounded-2xl lg:rounded-3xl p-6 lg:p-8 mb-8">
					<p class="text-base lg:text-lg text-slate-700 leading-relaxed mb-4">
						El Matrimonio cristiano es una alianza por la cual un varón y una mujer constituyen entre sí un consorcio de toda la vida, ordenado por su misma índole natural al bien de los cónyuges y a la generación y educación de la prole.
					</p>
					<p class="text-base lg:text-lg text-slate-700 leading-relaxed mb-0">
						Esta alianza entre bautizados fue elevada por Cristo Señor a la dignidad de sacramento. El matrimonio es signo del amor de Cristo a su Iglesia, un amor fiel, total y fecundo.
					</p>
				</div>

				<div class="grid md:grid-cols-3 gap-6 lg:gap-8">
					<div class="text-center">
						<div class="w-12 h-12 lg:w-14 lg:h-14 rounded-2xl bg-primary/5 flex items-center justify-center mx-auto mb-4">
							<Icon name="lucide:infinity" class="w-6 h-6 lg:w-7 lg:h-7 text-primary" />
						</div>
						<h3 class="font-bold text-slate-900 mb-2 text-sm lg:text-base">Unidad</h3>
						<p class="text-xs lg:text-sm text-slate-600">Una sola carne, una sola vida</p>
					</div>
					
					<div class="text-center">
						<div class="w-12 h-12 lg:w-14 lg:h-14 rounded-2xl bg-primary/5 flex items-center justify-center mx-auto mb-4">
							<Icon name="lucide:shield-check" class="w-6 h-6 lg:w-7 lg:h-7 text-primary" />
						</div>
						<h3 class="font-bold text-slate-900 mb-2 text-sm lg:text-base">Fidelidad</h3>
						<p class="text-xs lg:text-sm text-slate-600">Amor exclusivo y eterno</p>
					</div>
					
					<div class="text-center">
						<div class="w-12 h-12 lg:w-14 lg:h-14 rounded-2xl bg-primary/5 flex items-center justify-center mx-auto mb-4">
							<Icon name="lucide:users" class="w-6 h-6 lg:w-7 lg:h-7 text-primary" />
						</div>
						<h3 class="font-bold text-slate-900 mb-2 text-sm lg:text-base">Fecundidad</h3>
						<p class="text-xs lg:text-sm text-slate-600">Abiertos a la vida</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Requisitos -->
	<section class="section-padding bg-slate-50">
		<div class="container-tight max-w-4xl">
			<div class="text-center mb-12 lg:mb-16">
				<span class="text-xs font-bold uppercase tracking-[0.3em] text-primary mb-4 block">Documentación</span>
				<h2 class="text-3xl lg:text-4xl font-bold text-slate-900 mb-6">Requisitos y Documentos</h2>
				<p class="text-sm lg:text-base text-slate-600 max-w-2xl mx-auto">
					Para celebrar el matrimonio en nuestra parroquia necesitas presentar:
				</p>
			</div>

			<div class="bg-white rounded-2xl lg:rounded-3xl p-6 lg:p-8 shadow-sm border border-slate-100">
				<div class="space-y-3">
					{requisitos.map((req, index) => (
						<div class="flex items-start gap-4 pb-3 border-b border-slate-100 last:border-0">
							<div class="w-7 h-7 rounded-lg bg-primary/10 flex items-center justify-center flex-shrink-0 mt-0.5">
								<span class="text-xs font-bold text-primary">{index + 1}</span>
							</div>
							<p class="text-sm lg:text-base text-slate-700 leading-relaxed pt-0.5">{req}</p>
						</div>
					))}
				</div>

				<div class="mt-8 pt-8 border-t border-slate-200 bg-slate-50 rounded-xl p-6">
					<div class="flex items-start gap-3">
						<Icon name="lucide:info" class="w-5 h-5 text-primary flex-shrink-0 mt-0.5" />
						<div>
							<p class="text-sm font-medium text-slate-900 mb-2">Importante</p>
							<p class="text-sm text-slate-600 leading-relaxed">
								Es fundamental presentarse con <strong>al menos 3 meses de anticipación</strong> a la fecha deseada para dar tiempo al proceso de preparación y trámites necesarios.
							</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Proceso de Preparación -->
	<section class="section-padding bg-white">
		<div class="container-tight max-w-4xl">
			<div class="text-center mb-12 lg:mb-16">
				<span class="text-xs font-bold uppercase tracking-[0.3em] text-primary mb-4 block">Preparación</span>
				<h2 class="text-3xl lg:text-4xl font-bold text-slate-900 mb-6">Pasos del Proceso</h2>
			</div>

			<div class="space-y-6">
				{preparacion.map(item => (
					<div class="flex gap-6 items-start group">
						<div class="w-12 h-12 lg:w-14 lg:h-14 rounded-xl bg-gradient-to-br from-primary/10 to-primary/5 flex items-center justify-center flex-shrink-0 group-hover:from-primary/20 group-hover:to-primary/10 transition-all">
							<span class="text-xl lg:text-2xl font-bold text-primary">{item.paso}</span>
						</div>
						<div class="flex-1 bg-slate-50 rounded-xl p-6 group-hover:bg-slate-100 transition-colors">
							<h3 class="text-lg lg:text-xl font-bold text-slate-900 mb-2">{item.titulo}</h3>
							<p class="text-sm lg:text-base text-slate-600 leading-relaxed">{item.descripcion}</p>
						</div>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- Curso Prematrimonial -->
	<section class="section-padding bg-slate-50">
		<div class="container-tight max-w-4xl">
			<div class="bg-white rounded-2xl lg:rounded-3xl p-8 lg:p-12 border border-slate-100">
				<div class="flex items-start gap-6 mb-6">
					<div class="w-12 h-12 lg:w-14 lg:h-14 rounded-2xl bg-primary/10 flex items-center justify-center flex-shrink-0">
						<Icon name="lucide:graduation-cap" class="w-6 h-6 lg:w-7 lg:h-7 text-primary" />
					</div>
					<div>
						<h2 class="text-2xl lg:text-3xl font-bold text-slate-900 mb-4">Curso Prematrimonial</h2>
						<p class="text-sm lg:text-base text-slate-600 leading-relaxed mb-6">
							El curso prematrimonial es un requisito indispensable que ayuda a las parejas a prepararse para el matrimonio desde una perspectiva cristiana. Los temas incluyen:
						</p>
						<div class="grid sm:grid-cols-2 gap-4">
							<div class="flex items-start gap-2">
								<Icon name="lucide:check-circle" class="w-5 h-5 text-primary flex-shrink-0 mt-0.5" />
								<span class="text-sm text-slate-600">Comunicación en la pareja</span>
							</div>
							<div class="flex items-start gap-2">
								<Icon name="lucide:check-circle" class="w-5 h-5 text-primary flex-shrink-0 mt-0.5" />
								<span class="text-sm text-slate-600">Espiritualidad conyugal</span>
							</div>
							<div class="flex items-start gap-2">
								<Icon name="lucide:check-circle" class="w-5 h-5 text-primary flex-shrink-0 mt-0.5" />
								<span class="text-sm text-slate-600">Paternidad responsable</span>
							</div>
							<div class="flex items-start gap-2">
								<Icon name="lucide:check-circle" class="w-5 h-5 text-primary flex-shrink-0 mt-0.5" />
								<span class="text-sm text-slate-600">Economía familiar</span>
							</div>
							<div class="flex items-start gap-2">
								<Icon name="lucide:check-circle" class="w-5 h-5 text-primary flex-shrink-0 mt-0.5" />
								<span class="text-sm text-slate-600">Resolución de conflictos</span>
							</div>
							<div class="flex items-start gap-2">
								<Icon name="lucide:check-circle" class="w-5 h-5 text-primary flex-shrink-0 mt-0.5" />
								<span class="text-sm text-slate-600">El sacramento del matrimonio</span>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- CTA -->
	<section class="section-padding bg-gradient-to-br from-rose-700 to-rose-600">
		<div class="container-tight max-w-3xl text-center">
			<Icon name="mdi:whatsapp" class="w-12 h-12 lg:w-16 lg:h-16 text-white mx-auto mb-6" />
			<h2 class="text-2xl lg:text-3xl font-bold text-white mb-4">Comienza tu camino juntos</h2>
			<p class="text-base lg:text-lg text-white/90 mb-8">
				Contáctanos para iniciar el proceso de preparación al matrimonio sacramental.
			</p>
			<div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
				<a 
					href="https://wa.me/50495345899?text=Hola,%20quisiera%20información%20sobre%20el%20Matrimonio" 
					target="_blank"
					class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-white text-rose-700 px-6 lg:px-8 py-3 lg:py-4 rounded-full font-medium hover:bg-slate-50 transition-all duration-300 text-sm lg:text-base"
				>
					<Icon name="mdi:whatsapp" class="w-5 h-5" />
					Contactar por WhatsApp
				</a>
				<a 
					href="/sacramentos"
					class="w-full sm:w-auto inline-flex items-center justify-center gap-2 border-2 border-white text-white px-6 lg:px-8 py-3 lg:py-4 rounded-full font-medium hover:bg-white/10 transition-all duration-300 text-sm lg:text-base"
				>
					Ver todos los sacramentos
				</a>
			</div>
		</div>
	</section>
</Layout>
