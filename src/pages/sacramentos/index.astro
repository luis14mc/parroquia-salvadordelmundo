---
import Layout from '../../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';
import { whatsappLink } from '../../config/site';

const allSacramentos = await getCollection('sacramentos');
const bautismo = allSacramentos.find(s => s.data.slug === 'bautismo')?.data;
const communion = allSacramentos.find(s => s.data.slug === 'primera-comunion')?.data;
const confirmacion = allSacramentos.find(s => s.data.slug === 'confirmacion')?.data;
const matrimonio = allSacramentos.find(s => s.data.slug === 'matrimonio')?.data;
const uncion = allSacramentos.find(s => s.data.slug === 'uncion-enfermos')?.data;
---

<Layout
	title="Santos Sacramentos"
	description="Conoce los sacramentos que ofrecemos: Bautismo, Eucaristía, Confirmación, Matrimonio y Unción de los Enfermos."
>
  <!-- Hero Section -->
  <section class="relative min-h-[55vh] flex items-center justify-center overflow-hidden bg-primary hero-clip">
    <div class="absolute inset-0 opacity-30 mix-blend-overlay">
      <div class="absolute inset-0 bg-cover bg-center" style="background-image: url('/img/institucionales/templo_interior.webp');"></div>
    </div>
    <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 50px 50px;"></div>

    <div class="container-tight relative z-10 text-center">
      <div class="inline-flex items-center justify-center w-20 h-20 rounded-3xl bg-white/10 backdrop-blur-sm mb-8">
        <Icon name="lucide:church" class="w-10 h-10 text-on-primary" />
      </div>
      <span class="font-label text-xs font-bold text-on-primary uppercase tracking-[0.25em] mb-4 block">Gracia Divina</span>
      <h1 class="font-display text-4xl sm:text-5xl md:text-6xl font-bold text-on-primary mb-6 leading-tight">Los Santos Sacramentos</h1>
      <p class="font-body text-lg lg:text-xl text-primary-fixed max-w-2xl mx-auto">
        Los sacramentos son signos sensibles y eficaces de la gracia, instituidos por Cristo y confiados a la Iglesia, a través de los cuales se nos otorga la vida divina.
      </p>
    </div>
  </section>

  <main class="px-6 md:px-margin-desktop max-w-[1280px] mx-auto py-20 lg:py-24 space-y-20 lg:space-y-28">

    <!-- Bautismo — imagen izquierda -->
    {bautismo && (
      <article class="grid grid-cols-1 md:grid-cols-12 gap-8 lg:gap-12 items-center reveal">
        <div class="md:col-span-6 relative aspect-[4/3] rounded-2xl overflow-hidden border border-outline-variant/30 shadow-lg bg-surface-variant">
          <img src="/img/institucionales/bautismo.webp" alt={bautismo.nombre} class="w-full h-full object-cover" loading="lazy" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent"></div>
        </div>
        <div class="md:col-span-6">
          <div class="flex items-center gap-3 mb-4">
            <span class="font-label text-[10px] font-bold uppercase tracking-[0.25em] text-secondary">01 · Iniciación</span>
          </div>
          <div class="flex items-start gap-4 mb-5">
            <div class="w-14 h-14 rounded-full border border-outline-variant/60 flex items-center justify-center text-primary flex-shrink-0">
              <Icon name="lucide:droplets" class="w-7 h-7" />
            </div>
            <h2 class="font-display text-3xl lg:text-4xl font-bold text-primary leading-tight">{bautismo.nombre}</h2>
          </div>
          <p class="font-body text-base lg:text-lg text-on-surface-variant leading-relaxed mb-6">{bautismo.descripcionCorta}</p>
          <ul class="space-y-2 mb-8">
            {bautismo.requisitos.map(req => (
              <li class="flex items-start gap-2 font-body text-sm text-on-surface">
                <Icon name="lucide:check" class="w-4 h-4 text-secondary flex-shrink-0 mt-0.5" />
                <span>{req}</span>
              </li>
            ))}
          </ul>
          <a class="font-label text-xs font-bold uppercase tracking-[0.2em] text-primary hover:text-secondary inline-flex items-center gap-3 group/link" href={`/sacramentos/${bautismo.slug}`}>
            <span class="relative">
              Detalles y proceso
              <span class="absolute left-0 -bottom-1 h-px w-full bg-primary origin-left scale-x-50 group-hover/link:scale-x-100 group-hover/link:bg-secondary transition-all duration-500"></span>
            </span>
            <Icon name="lucide:arrow-right" class="w-4 h-4 group-hover/link:translate-x-1 transition-transform" />
          </a>
        </div>
      </article>
    )}

    <!-- Eucaristía — imagen derecha -->
    {communion && (
      <article class="grid grid-cols-1 md:grid-cols-12 gap-8 lg:gap-12 items-center reveal">
        <div class="md:col-span-6 md:order-2 relative aspect-[4/3] rounded-2xl overflow-hidden border border-outline-variant/30 shadow-lg bg-surface-variant">
          <img src="/img/institucionales/altar_templo.webp" alt={communion.nombre} class="w-full h-full object-cover" loading="lazy" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent"></div>
        </div>
        <div class="md:col-span-6 md:order-1">
          <div class="flex items-center gap-3 mb-4">
            <span class="font-label text-[10px] font-bold uppercase tracking-[0.25em] text-secondary">02 · Iniciación</span>
          </div>
          <div class="flex items-start gap-4 mb-5">
            <div class="w-14 h-14 rounded-full border border-outline-variant/60 flex items-center justify-center text-primary flex-shrink-0">
              <Icon name="lucide:wheat" class="w-7 h-7" />
            </div>
            <h2 class="font-display text-3xl lg:text-4xl font-bold text-primary leading-tight">{communion.nombre}</h2>
          </div>
          <p class="font-body text-base lg:text-lg text-on-surface-variant leading-relaxed mb-6">{communion.descripcionCorta}</p>
          <ul class="space-y-2 mb-8">
            {communion.requisitos.map(req => (
              <li class="flex items-start gap-2 font-body text-sm text-on-surface">
                <Icon name="lucide:check" class="w-4 h-4 text-secondary flex-shrink-0 mt-0.5" />
                <span>{req}</span>
              </li>
            ))}
          </ul>
          <a class="font-label text-xs font-bold uppercase tracking-[0.2em] text-primary hover:text-secondary inline-flex items-center gap-3 group/link" href={`/sacramentos/${communion.slug}`}>
            <span class="relative">
              Detalles y proceso
              <span class="absolute left-0 -bottom-1 h-px w-full bg-primary origin-left scale-x-50 group-hover/link:scale-x-100 group-hover/link:bg-secondary transition-all duration-500"></span>
            </span>
            <Icon name="lucide:arrow-right" class="w-4 h-4 group-hover/link:translate-x-1 transition-transform" />
          </a>
        </div>
      </article>
    )}

    <!-- Confirmación — imagen izquierda -->
    {confirmacion && (
      <article class="grid grid-cols-1 md:grid-cols-12 gap-8 lg:gap-12 items-center reveal">
        <div class="md:col-span-6 relative aspect-[4/3] rounded-2xl overflow-hidden border border-outline-variant/30 shadow-lg bg-surface-variant">
          <img src="/img/institucionales/confirmacion.webp" alt={confirmacion.nombre} class="w-full h-full object-cover" loading="lazy" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent"></div>
        </div>
        <div class="md:col-span-6">
          <div class="flex items-center gap-3 mb-4">
            <span class="font-label text-[10px] font-bold uppercase tracking-[0.25em] text-secondary">03 · Iniciación</span>
          </div>
          <div class="flex items-start gap-4 mb-5">
            <div class="w-14 h-14 rounded-full border border-outline-variant/60 flex items-center justify-center text-primary flex-shrink-0">
              <Icon name="lucide:flame" class="w-7 h-7" />
            </div>
            <h2 class="font-display text-3xl lg:text-4xl font-bold text-primary leading-tight">{confirmacion.nombre}</h2>
          </div>
          <p class="font-body text-base lg:text-lg text-on-surface-variant leading-relaxed mb-6">{confirmacion.descripcionCorta}</p>
          <ul class="space-y-2 mb-8">
            {confirmacion.requisitos.map(req => (
              <li class="flex items-start gap-2 font-body text-sm text-on-surface">
                <Icon name="lucide:check" class="w-4 h-4 text-secondary flex-shrink-0 mt-0.5" />
                <span>{req}</span>
              </li>
            ))}
          </ul>
          <a class="font-label text-xs font-bold uppercase tracking-[0.2em] text-primary hover:text-secondary inline-flex items-center gap-3 group/link" href={`/sacramentos/${confirmacion.slug}`}>
            <span class="relative">
              Detalles y proceso
              <span class="absolute left-0 -bottom-1 h-px w-full bg-primary origin-left scale-x-50 group-hover/link:scale-x-100 group-hover/link:bg-secondary transition-all duration-500"></span>
            </span>
            <Icon name="lucide:arrow-right" class="w-4 h-4 group-hover/link:translate-x-1 transition-transform" />
          </a>
        </div>
      </article>
    )}

    <!-- Matrimonio — imagen derecha -->
    {matrimonio && (
      <article class="grid grid-cols-1 md:grid-cols-12 gap-8 lg:gap-12 items-center reveal">
        <div class="md:col-span-6 md:order-2 relative aspect-[4/3] rounded-2xl overflow-hidden border border-outline-variant/30 shadow-lg bg-surface-variant">
          <img src="https://images.unsplash.com/photo-1519741497674-611481863552?q=80&w=1200" alt={matrimonio.nombre} class="w-full h-full object-cover" loading="lazy" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent"></div>
        </div>
        <div class="md:col-span-6 md:order-1">
          <div class="flex items-center gap-3 mb-4">
            <span class="font-label text-[10px] font-bold uppercase tracking-[0.25em] text-secondary">04 · Servicio</span>
          </div>
          <div class="flex items-start gap-4 mb-5">
            <div class="w-14 h-14 rounded-full border border-outline-variant/60 flex items-center justify-center text-primary flex-shrink-0">
              <Icon name="lucide:heart-handshake" class="w-7 h-7" />
            </div>
            <h2 class="font-display text-3xl lg:text-4xl font-bold text-primary leading-tight">{matrimonio.nombre}</h2>
          </div>
          <p class="font-body text-base lg:text-lg text-on-surface-variant leading-relaxed mb-6">{matrimonio.descripcionCorta}</p>
          <ul class="space-y-2 mb-8">
            {matrimonio.requisitos.slice(0, 4).map(req => (
              <li class="flex items-start gap-2 font-body text-sm text-on-surface">
                <Icon name="lucide:check" class="w-4 h-4 text-secondary flex-shrink-0 mt-0.5" />
                <span>{req}</span>
              </li>
            ))}
          </ul>
          <a class="font-label text-xs font-bold uppercase tracking-[0.2em] text-primary hover:text-secondary inline-flex items-center gap-3 group/link" href={`/sacramentos/${matrimonio.slug}`}>
            <span class="relative">
              Detalles y proceso
              <span class="absolute left-0 -bottom-1 h-px w-full bg-primary origin-left scale-x-50 group-hover/link:scale-x-100 group-hover/link:bg-secondary transition-all duration-500"></span>
            </span>
            <Icon name="lucide:arrow-right" class="w-4 h-4 group-hover/link:translate-x-1 transition-transform" />
          </a>
        </div>
      </article>
    )}

    <!-- Unción de los Enfermos — card oscura, imagen izquierda -->
    {uncion && (
      <article class="grid grid-cols-1 md:grid-cols-12 gap-8 lg:gap-12 items-center reveal bg-primary text-on-primary rounded-2xl overflow-hidden shadow-xl">
        <div class="md:col-span-6 relative aspect-[4/3] md:aspect-auto md:h-full min-h-[300px] overflow-hidden bg-surface-variant">
          <img src="/img/institucionales/uncion-enfermos.webp" alt={uncion.nombre} class="w-full h-full object-cover" loading="lazy" />
          <div class="absolute inset-0 bg-gradient-to-t md:bg-gradient-to-r from-primary/80 via-primary/30 to-transparent"></div>
        </div>
        <div class="md:col-span-6 p-8 lg:p-12">
          <div class="flex items-center gap-3 mb-4">
            <span class="font-label text-[10px] font-bold uppercase tracking-[0.25em] text-secondary-fixed">05 · Sanación</span>
          </div>
          <div class="flex items-start gap-4 mb-5">
            <div class="w-14 h-14 rounded-full border border-on-primary/30 flex items-center justify-center text-primary-fixed flex-shrink-0">
              <Icon name="lucide:cross" class="w-7 h-7" />
            </div>
            <h2 class="font-display text-3xl lg:text-4xl font-bold text-primary-fixed leading-tight">{uncion.nombre}</h2>
          </div>
          <p class="font-body text-base lg:text-lg text-on-primary/85 leading-relaxed mb-6">{uncion.descripcionCorta}</p>
          <ul class="space-y-2 mb-8">
            {uncion.requisitos.slice(0, 3).map(req => (
              <li class="flex items-start gap-2 font-body text-sm text-on-primary/90">
                <Icon name="lucide:check" class="w-4 h-4 text-secondary-fixed flex-shrink-0 mt-0.5" />
                <span>{req}</span>
              </li>
            ))}
          </ul>
          <a class="font-label text-xs font-bold uppercase tracking-[0.2em] text-primary-fixed hover:text-secondary-fixed inline-flex items-center gap-3 group/link" href={`/sacramentos/${uncion.slug}`}>
            <span class="relative">
              Detalles y proceso
              <span class="absolute left-0 -bottom-1 h-px w-full bg-primary-fixed origin-left scale-x-50 group-hover/link:scale-x-100 group-hover/link:bg-secondary-fixed transition-all duration-500"></span>
            </span>
            <Icon name="lucide:arrow-right" class="w-4 h-4 group-hover/link:translate-x-1 transition-transform" />
          </a>
        </div>
      </article>
    )}

    <!-- CTA -->
    <section class="section-padding bg-primary rounded-2xl shadow-xl">
      <div class="container-tight max-w-3xl text-center">
        <Icon name="mdi:whatsapp" class="w-12 h-12 lg:w-16 lg:h-16 text-on-primary mx-auto mb-6" />
        <h2 class="font-display text-2xl lg:text-3xl font-bold text-on-primary mb-4">¿Dudas sobre algún sacramento?</h2>
        <p class="font-body text-base lg:text-lg text-on-primary/90 mb-8">
          Estamos para acompañarte. Escríbenos por WhatsApp y te orientamos sobre el proceso, requisitos y disponibilidad de fechas.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
          <a
            href={whatsappLink('Hola, quisiera información sobre los sacramentos')}
            target="_blank"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-on-primary text-primary px-6 lg:px-8 py-3 lg:py-4 rounded-lg font-label text-sm font-semibold hover:bg-surface-container-low transition-all duration-300"
          >
            <Icon name="mdi:whatsapp" class="w-5 h-5" />
            Contactar por WhatsApp
          </a>
          <a
            href="/oficina"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 border-2 border-on-primary text-on-primary px-6 lg:px-8 py-3 lg:py-4 rounded-lg font-label text-sm font-semibold hover:bg-white/10 transition-all duration-300"
          >
            Ver horarios de atención
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>
