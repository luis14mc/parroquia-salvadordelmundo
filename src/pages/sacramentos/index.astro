---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allSacramentos = await getCollection('sacramentos');
const bautismo = allSacramentos.find(s => s.data.slug === 'bautismo')?.data;
const communion = allSacramentos.find(s => s.data.slug === 'primera-comunion')?.data;
const confirmacion = allSacramentos.find(s => s.data.slug === 'confirmacion')?.data;
const matrimonio = allSacramentos.find(s => s.data.slug === 'matrimonio')?.data;
const uncion = allSacramentos.find(s => s.data.slug === 'uncion-enfermos')?.data;
---

<Layout
	title="Santos Sacramentos"
	description="Conoce los sacramentos que ofrecemos: Bautismo, Eucaristía, Confirmación, Matrimonio y Unción de los Enfermos."
>
  <main class="max-w-[1280px] mx-auto px-6 md:px-margin-desktop py-16">
    <!-- Hero Section -->
    <section class="mb-20 text-center reveal">
      <span class="font-label text-xs font-bold text-secondary uppercase tracking-[0.25em] mb-4 block">Gracia Divina</span>
      <h1 class="font-display text-4xl sm:text-5xl font-bold text-primary mb-6">Los Santos Sacramentos</h1>
      <p class="font-body text-base sm:text-lg text-on-surface-variant max-w-2xl mx-auto leading-relaxed text-balance">
        Los sacramentos son signos sensibles y eficaces de la gracia, instituidos por Cristo y confiados a la Iglesia, a través de los cuales se nos otorga la vida divina.
      </p>
    </section>

    <!-- Bento Grid for Sacraments -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
      
      <!-- Bautismo (7/12 cols) -->
      {bautismo && (
        <div class="col-span-12 md:col-span-7 bg-surface-container-low border border-outline-variant/50 p-8 rounded-xl flex flex-col justify-between hover:shadow-lg transition-all duration-300 group reveal">
          <div>
            <div class="flex items-center gap-3 mb-6">
              <span class="material-symbols-outlined text-secondary text-4xl">water_drop</span>
              <h2 class="font-display text-2xl font-bold text-primary">{bautismo.nombre}</h2>
            </div>
            <p class="font-body text-sm text-on-surface-variant mb-6 leading-relaxed">
              {bautismo.descripcionCorta}
            </p>
            <div class="space-y-3 mb-6">
              <h3 class="font-label text-xs font-bold text-secondary uppercase tracking-widest border-b border-outline-variant/10 pb-1">Requisitos</h3>
              <ul class="space-y-2 font-body text-sm text-on-surface">
                {bautismo.requisitos.map(req => (
                  <li class="flex items-start gap-2">
                    <span class="material-symbols-outlined text-secondary text-sm mt-0.5">check_circle</span>
                    <span>{req}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
          <a class="text-secondary font-label text-xs font-bold uppercase tracking-wider flex items-center gap-2 hover:gap-4 transition-all w-fit mt-4" href={`/sacramentos/${bautismo.slug}`}>
            Detalles y Proceso <span class="material-symbols-outlined text-sm">arrow_forward</span>
          </a>
        </div>
      )}

      <!-- Primera Comunión (5/12 cols) -->
      {communion && (
        <div class="col-span-12 md:col-span-5 bg-surface-container-low border border-outline-variant/50 p-8 rounded-xl flex flex-col justify-between hover:shadow-lg transition-all duration-300 group reveal stagger-1">
          <div>
            <div class="flex items-center gap-3 mb-6">
              <span class="material-symbols-outlined text-secondary text-4xl">restaurant_menu</span>
              <h2 class="font-display text-2xl font-bold text-primary">{communion.nombre}</h2>
            </div>
            <p class="font-body text-sm text-on-surface-variant mb-6 leading-relaxed">
              {communion.descripcionCorta}
            </p>
            <div class="space-y-3 mb-6">
              <h3 class="font-label text-xs font-bold text-secondary uppercase tracking-widest border-b border-outline-variant/10 pb-1">Requisitos</h3>
              <ul class="space-y-2 font-body text-sm text-on-surface">
                {communion.requisitos.map(req => (
                  <li class="flex items-start gap-2">
                    <span class="material-symbols-outlined text-secondary text-sm mt-0.5">check_circle</span>
                    <span>{req}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
          <a class="text-secondary font-label text-xs font-bold uppercase tracking-wider flex items-center gap-2 hover:gap-4 transition-all w-fit mt-4" href={`/sacramentos/${communion.slug}`}>
            Detalles y Proceso <span class="material-symbols-outlined text-sm">arrow_forward</span>
          </a>
        </div>
      )}

      <!-- Confirmación (5/12 cols) -->
      {confirmacion && (
        <div class="col-span-12 md:col-span-5 bg-surface-container-low border border-outline-variant/50 p-8 rounded-xl flex flex-col justify-between hover:shadow-lg transition-all duration-300 group reveal">
          <div>
            <div class="flex items-center gap-3 mb-6">
              <span class="material-symbols-outlined text-secondary text-4xl">local_fire_department</span>
              <h2 class="font-display text-2xl font-bold text-primary">{confirmacion.nombre}</h2>
            </div>
            <p class="font-body text-sm text-on-surface-variant mb-6 leading-relaxed">
              {confirmacion.descripcionCorta}
            </p>
            <div class="space-y-3 mb-6">
              <h3 class="font-label text-xs font-bold text-secondary uppercase tracking-widest border-b border-outline-variant/10 pb-1">Requisitos</h3>
              <ul class="space-y-2 font-body text-sm text-on-surface">
                {confirmacion.requisitos.map(req => (
                  <li class="flex items-start gap-2">
                    <span class="material-symbols-outlined text-secondary text-sm mt-0.5">check_circle</span>
                    <span>{req}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
          <a class="text-secondary font-label text-xs font-bold uppercase tracking-wider flex items-center gap-2 hover:gap-4 transition-all w-fit mt-4" href={`/sacramentos/${confirmacion.slug}`}>
            Detalles y Proceso <span class="material-symbols-outlined text-sm">arrow_forward</span>
          </a>
        </div>
      )}

      <!-- Matrimonio (7/12 cols) -->
      {matrimonio && (
        <div class="col-span-12 md:col-span-7 bg-surface-container-low border border-outline-variant/50 p-8 rounded-xl flex flex-col justify-between hover:shadow-lg transition-all duration-300 group reveal stagger-1">
          <div>
            <div class="flex items-center gap-3 mb-6">
              <span class="material-symbols-outlined text-secondary text-4xl">favorite</span>
              <h2 class="font-display text-2xl font-bold text-primary">{matrimonio.nombre}</h2>
            </div>
            <p class="font-body text-sm text-on-surface-variant mb-6 leading-relaxed">
              {matrimonio.descripcionCorta}
            </p>
            <div class="space-y-3 mb-6">
              <h3 class="font-label text-xs font-bold text-secondary uppercase tracking-widest border-b border-outline-variant/10 pb-1">Requisitos Clave</h3>
              <ul class="space-y-2 font-body text-sm text-on-surface grid grid-cols-1 sm:grid-cols-2 gap-x-4">
                {matrimonio.requisitos.slice(0, 6).map(req => (
                  <li class="flex items-start gap-2">
                    <span class="material-symbols-outlined text-secondary text-sm mt-0.5">check_circle</span>
                    <span>{req}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
          <a class="text-secondary font-label text-xs font-bold uppercase tracking-wider flex items-center gap-2 hover:gap-4 transition-all w-fit mt-4" href={`/sacramentos/${matrimonio.slug}`}>
            Detalles y Proceso <span class="material-symbols-outlined text-sm">arrow_forward</span>
          </a>
        </div>
      )}

      <!-- Unción de los Enfermos (12 cols) -->
      {uncion && (
        <div class="col-span-12 bg-primary text-on-primary p-8 rounded-xl flex flex-col md:flex-row justify-between items-start md:items-center hover:shadow-lg transition-all duration-300 group reveal">
          <div class="max-w-3xl">
            <div class="flex items-center gap-3 mb-4">
              <span class="material-symbols-outlined text-primary-fixed text-4xl">medical_services</span>
              <h2 class="font-display text-2xl font-bold text-primary-fixed">{uncion.nombre}</h2>
            </div>
            <p class="font-body text-sm text-on-primary/80 mb-4 leading-relaxed">
              {uncion.descripcionCorta}
            </p>
            <p class="font-body text-xs text-primary-fixed/70 italic">
              Requisitos: {uncion.requisitos[0]}
            </p>
          </div>
          <a class="mt-6 md:mt-0 bg-surface-container-lowest text-primary px-6 py-3 rounded-lg font-label text-xs font-bold uppercase tracking-widest hover:bg-secondary-container hover:text-on-secondary-container transition-colors shadow" href={`/sacramentos/${uncion.slug}`}>
            Ver Detalles
          </a>
        </div>
      )}

    </div>
  </main>
</Layout>
