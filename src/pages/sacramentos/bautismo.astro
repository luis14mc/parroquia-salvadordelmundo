---
import Layout from '../../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
import { whatsappLink } from '../../config/site';

const requisitos = [
	"Presentar partida de nacimiento del bautizando",
	"Copia de identidad de los padrinos",
	"Haber recibido las charlas prebautismales"
];

const padrinos = [
	"Tener 16 años cumplidos",
	"Haber recibido los sacramentos de iniciación: Bautismo, Primera Comunión y Confirmación",
	"Presentar copia de la constancia de Confirmación",
	"Llevar una vida coherente con la fe y la misión que va a asumir",
	"No ser el padre o la madre del bautizando"
];

const pasos = [
	{
		titulo: "1. Contacto inicial",
		descripcion: "Comunícate con la secretaría parroquial en horario de oficina o por WhatsApp."
	},
	{
		titulo: "2. Documentación",
		descripcion: "Presenta la partida de nacimiento y la identidad de los padrinos."
	},
	{
		titulo: "3. Charlas prebautismales",
		descripcion: "Asiste a las charlas de preparación para padres y padrinos."
	},
	{
		titulo: "4. Programación",
		descripcion: "Se coordina la fecha y hora de la celebración del bautismo."
	}
];
---

<Layout
	title="Bautismo | Sacramentos | Parroquia El Salvador del Mundo"
	description="Información completa sobre el sacramento del Bautismo en nuestra parroquia: requisitos, proceso y cómo prepararse."
>
	<!-- Hero -->
	<section class="relative min-h-[50vh] lg:min-h-[60vh] flex items-center justify-center overflow-hidden bg-primary hero-clip">
		<div class="absolute inset-0 opacity-30 mix-blend-overlay">
			<div class="absolute inset-0 bg-cover bg-center" style="background-image: url('/img/institucionales/bautismo.webp');"></div>
		</div>
		<div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 50px 50px;"></div>

		<div class="container-tight relative z-10 text-center">
			<div class="inline-flex items-center justify-center w-20 h-20 rounded-3xl bg-white/10 backdrop-blur-sm mb-8">
				<Icon name="lucide:droplets" class="w-10 h-10 text-on-primary" />
			</div>
			<h1 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold text-on-primary mb-6">Bautismo</h1>
			<p class="font-body text-lg lg:text-xl text-primary-fixed max-w-2xl mx-auto">
				El primer sacramento de iniciación cristiana, puerta de entrada a la vida en Cristo y a la Iglesia.
			</p>
		</div>
	</section>

	<!-- ¿Qué es? -->
	<section class="py-24 lg:py-28 bg-surface border-y border-outline-variant/30">
		<div class="px-6 md:px-margin-desktop max-w-[1280px] mx-auto">

			<!-- Header editorial -->
			<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 mb-16 lg:mb-20 items-end reveal">
				<div class="lg:col-span-7">
					<div class="flex items-center gap-3 mb-6">
						<span class="h-px w-10 bg-secondary"></span>
						<span class="font-label text-xs font-bold uppercase tracking-[0.3em] text-secondary">Sacramento de Iniciación</span>
					</div>
					<h2 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold text-primary leading-[1.05] tracking-tight">
						¿Qué es el<br/>
						<span class="italic font-medium text-secondary">Bautismo?</span>
					</h2>
				</div>
				<div class="lg:col-span-5 lg:pb-3">
					<p class="font-body text-base lg:text-lg text-on-surface-variant leading-relaxed">
						El fundamento de toda la vida cristiana: la puerta de entrada a la vida en Cristo y a la comunidad de fe.
					</p>
				</div>
			</div>

			<!-- Descripción principal -->
			<div class="bg-surface-container-low rounded-2xl p-8 lg:p-12 mb-16 border border-outline-variant/30 reveal">
				<p class="font-display text-xl lg:text-2xl italic text-on-surface leading-relaxed border-l-2 border-secondary pl-6 lg:pl-8 max-w-4xl">
					"El Bautismo es el fundamento de toda la vida cristiana, el pórtico de la vida en el espíritu y la puerta que abre el acceso a los otros sacramentos. Por el Bautismo somos liberados del pecado y regenerados como hijos de Dios, llegamos a ser miembros de Cristo y somos incorporados a la Iglesia."
				</p>
			</div>

			<!-- Pilares — 3 cards numeradas -->
			<div class="grid grid-cols-1 sm:grid-cols-3 gap-px bg-outline-variant/30 border border-outline-variant/30 rounded-xl overflow-hidden">
				<article class="group bg-surface-container-lowest p-8 lg:p-10 flex flex-col hover:bg-surface transition-colors duration-500 reveal h-full min-h-[260px]">
					<div class="flex items-start justify-between mb-6">
						<span class="font-display text-xs font-semibold text-secondary tracking-widest">01</span>
						<div class="w-12 h-12 rounded-full border border-outline-variant/60 flex items-center justify-center text-primary group-hover:border-secondary group-hover:text-secondary transition-all duration-500">
							<Icon name="lucide:sparkles" class="w-6 h-6" />
						</div>
					</div>
					<h3 class="font-display text-lg lg:text-xl font-bold text-primary mb-2 leading-tight">Purificación</h3>
					<p class="font-body text-sm text-on-surface-variant leading-relaxed">Limpia del pecado original y de todo pecado personal.</p>
				</article>
				<article class="group bg-surface-container-lowest p-8 lg:p-10 flex flex-col hover:bg-surface transition-colors duration-500 reveal stagger-1 h-full min-h-[260px]">
					<div class="flex items-start justify-between mb-6">
						<span class="font-display text-xs font-semibold text-secondary tracking-widest">02</span>
						<div class="w-12 h-12 rounded-full border border-outline-variant/60 flex items-center justify-center text-primary group-hover:border-secondary group-hover:text-secondary transition-all duration-500">
							<Icon name="lucide:users" class="w-6 h-6" />
						</div>
					</div>
					<h3 class="font-display text-lg lg:text-xl font-bold text-primary mb-2 leading-tight">Incorporación</h3>
					<p class="font-body text-sm text-on-surface-variant leading-relaxed">Miembro de la Iglesia, Cuerpo de Cristo.</p>
				</article>
				<article class="group bg-surface-container-lowest p-8 lg:p-10 flex flex-col hover:bg-surface transition-colors duration-500 reveal stagger-2 h-full min-h-[260px]">
					<div class="flex items-start justify-between mb-6">
						<span class="font-display text-xs font-semibold text-secondary tracking-widest">03</span>
						<div class="w-12 h-12 rounded-full border border-outline-variant/60 flex items-center justify-center text-primary group-hover:border-secondary group-hover:text-secondary transition-all duration-500">
							<Icon name="lucide:heart-handshake" class="w-6 h-6" />
						</div>
					</div>
					<h3 class="font-display text-lg lg:text-xl font-bold text-primary mb-2 leading-tight">Nueva vida</h3>
					<p class="font-body text-sm text-on-surface-variant leading-relaxed">Hijo adoptivo de Dios, partícipe de su misión.</p>
				</article>
			</div>

		</div>
	</section>

	<!-- Requisitos -->
	<section class="py-24 lg:py-28 bg-surface-container-low">
		<div class="px-6 md:px-margin-desktop max-w-[1280px] mx-auto">

			<!-- Header editorial -->
			<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 mb-16 lg:mb-20 items-end reveal">
				<div class="lg:col-span-7">
					<div class="flex items-center gap-3 mb-6">
						<span class="h-px w-10 bg-secondary"></span>
						<span class="font-label text-xs font-bold uppercase tracking-[0.3em] text-secondary">Documentación</span>
					</div>
					<h2 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold text-primary leading-[1.05] tracking-tight">
						Requisitos<br/>
						<span class="italic font-medium text-secondary">Necesarios</span>
					</h2>
				</div>
				<div class="lg:col-span-5 lg:pb-3">
					<p class="font-body text-base lg:text-lg text-on-surface-variant leading-relaxed">
						Lo que necesitás presentar para iniciar el proceso de bautismo en nuestra parroquia.
					</p>
				</div>
			</div>

			<div class="grid grid-cols-1 lg:grid-cols-12 gap-px bg-outline-variant/30 border border-outline-variant/30 rounded-xl overflow-hidden">
				<!-- Lista de requisitos (8 cols) -->
				<div class="lg:col-span-8 bg-surface-container-lowest p-8 lg:p-12 reveal">
					<div class="space-y-6">
						{requisitos.map((req, i) => (
							<div class="flex items-start gap-5 pb-5 border-b border-outline-variant/30 last:border-0 last:pb-0">
								<span class="font-display text-2xl font-bold text-outline-variant/60 flex-shrink-0">{String(i + 1).padStart(2, '0')}</span>
								<div class="flex-1 pt-1">
									<p class="font-body text-base lg:text-lg text-on-surface leading-relaxed">{req}</p>
								</div>
								<Icon name="lucide:check" class="w-5 h-5 text-secondary flex-shrink-0 mt-1" />
							</div>
						))}
					</div>
				</div>

				<!-- Sidebar info (4 cols) -->
				<aside class="lg:col-span-4 bg-primary text-on-primary p-8 lg:p-10 reveal stagger-1">
					<span class="font-label text-[10px] font-bold uppercase tracking-[0.25em] text-secondary-fixed mb-6 block">Información Práctica</span>
					<div class="space-y-8">
						<div class="flex items-start gap-4">
							<div class="w-10 h-10 rounded-full border border-on-primary/30 flex items-center justify-center flex-shrink-0 text-primary-fixed">
								<Icon name="lucide:calendar" class="w-5 h-5" />
							</div>
							<div>
								<p class="font-label text-xs text-on-primary/70 uppercase tracking-wider mb-1">Días de atención</p>
								<p class="font-body text-sm font-medium text-primary-fixed">Horarios de oficina</p>
							</div>
						</div>
						<div class="flex items-start gap-4">
							<div class="w-10 h-10 rounded-full border border-on-primary/30 flex items-center justify-center flex-shrink-0 text-primary-fixed">
								<Icon name="lucide:banknote" class="w-5 h-5" />
							</div>
							<div>
								<p class="font-label text-xs text-on-primary/70 uppercase tracking-wider mb-1">Ofrenda sugerida</p>
								<p class="font-body text-sm font-medium text-primary-fixed">L. 50.00</p>
							</div>
						</div>
						<div class="flex items-start gap-4">
							<div class="w-10 h-10 rounded-full border border-on-primary/30 flex items-center justify-center flex-shrink-0 text-primary-fixed">
								<Icon name="lucide:message-circle" class="w-5 h-5" />
							</div>
							<div>
								<p class="font-label text-xs text-on-primary/70 uppercase tracking-wider mb-1">Reserva tu cita</p>
								<p class="font-body text-sm font-medium text-primary-fixed">Por WhatsApp</p>
							</div>
						</div>
					</div>
				</aside>
			</div>

		</div>
	</section>

	<!-- Padrinos de Bautismo -->
	<section class="py-24 lg:py-28 bg-surface border-y border-outline-variant/30">
		<div class="px-6 md:px-margin-desktop max-w-[1280px] mx-auto">

			<!-- Header editorial -->
			<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 mb-16 lg:mb-20 items-end reveal">
				<div class="lg:col-span-7">
					<div class="flex items-center gap-3 mb-6">
						<span class="h-px w-10 bg-secondary"></span>
						<span class="font-label text-xs font-bold uppercase tracking-[0.3em] text-secondary">Testigos de Fe</span>
					</div>
					<h2 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold text-primary leading-[1.05] tracking-tight">
						Los<br/>
						<span class="italic font-medium text-secondary">Padrinos</span>
					</h2>
				</div>
				<div class="lg:col-span-5 lg:pb-3">
					<p class="font-body text-base lg:text-lg text-on-surface-variant leading-relaxed">
						Los padrinos acompañan al bautizando en su caminar de fe. Estos son los requisitos que deben cumplir:
					</p>
				</div>
			</div>

			<div class="grid grid-cols-1 lg:grid-cols-12 gap-px bg-outline-variant/30 border border-outline-variant/30 rounded-xl overflow-hidden">

				<!-- Lista de requisitos (8 cols) -->
				<div class="lg:col-span-8 bg-surface-container-lowest p-8 lg:p-12 reveal">
					<div class="space-y-6">
						{padrinos.map((req, i) => (
							<div class="flex items-start gap-5 pb-5 border-b border-outline-variant/30 last:border-0 last:pb-0">
								<span class="font-display text-2xl font-bold text-outline-variant/60 flex-shrink-0">{String(i + 1).padStart(2, '0')}</span>
								<div class="flex-1 pt-1">
									<p class="font-body text-base lg:text-lg text-on-surface leading-relaxed" set:html={req.replace(/(Confirmación)/, '<strong class="text-primary font-semibold">$1</strong>')}></p>
								</div>
								<Icon name="lucide:check" class="w-5 h-5 text-secondary flex-shrink-0 mt-1" />
							</div>
						))}
					</div>
				</div>

				<!-- Sidebar (4 cols, dark) -->
				<aside class="lg:col-span-4 bg-primary text-on-primary p-8 lg:p-10 reveal stagger-1 flex flex-col justify-between">
					<div>
						<span class="font-label text-[10px] font-bold uppercase tracking-[0.25em] text-secondary-fixed mb-6 block">Dato importante</span>
						<p class="font-display text-xl lg:text-2xl italic text-primary-fixed leading-snug mb-6">
							"La fe se transmite en comunidad: los padrinos son testigos del compromiso bautismal."
						</p>
					</div>
					<div class="flex items-center gap-3 pt-6 border-t border-on-primary/20">
						<div class="w-10 h-10 rounded-full border border-on-primary/30 flex items-center justify-center flex-shrink-0 text-primary-fixed">
							<Icon name="lucide:user-check" class="w-5 h-5" />
						</div>
						<p class="font-body text-xs text-on-primary/80 leading-relaxed">
							Si tienen dudas sobre los requisitos, contáctennos por WhatsApp.
						</p>
					</div>
				</aside>
			</div>

		</div>
	</section>

	<!-- Proceso -->
	<section class="py-24 lg:py-28 bg-surface border-y border-outline-variant/30">
		<div class="px-6 md:px-margin-desktop max-w-[1280px] mx-auto">

			<!-- Header editorial -->
			<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 mb-16 lg:mb-20 items-end reveal">
				<div class="lg:col-span-7">
					<div class="flex items-center gap-3 mb-6">
						<span class="h-px w-10 bg-secondary"></span>
						<span class="font-label text-xs font-bold uppercase tracking-[0.3em] text-secondary">Preparación</span>
					</div>
					<h2 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold text-primary leading-[1.05] tracking-tight">
						Proceso<br/>
						<span class="italic font-medium text-secondary">de Bautismo</span>
					</h2>
				</div>
				<div class="lg:col-span-5 lg:pb-3">
					<p class="font-body text-base lg:text-lg text-on-surface-variant leading-relaxed">
						Cuatro pasos para prepararse y celebrar este sacramento con la comunidad parroquial.
					</p>
				</div>
			</div>

			<!-- Pasos — grid numerado -->
			<div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-outline-variant/30 border border-outline-variant/30 rounded-xl overflow-hidden">
				{pasos.map((paso, index) => (
					<article class={`group bg-surface-container-lowest p-8 lg:p-10 flex flex-col hover:bg-surface transition-colors duration-500 reveal stagger-${(index % 4) + 1} h-full min-h-[220px]`}>
						<div class="flex items-start justify-between mb-6">
							<span class="font-display text-5xl lg:text-6xl font-bold text-secondary leading-none tracking-tighter">{String(index + 1).padStart(2, '0')}</span>
							<div class="w-12 h-12 rounded-full border border-outline-variant/60 flex items-center justify-center text-primary group-hover:border-secondary group-hover:text-secondary transition-all duration-500">
								{index === 0 && <Icon name="lucide:message-circle" class="w-6 h-6" />}
								{index === 1 && <Icon name="lucide:file-text" class="w-6 h-6" />}
								{index === 2 && <Icon name="lucide:book-open" class="w-6 h-6" />}
								{index === 3 && <Icon name="lucide:calendar-check" class="w-6 h-6" />}
							</div>
						</div>
						<h3 class="font-display text-xl lg:text-2xl font-bold text-primary mb-3 leading-tight">{paso.titulo.replace(/^\d+\.\s*/, '')}</h3>
						<p class="font-body text-sm lg:text-base text-on-surface-variant leading-relaxed">{paso.descripcion}</p>
					</article>
				))}
			</div>

		</div>
	</section>

	<!-- CTA -->
	<section class="section-padding bg-primary">
		<div class="container-tight max-w-3xl text-center">
			<Icon name="mdi:whatsapp" class="w-12 h-12 lg:w-16 lg:h-16 text-on-primary mx-auto mb-6" />
			<h2 class="font-display text-2xl lg:text-3xl font-bold text-on-primary mb-4">¿Listo para comenzar?</h2>
			<p class="font-body text-base lg:text-lg text-on-primary/90 mb-8">
				Contáctanos por WhatsApp para iniciar el proceso de bautismo en nuestra parroquia.
			</p>
			<div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
				<a
					href={whatsappLink('Hola, quisiera información sobre el Bautismo')}
					target="_blank"
					class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-on-primary text-primary px-6 lg:px-8 py-3 lg:py-4 rounded-lg font-label text-sm font-semibold hover:bg-surface-container-low transition-all duration-300"
				>
					<Icon name="mdi:whatsapp" class="w-5 h-5" />
					Contactar por WhatsApp
				</a>
				<a
					href="/sacramentos"
					class="w-full sm:w-auto inline-flex items-center justify-center gap-2 border-2 border-on-primary text-on-primary px-6 lg:px-8 py-3 lg:py-4 rounded-lg font-label text-sm font-semibold hover:bg-white/10 transition-all duration-300"
				>
					Ver todos los sacramentos
				</a>
			</div>
		</div>
	</section>
</Layout>
