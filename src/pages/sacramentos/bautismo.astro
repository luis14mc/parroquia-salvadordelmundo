---
import Layout from '../../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';

const requisitos = [
	"Presentar partida de nacimiento del bautizando",
	"Copia de identidad de los padrinos",
	"Haber recibido las charlas prebautismales"
];

const pasos = [
	{
		titulo: "1. Contacto inicial",
		descripcion: "Comunícate con la secretaría parroquial en horario de oficina o por WhatsApp."
	},
	{
		titulo: "2. Documentación",
		descripcion: "Presenta la partida de nacimiento y la identidad de los padrinos."
	},
	{
		titulo: "3. Charlas prebautismales",
		descripcion: "Asiste a las charlas de preparación para padres y padrinos."
	},
	{
		titulo: "4. Programación",
		descripcion: "Se coordina la fecha y hora de la celebración del bautismo."
	}
];
---

<Layout
	title="Bautismo | Sacramentos | Parroquia El Salvador del Mundo"
	description="Información completa sobre el sacramento del Bautismo en nuestra parroquia: requisitos, proceso y cómo prepararse."
>
	<!-- Hero -->
	<section class="relative min-h-[50vh] lg:min-h-[60vh] flex items-center justify-center overflow-hidden bg-tertiary">
		<div class="absolute inset-0 opacity-10">
			<div class="absolute inset-0" style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 50px 50px;"></div>
		</div>

		<div class="container-tight relative z-10 text-center">
			<div class="inline-flex items-center justify-center w-20 h-20 rounded-3xl bg-white/10 backdrop-blur-sm mb-8">
				<Icon name="lucide:droplets" class="w-10 h-10 text-on-tertiary" />
			</div>
			<h1 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold text-on-tertiary mb-6">Bautismo</h1>
			<p class="font-body text-lg lg:text-xl text-tertiary-fixed-dim max-w-2xl mx-auto">
				El primer sacramento de iniciación cristiana, puerta de entrada a la vida en Cristo y a la Iglesia.
			</p>
		</div>
	</section>

	<!-- ¿Qué es? -->
	<section class="section-padding bg-surface">
		<div class="container-tight max-w-4xl">
			<div class="text-center mb-12 lg:mb-16">
				<span class="text-xs font-bold uppercase tracking-[0.3em] text-primary mb-4 block font-label">Sacramento de Iniciación</span>
				<h2 class="font-display text-3xl lg:text-4xl font-bold text-on-background mb-6">¿Qué es el Bautismo?</h2>
			</div>

			<div class="space-y-8">
				<div class="bg-surface-container-low rounded-xl p-6 lg:p-8">
					<p class="font-body text-base lg:text-lg text-on-surface leading-relaxed mb-0">
						El Bautismo es el fundamento de toda la vida cristiana, el pórtico de la vida en el espíritu y la puerta que abre el acceso a los otros sacramentos. Por el Bautismo somos liberados del pecado y regenerados como hijos de Dios, llegamos a ser miembros de Cristo y somos incorporados a la Iglesia y hechos partícipes de su misión.
					</p>
				</div>

				<div class="grid md:grid-cols-3 gap-6 lg:gap-8">
					<div class="text-center">
						<div class="w-14 h-14 rounded-2xl bg-primary-fixed flex items-center justify-center mx-auto mb-4">
							<Icon name="lucide:sparkles" class="w-7 h-7 text-on-primary-fixed-variant" />
						</div>
						<h3 class="font-label text-sm font-semibold text-on-surface mb-2">Purificación</h3>
						<p class="font-body text-xs lg:text-sm text-on-surface-variant">Limpia del pecado original</p>
					</div>

					<div class="text-center">
						<div class="w-14 h-14 rounded-2xl bg-primary-fixed flex items-center justify-center mx-auto mb-4">
							<Icon name="lucide:users" class="w-7 h-7 text-on-primary-fixed-variant" />
						</div>
						<h3 class="font-label text-sm font-semibold text-on-surface mb-2">Incorporación</h3>
						<p class="font-body text-xs lg:text-sm text-on-surface-variant">Miembro de la Iglesia</p>
					</div>

					<div class="text-center">
						<div class="w-14 h-14 rounded-2xl bg-primary-fixed flex items-center justify-center mx-auto mb-4">
							<Icon name="lucide:heart-handshake" class="w-7 h-7 text-on-primary-fixed-variant" />
						</div>
						<h3 class="font-label text-sm font-semibold text-on-surface mb-2">Nueva vida</h3>
						<p class="font-body text-xs lg:text-sm text-on-surface-variant">Hijo adoptivo de Dios</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Requisitos -->
	<section class="section-padding bg-surface-container-low">
		<div class="container-tight max-w-4xl">
			<div class="text-center mb-12 lg:mb-16">
				<span class="text-xs font-bold uppercase tracking-[0.3em] text-primary mb-4 block font-label">Documentación</span>
				<h2 class="font-display text-3xl lg:text-4xl font-bold text-on-background mb-6">Requisitos</h2>
			</div>

			<div class="card-surface-elevated p-6 lg:p-8">
				<div class="space-y-4">
					{requisitos.map(req => (
						<div class="flex items-start gap-4">
							<div class="w-6 h-6 rounded-full bg-primary-fixed flex items-center justify-center flex-shrink-0 mt-0.5">
								<Icon name="lucide:check" class="w-4 h-4 text-on-primary-fixed-variant" />
							</div>
							<p class="font-body text-sm lg:text-base text-on-surface leading-relaxed">{req}</p>
						</div>
					))}
				</div>

				<div class="mt-8 pt-8 border-t border-outline-variant/30 grid sm:grid-cols-2 gap-4">
					<div class="flex items-center gap-3">
						<Icon name="lucide:calendar" class="w-5 h-5 text-outline" />
						<div>
							<p class="font-label text-xs text-on-surface-variant">Días de atención</p>
							<p class="font-body text-sm font-medium text-on-surface">Horarios de oficina</p>
						</div>
					</div>
					<div class="flex items-center gap-3">
						<Icon name="lucide:banknote" class="w-5 h-5 text-outline" />
						<div>
							<p class="font-label text-xs text-on-surface-variant">Ofrenda sugerida</p>
							<p class="font-body text-sm font-medium text-on-surface">L. 50.00</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Proceso -->
	<section class="section-padding bg-surface">
		<div class="container-tight max-w-4xl">
			<div class="text-center mb-12 lg:mb-16">
				<span class="text-xs font-bold uppercase tracking-[0.3em] text-primary mb-4 block font-label">Preparación</span>
				<h2 class="font-display text-3xl lg:text-4xl font-bold text-on-background mb-6">Proceso de Bautismo</h2>
			</div>

			<div class="space-y-6">
				{pasos.map((paso, index) => (
					<div class="flex gap-6 items-start group">
						<div class="w-12 h-12 rounded-2xl bg-primary-fixed flex items-center justify-center flex-shrink-0 group-hover:bg-primary/10 transition-colors">
							<span class="font-display text-lg font-bold text-on-primary-fixed-variant">{index + 1}</span>
						</div>
						<div class="flex-1 pt-1">
							<h3 class="font-display text-lg lg:text-xl font-bold text-on-surface mb-2">{paso.titulo}</h3>
							<p class="font-body text-sm lg:text-base text-on-surface-variant leading-relaxed">{paso.descripcion}</p>
						</div>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- CTA -->
	<section class="section-padding bg-primary">
		<div class="container-tight max-w-3xl text-center">
			<Icon name="mdi:whatsapp" class="w-12 h-12 lg:w-16 lg:h-16 text-on-primary mx-auto mb-6" />
			<h2 class="font-display text-2xl lg:text-3xl font-bold text-on-primary mb-4">¿Listo para comenzar?</h2>
			<p class="font-body text-base lg:text-lg text-on-primary/90 mb-8">
				Contáctanos por WhatsApp para iniciar el proceso de bautismo en nuestra parroquia.
			</p>
			<div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
				<a
					href="https://wa.me/50495345899?text=Hola,%20quisiera%20información%20sobre%20el%20Bautismo"
					target="_blank"
					class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-on-primary text-primary px-6 lg:px-8 py-3 lg:py-4 rounded-lg font-label text-sm font-semibold hover:bg-surface-container-low transition-all duration-300"
				>
					<Icon name="mdi:whatsapp" class="w-5 h-5" />
					Contactar por WhatsApp
				</a>
				<a
					href="/sacramentos"
					class="w-full sm:w-auto inline-flex items-center justify-center gap-2 border-2 border-on-primary text-on-primary px-6 lg:px-8 py-3 lg:py-4 rounded-lg font-label text-sm font-semibold hover:bg-white/10 transition-all duration-300"
				>
					Ver todos los sacramentos
				</a>
			</div>
		</div>
	</section>
</Layout>
