---
import Layout from '../../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';

const requisitos = [
	"Edad de 9 años cumplidos",
	"Partida de bautismo original o copia certificada"
];

const preparacion = [
	{
		titulo: "Catequesis",
		descripcion: "Programa de formación durante todo el año para conocer mejor a Jesús y prepararse dignamente.",
		icono: "lucide:book-open"
	},
	{
		titulo: "Sacramentos previos",
		descripcion: "Haber recibido el sacramento del Bautismo como requisito fundamental.",
		icono: "lucide:check-circle"
	},
	{
		titulo: "Vida en comunidad",
		descripcion: "Participación activa en la vida parroquial y asistencia a la Eucaristía dominical.",
		icono: "lucide:users"
	}
];
---

<Layout 
	title="Primera Comunión | Sacramentos | Parroquia El Salvador del Mundo"
	description="Todo sobre la Primera Comunión: requisitos, preparación y cómo inscribir a tu hijo para recibir por primera vez a Jesús Eucaristía."
>
	<!-- Hero -->
	<section class="relative min-h-[50vh] lg:min-h-[60vh] flex items-center justify-center overflow-hidden bg-gradient-to-br from-amber-900 to-amber-800">
		<div class="absolute inset-0 opacity-10">
			<div class="absolute inset-0" style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 50px 50px;"></div>
		</div>
		
		<div class="container-tight relative z-10 text-center">
			<div class="inline-flex items-center justify-center w-16 h-16 lg:w-20 lg:h-20 rounded-2xl lg:rounded-3xl bg-white/10 backdrop-blur-sm mb-6 lg:mb-8">
				<Icon name="lucide:wheat" class="w-8 h-8 lg:w-10 lg:h-10 text-white" />
			</div>
			<h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-4 lg:mb-6">Primera Comunión</h1>
			<p class="text-lg lg:text-xl text-white/80 max-w-2xl mx-auto">
				Recibir por primera vez el Cuerpo y la Sangre de Cristo en la Sagrada Eucaristía.
			</p>
		</div>
	</section>

	<!-- ¿Qué es? -->
	<section class="section-padding bg-white">
		<div class="container-tight max-w-4xl">
			<div class="text-center mb-12 lg:mb-16">
				<span class="text-xs font-bold uppercase tracking-[0.3em] text-primary mb-4 block">Sacramento de la Eucaristía</span>
				<h2 class="text-3xl lg:text-4xl font-bold text-slate-900 mb-6">¿Qué es la Primera Comunión?</h2>
			</div>

			<div class="prose prose-slate max-w-none">
				<div class="bg-slate-50 rounded-2xl lg:rounded-3xl p-6 lg:p-8 mb-8">
					<p class="text-base lg:text-lg text-slate-700 leading-relaxed mb-4">
						La Primera Comunión es uno de los momentos más importantes en la vida de un católico. Es el día en que un niño o niña recibe por primera vez el sacramento de la Eucaristía, es decir, el Cuerpo y la Sangre de Cristo bajo las especies del pan y del vino.
					</p>
					<p class="text-base lg:text-lg text-slate-700 leading-relaxed mb-0">
						Este sacramento fortalece la unión con Cristo y con la Iglesia, alimentando la vida espiritual del creyente. Es el alimento del alma que nos acompaña en nuestro camino de fe.
					</p>
				</div>

				<div class="grid md:grid-cols-3 gap-6 lg:gap-8">
					<div class="text-center">
						<div class="w-12 h-12 lg:w-14 lg:h-14 rounded-2xl bg-primary/5 flex items-center justify-center mx-auto mb-4">
							<Icon name="lucide:heart" class="w-6 h-6 lg:w-7 lg:h-7 text-primary" />
						</div>
						<h3 class="font-bold text-slate-900 mb-2 text-sm lg:text-base">Encuentro personal</h3>
						<p class="text-xs lg:text-sm text-slate-600">Con Jesús en la Eucaristía</p>
					</div>
					
					<div class="text-center">
						<div class="w-12 h-12 lg:w-14 lg:h-14 rounded-2xl bg-primary/5 flex items-center justify-center mx-auto mb-4">
							<Icon name="lucide:wheat" class="w-6 h-6 lg:w-7 lg:h-7 text-primary" />
						</div>
						<h3 class="font-bold text-slate-900 mb-2 text-sm lg:text-base">Alimento espiritual</h3>
						<p class="text-xs lg:text-sm text-slate-600">Pan de vida eterna</p>
					</div>
					
					<div class="text-center">
						<div class="w-12 h-12 lg:w-14 lg:h-14 rounded-2xl bg-primary/5 flex items-center justify-center mx-auto mb-4">
							<Icon name="lucide:church" class="w-6 h-6 lg:w-7 lg:h-7 text-primary" />
						</div>
						<h3 class="font-bold text-slate-900 mb-2 text-sm lg:text-base">Vida comunitaria</h3>
						<p class="text-xs lg:text-sm text-slate-600">Unión con la Iglesia</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Requisitos -->
	<section class="section-padding bg-slate-50">
		<div class="container-tight max-w-4xl">
			<div class="text-center mb-12 lg:mb-16">
				<span class="text-xs font-bold uppercase tracking-[0.3em] text-primary mb-4 block">Documentación</span>
				<h2 class="text-3xl lg:text-4xl font-bold text-slate-900 mb-6">Requisitos</h2>
			</div>

			<div class="bg-white rounded-2xl lg:rounded-3xl p-6 lg:p-8 shadow-sm border border-slate-100 mb-8">
				<div class="space-y-4">
					{requisitos.map(req => (
						<div class="flex items-start gap-4">
							<div class="w-6 h-6 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0 mt-0.5">
								<Icon name="lucide:check" class="w-4 h-4 text-primary" />
							</div>
							<p class="text-sm lg:text-base text-slate-700 leading-relaxed">{req}</p>
						</div>
					))}
				</div>

				<div class="mt-8 pt-8 border-t border-slate-100 flex items-center gap-3">
					<Icon name="lucide:calendar" class="w-5 h-5 text-slate-400" />
					<div>
						<p class="text-xs text-slate-500">Inscripciones</p>
						<p class="text-sm font-medium text-slate-900">Mes de enero en horarios de oficina</p>
					</div>
				</div>
			</div>

			<!-- Preparación -->
			<div class="text-center mb-8">
				<h3 class="text-2xl lg:text-3xl font-bold text-slate-900 mb-4">Preparación Catequética</h3>
				<p class="text-sm lg:text-base text-slate-600 max-w-2xl mx-auto">
					La preparación para la Primera Comunión incluye:
				</p>
			</div>

			<div class="grid md:grid-cols-3 gap-6">
				{preparacion.map(item => (
					<div class="bg-white rounded-2xl p-6 border border-slate-100">
						<div class="w-12 h-12 rounded-xl bg-primary/5 flex items-center justify-center mb-4">
							<Icon name={item.icono} class="w-6 h-6 text-primary" />
						</div>
						<h4 class="font-bold text-slate-900 mb-2 text-base lg:text-lg">{item.titulo}</h4>
						<p class="text-sm text-slate-600 leading-relaxed">{item.descripcion}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- Importancia para la familia -->
	<section class="section-padding bg-white">
		<div class="container-tight max-w-4xl">
			<div class="bg-gradient-to-br from-slate-50 to-slate-100 rounded-2xl lg:rounded-3xl p-8 lg:p-12">
				<div class="flex items-start gap-6 mb-6">
					<div class="w-12 h-12 lg:w-14 lg:h-14 rounded-2xl bg-primary/10 flex items-center justify-center flex-shrink-0">
						<Icon name="lucide:heart-handshake" class="w-6 h-6 lg:w-7 lg:h-7 text-primary" />
					</div>
					<div>
						<h2 class="text-2xl lg:text-3xl font-bold text-slate-900 mb-4">El Rol de la Familia</h2>
						<p class="text-sm lg:text-base text-slate-600 leading-relaxed mb-4">
							La familia juega un papel fundamental en la preparación del niño para este sacramento. Los padres son los primeros catequistas y deben acompañar a sus hijos en este camino de fe.
						</p>
						<p class="text-sm lg:text-base text-slate-600 leading-relaxed">
							Se recomienda la participación activa en la catequesis familiar y la asistencia regular a la Eucaristía dominical para crear un ambiente de fe en el hogar.
						</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- CTA -->
	<section class="section-padding bg-gradient-to-br from-amber-700 to-amber-600">
		<div class="container-tight max-w-3xl text-center">
			<Icon name="mdi:whatsapp" class="w-12 h-12 lg:w-16 lg:h-16 text-white mx-auto mb-6" />
			<h2 class="text-2xl lg:text-3xl font-bold text-white mb-4">Inscribe a tu hijo</h2>
			<p class="text-base lg:text-lg text-white/90 mb-8">
				Contáctanos para más información sobre las inscripciones y el proceso de preparación.
			</p>
			<div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
				<a 
					href="https://wa.me/50495345899?text=Hola,%20quisiera%20información%20sobre%20la%20Primera%20Comunión" 
					target="_blank"
					class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-white text-amber-700 px-6 lg:px-8 py-3 lg:py-4 rounded-full font-medium hover:bg-slate-50 transition-all duration-300 text-sm lg:text-base"
				>
					<Icon name="mdi:whatsapp" class="w-5 h-5" />
					Contactar por WhatsApp
				</a>
				<a 
					href="/sacramentos"
					class="w-full sm:w-auto inline-flex items-center justify-center gap-2 border-2 border-white text-white px-6 lg:px-8 py-3 lg:py-4 rounded-full font-medium hover:bg-white/10 transition-all duration-300 text-sm lg:text-base"
				>
					Ver todos los sacramentos
				</a>
			</div>
		</div>
	</section>
</Layout>
