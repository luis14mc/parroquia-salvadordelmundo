---
import Layout from '../../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
import { whatsappLink } from '../../config/site';

const requisitos = [
	"Edad de 9 años cumplidos",
	"Partida de bautismo original o copia certificada"
];

const preparacion = [
	{
		titulo: "Catequesis",
		descripcion: "Programa de formación durante todo el año para conocer mejor a Jesús y prepararse dignamente.",
		icono: "lucide:book-open"
	},
	{
		titulo: "Sacramentos previos",
		descripcion: "Haber recibido el sacramento del Bautismo como requisito fundamental.",
		icono: "lucide:check-circle"
	},
	{
		titulo: "Vida en comunidad",
		descripcion: "Participación activa en la vida parroquial y asistencia a la Eucaristía dominical.",
		icono: "lucide:users"
	}
];
---

<Layout
	title="Primera Comunión | Sacramentos | Parroquia El Salvador del Mundo"
	description="Todo sobre la Primera Comunión: requisitos, preparación y cómo inscribir a tu hijo para recibir por primera vez a Jesús Eucaristía."
>
	<!-- Hero -->
	<section class="relative min-h-[50vh] lg:min-h-[60vh] flex items-center justify-center overflow-hidden bg-primary hero-clip">
		<div class="absolute inset-0 opacity-30 mix-blend-overlay">
			<div class="absolute inset-0 bg-cover bg-center" style="background-image: url('/img/institucionales/primera-comunion.webp');"></div>
		</div>
		<div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 50px 50px;"></div>

		<div class="container-tight relative z-10 text-center">
			<div class="inline-flex items-center justify-center w-20 h-20 rounded-3xl bg-white/10 backdrop-blur-sm mb-8">
				<Icon name="lucide:wheat" class="w-10 h-10 text-on-primary" />
			</div>
			<h1 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold text-on-primary mb-6">Primera Comunión</h1>
			<p class="font-body text-lg lg:text-xl text-primary-fixed max-w-2xl mx-auto">
				Recibir por primera vez el Cuerpo y la Sangre de Cristo en la Sagrada Eucaristía.
			</p>
		</div>
	</section>

	<!-- ¿Qué es? -->
	<section class="py-24 lg:py-28 bg-surface border-y border-outline-variant/30">
		<div class="px-6 md:px-margin-desktop max-w-[1280px] mx-auto">

			<!-- Header editorial -->
			<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 mb-16 lg:mb-20 items-end reveal">
				<div class="lg:col-span-7">
					<div class="flex items-center gap-3 mb-6">
						<span class="h-px w-10 bg-secondary"></span>
						<span class="font-label text-xs font-bold uppercase tracking-[0.3em] text-secondary">Sacramento de la Eucaristía</span>
					</div>
					<h2 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold text-primary leading-[1.05] tracking-tight">
						¿Qué es la<br/>
						<span class="italic font-medium text-secondary">Primera Comunión?</span>
					</h2>
				</div>
				<div class="lg:col-span-5 lg:pb-3">
					<p class="font-body text-base lg:text-lg text-on-surface-variant leading-relaxed">
						Uno de los momentos más importantes en la vida de un católico: recibir por primera vez el Cuerpo y la Sangre de Cristo.
					</p>
				</div>
			</div>

			<!-- Descripción principal -->
			<div class="bg-surface-container-low rounded-2xl p-8 lg:p-12 mb-16 border border-outline-variant/30 reveal">
				<p class="font-display text-xl lg:text-2xl italic text-on-surface leading-relaxed border-l-2 border-secondary pl-6 lg:pl-8 max-w-4xl">
					"La Primera Comunión es el día en que un niño o niña recibe por primera vez el sacramento de la Eucaristía, es decir, el Cuerpo y la Sangre de Cristo bajo las especies del pan y del vino. Fortalece la unión con Cristo y con la Iglesia, alimentando la vida espiritual del creyente."
				</p>
			</div>

			<!-- Pilares — 3 cards numeradas -->
			<div class="grid grid-cols-1 sm:grid-cols-3 gap-px bg-outline-variant/30 border border-outline-variant/30 rounded-xl overflow-hidden">
				<article class="group bg-surface-container-lowest p-8 lg:p-10 flex flex-col hover:bg-surface transition-colors duration-500 reveal h-full min-h-[260px]">
					<div class="flex items-start justify-between mb-6">
						<span class="font-display text-xs font-semibold text-secondary tracking-widest">01</span>
						<div class="w-12 h-12 rounded-full border border-outline-variant/60 flex items-center justify-center text-primary group-hover:border-secondary group-hover:text-secondary transition-all duration-500">
							<Icon name="lucide:heart" class="w-6 h-6" />
						</div>
					</div>
					<h3 class="font-display text-lg lg:text-xl font-bold text-primary mb-2 leading-tight">Encuentro personal</h3>
					<p class="font-body text-sm text-on-surface-variant leading-relaxed">Con Jesús vivo en la Eucaristía.</p>
				</article>
				<article class="group bg-surface-container-lowest p-8 lg:p-10 flex flex-col hover:bg-surface transition-colors duration-500 reveal stagger-1 h-full min-h-[260px]">
					<div class="flex items-start justify-between mb-6">
						<span class="font-display text-xs font-semibold text-secondary tracking-widest">02</span>
						<div class="w-12 h-12 rounded-full border border-outline-variant/60 flex items-center justify-center text-primary group-hover:border-secondary group-hover:text-secondary transition-all duration-500">
							<Icon name="lucide:wheat" class="w-6 h-6" />
						</div>
					</div>
					<h3 class="font-display text-lg lg:text-xl font-bold text-primary mb-2 leading-tight">Alimento espiritual</h3>
					<p class="font-body text-sm text-on-surface-variant leading-relaxed">Pan de vida eterna para el alma.</p>
				</article>
				<article class="group bg-surface-container-lowest p-8 lg:p-10 flex flex-col hover:bg-surface transition-colors duration-500 reveal stagger-2 h-full min-h-[260px]">
					<div class="flex items-start justify-between mb-6">
						<span class="font-display text-xs font-semibold text-secondary tracking-widest">03</span>
						<div class="w-12 h-12 rounded-full border border-outline-variant/60 flex items-center justify-center text-primary group-hover:border-secondary group-hover:text-secondary transition-all duration-500">
							<Icon name="lucide:church" class="w-6 h-6" />
						</div>
					</div>
					<h3 class="font-display text-lg lg:text-xl font-bold text-primary mb-2 leading-tight">Vida comunitaria</h3>
					<p class="font-body text-sm text-on-surface-variant leading-relaxed">Unión profunda con la Iglesia.</p>
				</article>
			</div>

		</div>
	</section>

	<!-- Requisitos + Preparación -->
	<section class="py-24 lg:py-28 bg-surface-container-low">
		<div class="px-6 md:px-margin-desktop max-w-[1280px] mx-auto">

			<!-- Header editorial -->
			<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 mb-16 lg:mb-20 items-end reveal">
				<div class="lg:col-span-7">
					<div class="flex items-center gap-3 mb-6">
						<span class="h-px w-10 bg-secondary"></span>
						<span class="font-label text-xs font-bold uppercase tracking-[0.3em] text-secondary">Documentación</span>
					</div>
					<h2 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold text-primary leading-[1.05] tracking-tight">
						Requisitos<br/>
						<span class="italic font-medium text-secondary">y Preparación</span>
					</h2>
				</div>
				<div class="lg:col-span-5 lg:pb-3">
					<p class="font-body text-base lg:text-lg text-on-surface-variant leading-relaxed">
						Lo que necesitás presentar y el camino de formación catequética para recibir este sacramento.
					</p>
				</div>
			</div>

			<div class="grid grid-cols-1 lg:grid-cols-12 gap-px bg-outline-variant/30 border border-outline-variant/30 rounded-xl overflow-hidden">

				<!-- Requisitos (7 cols) -->
				<div class="lg:col-span-7 bg-surface-container-lowest p-8 lg:p-12 reveal">
					<div class="space-y-6">
						{requisitos.map((req, i) => (
							<div class="flex items-start gap-5 pb-5 border-b border-outline-variant/30 last:border-0 last:pb-0">
								<span class="font-display text-2xl font-bold text-outline-variant/60 flex-shrink-0">{String(i + 1).padStart(2, '0')}</span>
								<div class="flex-1 pt-1">
									<p class="font-body text-base lg:text-lg text-on-surface leading-relaxed">{req}</p>
								</div>
								<Icon name="lucide:check" class="w-5 h-5 text-secondary flex-shrink-0 mt-1" />
							</div>
						))}
					</div>
				</div>

				<!-- Sidebar oscura con inscripciones (5 cols) -->
				<aside class="lg:col-span-5 bg-primary text-on-primary p-8 lg:p-10 reveal stagger-1">
					<span class="font-label text-[10px] font-bold uppercase tracking-[0.25em] text-secondary-fixed mb-6 block">Información Práctica</span>
					<div class="space-y-8">
						<div class="flex items-start gap-4">
							<div class="w-10 h-10 rounded-full border border-on-primary/30 flex items-center justify-center flex-shrink-0 text-primary-fixed">
								<Icon name="lucide:calendar" class="w-5 h-5" />
							</div>
							<div>
								<p class="font-label text-xs text-on-primary/70 uppercase tracking-wider mb-1">Inscripciones</p>
								<p class="font-body text-sm font-medium text-primary-fixed">Mes de enero en horarios de oficina</p>
							</div>
						</div>
						<div class="flex items-start gap-4">
							<div class="w-10 h-10 rounded-full border border-on-primary/30 flex items-center justify-center flex-shrink-0 text-primary-fixed">
								<Icon name="lucide:message-circle" class="w-5 h-5" />
							</div>
							<div>
								<p class="font-label text-xs text-on-primary/70 uppercase tracking-wider mb-1">Más información</p>
								<p class="font-body text-sm font-medium text-primary-fixed">Por WhatsApp</p>
							</div>
						</div>
					</div>
				</aside>
			</div>

			<!-- Preparación Catequética — cards -->
			<div class="mt-12 lg:mt-16 reveal">
				<span class="font-label text-[10px] font-bold uppercase tracking-[0.25em] text-secondary mb-4 block">Preparación Catequética</span>
				<h3 class="font-display text-2xl lg:text-3xl font-bold text-primary mb-8 leading-tight">
					El camino de<br/>
					<span class="italic font-medium text-secondary">formación</span>
				</h3>
				<div class="grid grid-cols-1 sm:grid-cols-3 gap-px bg-outline-variant/30 border border-outline-variant/30 rounded-xl overflow-hidden">
					{preparacion.map((item, i) => (
						<article class={`group bg-surface-container-lowest p-8 lg:p-10 flex flex-col hover:bg-surface transition-colors duration-500 reveal stagger-${(i % 4) + 1} h-full min-h-[220px]`}>
							<div class="flex items-start justify-between mb-6">
								<span class="font-display text-5xl lg:text-6xl font-bold text-secondary leading-none tracking-tighter">{String(i + 1).padStart(2, '0')}</span>
								<div class="w-12 h-12 rounded-full border border-outline-variant/60 flex items-center justify-center text-primary group-hover:border-secondary group-hover:text-secondary transition-all duration-500">
									<Icon name={item.icono} class="w-6 h-6" />
								</div>
							</div>
							<h4 class="font-display text-xl lg:text-2xl font-bold text-primary mb-3 leading-tight">{item.titulo}</h4>
							<p class="font-body text-sm lg:text-base text-on-surface-variant leading-relaxed">{item.descripcion}</p>
						</article>
					))}
				</div>
			</div>

		</div>
	</section>

	<!-- Rol de la Familia -->
	<section class="py-24 lg:py-28 bg-surface border-y border-outline-variant/30">
		<div class="px-6 md:px-margin-desktop max-w-[1280px] mx-auto">

			<!-- Header editorial -->
			<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 mb-16 lg:mb-20 items-end reveal">
				<div class="lg:col-span-7">
					<div class="flex items-center gap-3 mb-6">
						<span class="h-px w-10 bg-secondary"></span>
						<span class="font-label text-xs font-bold uppercase tracking-[0.3em] text-secondary">Comunidad Doméstica</span>
					</div>
					<h2 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold text-primary leading-[1.05] tracking-tight">
						El Rol<br/>
						<span class="italic font-medium text-secondary">de la Familia</span>
					</h2>
				</div>
				<div class="lg:col-span-5 lg:pb-3">
					<p class="font-body text-base lg:text-lg text-on-surface-variant leading-relaxed">
						La familia es la primera comunidad de fe y el lugar donde se transmite la vida cristiana.
					</p>
				</div>
			</div>

			<!-- Cita + cards -->
			<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12">

				<!-- Cita principal (7 cols) -->
				<div class="lg:col-span-7 bg-surface-container-low rounded-2xl p-8 lg:p-12 border border-outline-variant/30 reveal">
					<p class="font-display text-xl lg:text-2xl italic text-on-surface leading-relaxed border-l-2 border-secondary pl-6 lg:pl-8 mb-8">
						"La familia juega un papel fundamental en la preparación del niño para este sacramento. Los padres son los primeros catequistas y deben acompañar a sus hijos en este camino de fe."
					</p>
					<p class="font-body text-base lg:text-lg text-on-surface-variant leading-relaxed">
						Se recomienda la participación activa en la catequesis familiar y la asistencia regular a la Eucaristía dominical para crear un ambiente de fe en el hogar.
					</p>
				</div>

				<!-- Card complementaria (5 cols) -->
				<aside class="lg:col-span-5 bg-primary text-on-primary rounded-2xl p-8 lg:p-10 reveal stagger-1 flex flex-col justify-between">
					<div>
						<div class="w-14 h-14 rounded-full border border-on-primary/30 flex items-center justify-center text-primary-fixed mb-6">
							<Icon name="lucide:heart-handshake" class="w-7 h-7" />
						</div>
						<span class="font-label text-[10px] font-bold uppercase tracking-[0.25em] text-secondary-fixed mb-3 block">Acompañamiento</span>
						<h3 class="font-display text-xl lg:text-2xl font-bold text-primary-fixed mb-4 leading-tight">
							Catequesis familiar
						</h3>
						<p class="font-body text-sm lg:text-base text-on-primary/85 leading-relaxed">
							La parroquia ofrece espacios de formación para que los padres acompañen a sus hijos en este sacramento.
						</p>
					</div>
					<div class="mt-8 pt-6 border-t border-on-primary/20">
						<p class="font-body text-xs text-on-primary/70 leading-relaxed">
							Para más información, contáctennos por WhatsApp.
						</p>
					</div>
				</aside>

			</div>

		</div>
	</section>

	<!-- CTA -->
	<section class="section-padding bg-primary">
		<div class="container-tight max-w-3xl text-center">
			<Icon name="mdi:whatsapp" class="w-12 h-12 lg:w-16 lg:h-16 text-on-primary mx-auto mb-6" />
			<h2 class="font-display text-2xl lg:text-3xl font-bold text-on-primary mb-4">Inscribe a tu hijo</h2>
			<p class="font-body text-base lg:text-lg text-on-primary/90 mb-8">
				Contáctanos para más información sobre las inscripciones y el proceso de preparación.
			</p>
			<div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
				<a
					href={whatsappLink('Hola, quisiera información sobre la Primera Comunión')}
					target="_blank"
					class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-on-primary text-primary px-6 lg:px-8 py-3 lg:py-4 rounded-lg font-label text-sm font-semibold hover:bg-surface-container-low transition-all duration-300"
				>
					<Icon name="mdi:whatsapp" class="w-5 h-5" />
					Contactar por WhatsApp
				</a>
				<a
					href="/sacramentos"
					class="w-full sm:w-auto inline-flex items-center justify-center gap-2 border-2 border-on-primary text-on-primary px-6 lg:px-8 py-3 lg:py-4 rounded-lg font-label text-sm font-semibold hover:bg-white/10 transition-all duration-300"
				>
					Ver todos los sacramentos
				</a>
			</div>
		</div>
	</section>
</Layout>
