---
import Layout from '../../layouts/Layout.astro';
import { catequesisProgramas } from '../../config/catequesis';
import { Icon } from 'astro-icon/components';
import { GYMKANA_MIN_AGE } from '../../lib/gymkanaSchema';

const gymkanaCard = {
  slug: 'gymkana',
  nombre: 'Gymkana 2026',
  subtitulo: 'Al Cielo se llega en equipo',
  descripcion: 'Convivencia juvenil el domingo 25 de octubre de 2026 en la Aldea Las Flores. Los equipos se forman el mismo día.',
  imagen: '/img/institucionales/confirmacion.webp',
  edadMinima: GYMKANA_MIN_AGE,
  href: '/gymkana',
  badge: '25 oct 2026',
};
---

<Layout
  title="Inscripciones Parroquiales"
  description="Inscripciones a los procesos de formación y actividades de la Parroquia El Salvador del Mundo: catequesis de adultos, Primera Comunión, Confirmación y Gymkana juvenil."
>
  <section class="relative min-h-[55vh] flex items-center justify-center overflow-hidden bg-primary hero-clip">
    <div class="absolute inset-0 opacity-30 mix-blend-overlay">
      <div class="absolute inset-0 bg-cover bg-center" style="background-image: url('/img/institucionales/templo_interior.webp');"></div>
    </div>
    <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 50px 50px;"></div>

    <div class="container-tight relative z-10 text-center">
      <div class="inline-flex items-center justify-center w-20 h-20 rounded-3xl bg-white/10 backdrop-blur-sm mb-8">
        <Icon name="lucide:scroll-text" class="w-10 h-10 text-on-primary" />
      </div>
      <h1 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold text-on-primary mb-6">Inscripciones Parroquiales</h1>
      <p class="font-body text-lg lg:text-xl text-primary-fixed max-w-2xl mx-auto">
        Catequesis de iniciación cristiana, formación para sacramentos y actividades juveniles. Selecciona el proceso que corresponde y completa tu inscripción en línea.
      </p>
    </div>
  </section>

  <section class="bg-surface py-20 md:py-24">
    <div class="mx-auto max-w-[1280px] px-6 md:px-margin-desktop">

      <!-- Header editorial -->
      <div class="mb-12 max-w-2xl reveal">
        <span class="font-label text-xs font-bold uppercase tracking-[0.25em] text-secondary">Procesos y actividades</span>
        <h2 class="mt-3 font-display text-3xl font-bold text-primary md:text-4xl">Elige tu inscripción</h2>
        <p class="mt-4 font-body text-on-surface-variant">
          Consulta los requisitos de cada proceso antes de completar el formulario. La oficina parroquial se comunicará al número de contacto registrado para dar seguimiento.
        </p>
      </div>

      <!-- Bento: 2x2 cards -->
      <div class="grid gap-8 md:grid-cols-2">
        {catequesisProgramas.map((programa, index) => (
          <article class={`group overflow-hidden rounded-2xl border border-outline-variant/30 bg-surface-container-lowest shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-xl reveal stagger-${(index % 6) + 1}`}>
            <div class="relative aspect-[16/10] overflow-hidden">
              <img
                src={programa.imagen}
                alt={programa.nombre}
                class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-primary/75 via-primary/15 to-transparent"></div>
              <div class="absolute bottom-4 left-4 rounded-full bg-surface/95 px-3 py-1 font-label text-[11px] font-bold uppercase tracking-wider text-primary backdrop-blur-sm">
                Desde {programa.edadMinima} años
              </div>
            </div>

            <div class="flex h-full flex-col p-6">
              <p class="font-label text-xs font-bold uppercase tracking-[0.18em] text-secondary">{programa.subtitulo}</p>
              <h3 class="mt-3 font-display text-xl font-bold text-primary">{programa.nombre}</h3>
              <p class="mt-3 font-body text-sm leading-relaxed text-on-surface-variant">{programa.descripcion}</p>

              <div class="mt-5 border-t border-outline-variant/30 pt-4">
                <p class="mb-2 font-label text-xs font-bold uppercase tracking-wider text-on-surface">Requisitos</p>
                <ul class="space-y-1.5">
                  {programa.requisitos.slice(0, 2).map((requisito) => (
                    <li class="flex items-start gap-2 font-body text-xs text-on-surface-variant">
                      <Icon name="lucide:circle-check" class="mt-0.5 h-4 w-4 shrink-0 text-secondary" />
                      <span>{requisito}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <a
                href={`/catequesis/${programa.slug}`}
                class="mt-6 inline-flex items-center justify-center gap-2 rounded-xl bg-primary px-5 py-3 font-label text-xs font-bold uppercase tracking-widest text-on-primary transition-all hover:bg-primary-container"
              >
                Inscribirme
                <Icon name="lucide:arrow-right" class="h-3.5 w-3.5" />
              </a>
            </div>
          </article>
        ))}

        <!-- Gymkana -->
        <article class="group overflow-hidden rounded-2xl border border-outline-variant/30 bg-surface-container-lowest shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-xl reveal stagger-4">
          <div class="relative aspect-[16/10] overflow-hidden">
            <img
              src={gymkanaCard.imagen}
              alt={gymkanaCard.nombre}
              class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-primary/75 via-primary/15 to-transparent"></div>
            <div class="absolute bottom-4 left-4 rounded-full bg-secondary text-on-secondary px-3 py-1 font-label text-[11px] font-bold uppercase tracking-wider">
              {gymkanaCard.badge}
            </div>
            <div class="absolute top-4 right-4 rounded-full bg-surface/95 px-3 py-1 font-label text-[10px] font-bold uppercase tracking-wider text-primary backdrop-blur-sm">
              Desde {gymkanaCard.edadMinima} años
            </div>
          </div>

          <div class="flex h-full flex-col p-6">
            <p class="font-label text-xs font-bold uppercase tracking-[0.18em] text-secondary">{gymkanaCard.subtitulo}</p>
            <h3 class="mt-3 font-display text-xl font-bold text-primary">{gymkanaCard.nombre}</h3>
            <p class="mt-3 font-body text-sm leading-relaxed text-on-surface-variant">{gymkanaCard.descripcion}</p>

            <div class="mt-5 border-t border-outline-variant/30 pt-4">
              <p class="mb-2 font-label text-xs font-bold uppercase tracking-wider text-on-surface">Información clave</p>
              <ul class="space-y-1.5">
                <li class="flex items-start gap-2 font-body text-xs text-on-surface-variant">
                  <Icon name="lucide:map-pin" class="mt-0.5 h-4 w-4 shrink-0 text-secondary" />
                  <span>Aldea Las Flores · Iglesia Sagrado Corazón de Jesús</span>
                </li>
                <li class="flex items-start gap-2 font-body text-xs text-on-surface-variant">
                  <Icon name="lucide:clock" class="mt-0.5 h-4 w-4 shrink-0 text-secondary" />
                  <span>Domingo 25 de octubre · 8:00 AM – 3:00 PM</span>
                </li>
              </ul>
            </div>

            <a
              href={gymkanaCard.href}
              class="mt-6 inline-flex items-center justify-center gap-2 rounded-xl bg-secondary px-5 py-3 font-label text-xs font-bold uppercase tracking-widest text-on-secondary transition-all hover:opacity-90"
            >
              Inscríbete gratis
              <Icon name="lucide:arrow-right" class="h-3.5 w-3.5" />
            </a>
          </div>
        </article>
      </div>

      <!-- Sección adicional: Catequesis matrimonial -->
      <div class="mt-14 overflow-hidden rounded-2xl border border-secondary/30 bg-primary text-on-primary shadow-lg reveal">
        <div class="grid lg:grid-cols-12">
          <div class="relative min-h-[260px] overflow-hidden lg:col-span-5">
            <img
              src="/img/institucionales/templo-sede.webp"
              alt="Parroquia El Salvador del Mundo"
              class="absolute inset-0 h-full w-full object-cover"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-r from-primary/45 to-primary/75"></div>
            <div class="relative flex h-full min-h-[260px] items-end p-7 md:p-9">
              <div>
                <span class="rounded-full bg-secondary px-3 py-1 font-label text-[10px] font-bold uppercase tracking-wider text-on-secondary">Calendario 2026</span>
                <h3 class="mt-4 font-display text-3xl font-bold leading-tight text-primary-fixed">Catequesis Matrimonial</h3>
              </div>
            </div>
          </div>

          <div class="p-7 md:p-9 lg:col-span-7 lg:p-10">
            <span class="font-label text-xs font-bold uppercase tracking-[0.2em] text-secondary-fixed">Preparación al Matrimonio</span>
            <h3 class="mt-3 font-display text-2xl font-bold text-primary-fixed md:text-3xl">Programa de formación para parejas</h3>
            <p class="mt-4 max-w-2xl font-body text-sm leading-relaxed text-on-primary/80 md:text-base">
              Consulta las fechas y horarios del programa de catequesis de preparación al sacramento del Matrimonio durante 2026.
            </p>

            <div class="mt-6 rounded-xl border border-on-primary/15 bg-on-primary/5 p-5">
              <div class="flex items-start gap-3">
                <Icon name="lucide:calendar-check" class="mt-0.5 h-5 w-5 shrink-0 text-secondary-fixed" />
                <div>
                  <p class="font-label text-[10px] font-bold uppercase tracking-[0.18em] text-secondary-fixed">Próxima jornada</p>
                  <p class="mt-1 font-body text-sm font-semibold text-primary-fixed">14-15 y 21-22 de noviembre de 2026</p>
                  <p class="mt-1 font-body text-xs text-on-primary/70">Sábados 2:00 PM - 5:00 PM · Domingos 9:00 AM - 1:00 PM</p>
                </div>
              </div>
            </div>

            <a
              href="/catequesis/matrimonio"
              class="mt-7 inline-flex items-center gap-2 rounded-xl bg-secondary px-6 py-3.5 font-label text-xs font-bold uppercase tracking-widest text-on-secondary transition-all hover:opacity-90"
            >
              Ver calendario completo
              <Icon name="lucide:arrow-right" class="h-4 w-4" />
            </a>
          </div>
        </div>
      </div>

      <div class="mt-12 rounded-2xl border border-secondary/20 bg-secondary-fixed/20 p-6 md:p-8 reveal">
        <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
          <div>
            <h3 class="font-display text-xl font-bold text-primary">Importante</h3>
            <p class="mt-2 max-w-3xl font-body text-sm leading-relaxed text-on-surface-variant">
              La inscripción en línea registra tus datos para iniciar el proceso. Los documentos indicados en los requisitos deberán presentarse a la parroquia cuando sean solicitados por el equipo pastoral.
            </p>
          </div>
          <a href="/oficina" class="shrink-0 font-label text-xs font-bold uppercase tracking-wider text-secondary hover:underline">
            Contactar oficina parroquial
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>