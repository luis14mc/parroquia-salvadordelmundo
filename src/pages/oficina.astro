---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/ui/Hero.astro';
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';
import { siteConfig, whatsappLink } from '../config/site';
import MapaInteractivo from '../components/ui/MapaInteractivo.astro';

const allHorarios = await getCollection('horarios');
const eucaristiaData = allHorarios.find(h => h.data.tipo === 'eucaristia');
const eucaristias = eucaristiaData?.data.items ?? [];

const confesionData = allHorarios.find(h => h.data.tipo === 'confesion');
const confesiones = confesionData?.data.items ?? [];

const secretariaData = allHorarios.find(h => h.data.tipo === 'secretaria');
const secretaria = secretariaData?.data.items ?? [];
---

<Layout
	title="Oficina y Horarios"
	description="Horarios de misa, confesiones y secretaría parroquial. Contacto, ubicación y servicios de la Parroquia El Salvador del Mundo."
>
  <Hero
    title="Oficina y Horarios"
    subtitle="Un espacio de encuentro, servicio y vida sacramental para nuestra comunidad parroquial."
    image="/img/institucionales/oficina.webp"
  />

  <!-- Header editorial + Horarios -->
  <section class="py-24 lg:py-28 bg-surface border-y border-outline-variant/30">
    <div class="px-6 md:px-margin-desktop max-w-[1280px] mx-auto">

			<!-- Header editorial -->
			<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 mb-16 lg:mb-20 items-end reveal">
				<div class="lg:col-span-7">
					<div class="flex items-center gap-3 mb-6">
						<span class="h-px w-10 bg-secondary"></span>
						<span class="font-label text-xs font-bold uppercase tracking-[0.3em] text-secondary">Vida Litúrgica</span>
					</div>
					<h2 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold text-primary leading-[1.05] tracking-tight">
						Horarios de<br/>
						<span class="italic font-medium text-secondary">Eucaristía</span>
					</h2>
				</div>
				<div class="lg:col-span-5 lg:pb-3">
					<p class="font-body text-base lg:text-lg text-on-surface-variant leading-relaxed">
						Las misas que celebramos en la sede parroquial, entre semana y los domingos.
					</p>
				</div>
			</div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-px bg-outline-variant/30 border border-outline-variant/30 rounded-xl overflow-hidden">

        <!-- Días de Semana -->
        <div class="lg:col-span-7 bg-surface-container-lowest p-8 lg:p-12 reveal">
          <div class="flex items-start gap-4 mb-8">
            <div class="w-14 h-14 rounded-full border border-outline-variant/60 flex items-center justify-center text-primary flex-shrink-0">
              <Icon name="lucide:church" class="w-7 h-7" />
            </div>
            <div>
              <span class="font-label text-[10px] font-bold uppercase tracking-[0.25em] text-secondary">Días de Semana</span>
              <h3 class="font-display text-2xl lg:text-3xl font-bold text-primary leading-tight mt-1">Misas entre semana</h3>
            </div>
          </div>
          <div class="space-y-5">
            {eucaristias.filter(e => !e.dias.toLowerCase().includes('domingo')).map((e, i) => (
              <div class="flex items-center justify-between pb-4 border-b border-outline-variant/30 last:border-0 last:pb-0 gap-4">
                <span class="font-body text-base lg:text-lg text-on-surface flex-1">{e.dias}</span>
                <span class="font-display text-lg lg:text-xl font-bold text-primary whitespace-nowrap">{e.horas}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Domingos -->
        <div class="lg:col-span-5 bg-primary text-on-primary p-8 lg:p-12 reveal stagger-1">
          <div class="flex items-start gap-4 mb-8">
            <div class="w-14 h-14 rounded-full border border-on-primary/30 flex items-center justify-center text-primary-fixed flex-shrink-0">
              <Icon name="lucide:sun" class="w-7 h-7" />
            </div>
            <div>
              <span class="font-label text-[10px] font-bold uppercase tracking-[0.25em] text-secondary-fixed">Domingos</span>
              <h3 class="font-display text-2xl lg:text-3xl font-bold text-primary-fixed leading-tight mt-1">Misas dominicales</h3>
            </div>
          </div>
          <div class="space-y-6">
            {eucaristias.filter(e => e.dias.toLowerCase().includes('domingo')).map(e => {
              const parts = e.horas.split('|').map(s => s.trim());
              const manana = parts.filter(p => !p.includes('5:30') && !p.includes('PM'));
              const tarde = parts.filter(p => p.includes('5:30') || p.includes('PM'));
              return (
                <>
                  {manana.length > 0 && (
                    <div class="pb-5 border-b border-on-primary/20">
                      <p class="font-label text-[10px] font-bold uppercase tracking-[0.25em] text-secondary-fixed mb-2">Mañana</p>
                      <p class="font-display text-xl lg:text-2xl font-bold text-primary-fixed">{manana.join(' | ')}</p>
                    </div>
                  )}
                  {tarde.length > 0 && (
                    <div>
                      <p class="font-label text-[10px] font-bold uppercase tracking-[0.25em] text-secondary-fixed mb-2">Tarde</p>
                      <p class="font-display text-xl lg:text-2xl font-bold text-primary-fixed">{tarde.join(' | ')}</p>
                    </div>
                  )}
                </>
              );
            })}
          </div>
          <div class="mt-10 pt-6 border-t border-on-primary/20">
            <p class="font-body text-xs italic text-on-primary/70 text-center">
              Transmisión en vivo por redes sociales de la misa dominical principal.
            </p>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- Confesiones + Secretaría -->
  <section class="py-24 lg:py-28 bg-surface-container-low">
    <div class="px-6 md:px-margin-desktop max-w-[1280px] mx-auto">

      <!-- Header editorial -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 mb-16 lg:mb-20 items-end reveal">
        <div class="lg:col-span-7">
          <div class="flex items-center gap-3 mb-6">
            <span class="h-px w-10 bg-secondary"></span>
            <span class="font-label text-xs font-bold uppercase tracking-[0.3em] text-secondary">Servicio Pastoral</span>
          </div>
          <h2 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold text-primary leading-[1.05] tracking-tight">
            Confesiones<br/>
            <span class="italic font-medium text-secondary">&nbsp;y Secretaría</span>
          </h2>
        </div>
        <div class="lg:col-span-5 lg:pb-3">
          <p class="font-body text-base lg:text-lg text-on-surface-variant leading-relaxed">
            El sacramento de la reconciliación y los horarios de atención al público en la oficina parroquial.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-12 gap-px bg-outline-variant/30 border border-outline-variant/30 rounded-xl overflow-hidden">

        <!-- Confesiones (7 cols) -->
        <div class="md:col-span-7 bg-surface-container-lowest p-8 lg:p-12 reveal">
          <div class="flex items-start gap-4 mb-8">
            <div class="w-14 h-14 rounded-full border border-outline-variant/60 flex items-center justify-center text-primary flex-shrink-0">
              <Icon name="lucide:sparkles" class="w-7 h-7" />
            </div>
            <div>
              <span class="font-label text-[10px] font-bold uppercase tracking-[0.25em] text-secondary">Sacramento</span>
              <h3 class="font-display text-2xl lg:text-3xl font-bold text-primary leading-tight mt-1">Confesiones</h3>
            </div>
          </div>
          <p class="font-body text-base text-on-surface-variant leading-relaxed mb-8">
            El sacramento de la reconciliación está disponible en los siguientes horarios en la sede parroquial.
          </p>
          <div class="space-y-5">
            {confesiones.map(c => (
              <div class="flex items-start gap-4 pb-4 border-b border-outline-variant/30 last:border-0 last:pb-0">
                <div class="w-10 h-10 rounded-full border border-outline-variant/60 flex items-center justify-center text-primary flex-shrink-0">
                  <Icon name="lucide:clock" class="w-5 h-5" />
                </div>
                <div class="flex-1 pt-1">
                  <p class="font-label text-[10px] font-bold uppercase tracking-[0.2em] text-secondary mb-1">{c.dias}</p>
                  <p class="font-display text-base lg:text-lg font-bold text-primary">{c.horas}</p>
                </div>
              </div>
            ))}
          </div>
          <div class="mt-8 pt-6 border-t border-outline-variant/30">
            <a
              href={whatsappLink('Hola, quisiera información sobre confesiones')}
              target="_blank"
              rel="noopener"
              class="font-label text-xs font-bold uppercase tracking-[0.2em] text-primary hover:text-secondary inline-flex items-center gap-3 group/link"
            >
              <span class="relative">
                Consultar con un sacerdote
                <span class="absolute left-0 -bottom-1 h-px w-full bg-primary origin-left scale-x-50 group-hover/link:scale-x-100 group-hover/link:bg-secondary transition-all duration-500"></span>
              </span>
              <Icon name="lucide:arrow-right" class="w-4 h-4 group-hover/link:translate-x-1 transition-transform" />
            </a>
          </div>
        </div>

        <!-- Secretaría (5 cols, dark) -->
        <div class="md:col-span-5 bg-primary text-on-primary p-8 lg:p-12 reveal stagger-1">
          <div class="flex items-start gap-4 mb-8">
            <div class="w-14 h-14 rounded-full border border-on-primary/30 flex items-center justify-center text-primary-fixed flex-shrink-0">
              <Icon name="lucide:briefcase" class="w-7 h-7" />
            </div>
            <div>
              <span class="font-label text-[10px] font-bold uppercase tracking-[0.25em] text-secondary-fixed">Atención al Público</span>
              <h3 class="font-display text-2xl lg:text-3xl font-bold text-primary-fixed leading-tight mt-1">Secretaría</h3>
            </div>
          </div>
          <div class="space-y-6">
            {secretaria.map((s, i) => (
              <div class="pb-4 border-b border-on-primary/20 last:border-0 last:pb-0">
                <p class="font-label text-[10px] font-bold uppercase tracking-[0.2em] text-secondary-fixed mb-2">{s.dias}</p>
                <p class="font-display text-base lg:text-lg font-bold text-primary-fixed">{s.horas}</p>
              </div>
            ))}
          </div>
          <div class="mt-8 pt-6 border-t border-on-primary/20">
            <p class="font-body text-xs text-on-primary/80 leading-relaxed">
              Para trámites de fe, intenciones de misas o matrimonios, contáctanos directamente.
            </p>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- Contacto directo + Mapa -->
  <section class="py-24 lg:py-28 bg-surface border-y border-outline-variant/30">
    <div class="px-6 md:px-margin-desktop max-w-[1280px] mx-auto">

      <!-- Header editorial -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 mb-16 lg:mb-20 items-end reveal">
        <div class="lg:col-span-7">
          <div class="flex items-center gap-3 mb-6">
            <span class="h-px w-10 bg-secondary"></span>
            <span class="font-label text-xs font-bold uppercase tracking-[0.3em] text-secondary">Contacto Directo</span>
          </div>
          <h2 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold text-primary leading-[1.05] tracking-tight">
            ¿Necesitas<br/>
            <span class="italic font-medium text-secondary">ayuda?</span>
          </h2>
        </div>
        <div class="lg:col-span-5 lg:pb-3">
          <p class="font-body text-base lg:text-lg text-on-surface-variant leading-relaxed">
            Estamos para servirte. Contáctanos por el medio que prefieras o visítanos en la sede parroquial.
          </p>
        </div>
      </div>

      <!-- Bento: 3 columnas de contacto + Mapa -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-outline-variant/30 border border-outline-variant/30 rounded-xl overflow-hidden mb-12">

        <!-- Llamar -->
        <a
          href={siteConfig.contact.telefonoHref}
          class="group bg-surface-container-lowest p-8 lg:p-10 flex flex-col hover:bg-surface transition-colors duration-500 reveal h-full min-h-[200px]"
        >
          <div class="flex items-start justify-between mb-6">
            <span class="font-display text-xs font-semibold text-secondary tracking-widest">01</span>
            <div class="w-14 h-14 rounded-full border border-outline-variant/60 flex items-center justify-center text-primary group-hover:border-secondary group-hover:text-secondary transition-all duration-500">
              <Icon name="lucide:phone" class="w-7 h-7" />
            </div>
          </div>
          <span class="font-label text-[10px] font-bold uppercase tracking-[0.25em] text-secondary mb-2 inline-block">Teléfono</span>
          <p class="font-display text-xl lg:text-2xl font-bold text-primary mb-2">{siteConfig.contact.telefonoDisplay}</p>
          <p class="font-body text-sm text-on-surface-variant leading-relaxed mt-auto">Llámanos en horario de oficina.</p>
        </a>

        <!-- WhatsApp -->
        <a
          href={siteConfig.contact.whatsappHref}
          target="_blank"
          rel="noopener"
          class="group bg-surface-container-lowest p-8 lg:p-10 flex flex-col hover:bg-surface transition-colors duration-500 reveal stagger-1 h-full min-h-[200px]"
        >
          <div class="flex items-start justify-between mb-6">
            <span class="font-display text-xs font-semibold text-secondary tracking-widest">02</span>
            <div class="w-14 h-14 rounded-full border border-outline-variant/60 flex items-center justify-center text-primary group-hover:border-secondary group-hover:text-secondary transition-all duration-500">
              <Icon name="mdi:whatsapp" class="w-7 h-7" />
            </div>
          </div>
          <span class="font-label text-[10px] font-bold uppercase tracking-[0.25em] text-secondary mb-2 inline-block">WhatsApp</span>
          <p class="font-display text-xl lg:text-2xl font-bold text-primary mb-2">{siteConfig.contact.whatsappDisplay}</p>
          <p class="font-body text-sm text-on-surface-variant leading-relaxed mt-auto">Escríbenos cuando quieras.</p>
        </a>

        <!-- Correo -->
        <a
          href={`mailto:${siteConfig.contact.email}`}
          class="group bg-surface-container-lowest p-8 lg:p-10 flex flex-col hover:bg-surface transition-colors duration-500 reveal stagger-2 h-full min-h-[200px]"
        >
          <div class="flex items-start justify-between mb-6">
            <span class="font-display text-xs font-semibold text-secondary tracking-widest">03</span>
            <div class="w-14 h-14 rounded-full border border-outline-variant/60 flex items-center justify-center text-primary group-hover:border-secondary group-hover:text-secondary transition-all duration-500">
              <Icon name="lucide:mail" class="w-7 h-7" />
            </div>
          </div>
          <span class="font-label text-[10px] font-bold uppercase tracking-[0.25em] text-secondary mb-2 inline-block">Correo</span>
          <p class="font-display text-base lg:text-lg font-bold text-primary mb-2 break-all">{siteConfig.contact.email}</p>
          <p class="font-body text-sm text-on-surface-variant leading-relaxed mt-auto">Para consultas formales.</p>
        </a>

      </div>

      <!-- Mapa -->
      <div class="relative reveal rounded-2xl overflow-hidden border border-outline-variant/30 shadow-lg h-[420px]">
        <div class="absolute top-4 left-4 right-4 md:left-6 md:right-auto md:max-w-xs z-10 bg-surface/95 backdrop-blur-md p-4 md:p-5 rounded-xl shadow-xl border border-outline-variant/30">
          <span class="font-label text-[10px] font-bold uppercase tracking-[0.25em] text-secondary mb-1.5 inline-block">Ubicación</span>
          <p class="font-display text-base lg:text-lg font-bold text-primary leading-tight mb-1.5">Sede Parroquial</p>
          <p class="font-body text-xs text-on-surface-variant leading-relaxed">
            {siteConfig.address.street}<br/>
            {siteConfig.address.locality}, {siteConfig.address.country}
          </p>
        </div>
        <div class="w-full h-full relative">
          <MapaInteractivo />
        </div>
      </div>

    </div>
  </section>

</Layout>
