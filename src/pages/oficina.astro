---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../config/site';
import MapaInteractivo from '../components/ui/MapaInteractivo.astro';

const allHorarios = await getCollection('horarios');
const eucaristiaData = allHorarios.find(h => h.data.tipo === 'eucaristia');
const eucaristias = eucaristiaData?.data.items ?? [];

const confesionData = allHorarios.find(h => h.data.tipo === 'confesion');
const confesiones = confesionData?.data.items ?? [];

const secretariaData = allHorarios.find(h => h.data.tipo === 'secretaria');
const secretaria = secretariaData?.data.items ?? [];
---

<Layout title="Oficina y Horarios">
  <!-- Hero Section -->
  <header class="relative w-full h-[400px] flex items-center overflow-hidden bg-primary hero-clip">
    <div class="absolute inset-0 opacity-40 mix-blend-overlay">
      <div 
        class="w-full h-full bg-cover bg-center" 
        style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuAV5gG3bmiCaQpdlIouVdlpx9OFDefaga8jPXD-DLI1YOjikOvdCqUFLN83-b4oXnc6dZGGW-sWtxy8K8pePaBOkf_qg9a-yKLLDt7jDXDFavCXZGne3v54HSuFaEGUms4EC-j2fu2JVR_W_JKkmkbqpJArOeVaoKjaYE05TbhPmXoyT80mqNP3Fcx-jjmlY1ly3ejxNsyUlJ-qa-PbP_gTT80nu11CPEUys2Zb-DMMt0tkfQXTrpo7KrDRf-d9me9U6pWUcNRUxyo')"
      ></div>
    </div>
    <div class="relative w-full px-6 md:px-margin-desktop max-w-[1280px] mx-auto text-on-primary">
      <div class="max-w-2xl reveal">
        <h1 class="font-display text-4xl sm:text-5xl font-bold mb-4">Oficina y Horarios</h1>
        <p class="font-body text-base sm:text-lg text-primary-fixed opacity-90">
          Un espacio de encuentro, servicio y vida sacramental para nuestra comunidad parroquial.
        </p>
      </div>
    </div>
  </header>

  <!-- Bento Grid Content -->
  <section class="py-24 px-6 md:px-margin-desktop max-w-[1280px] mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
      
      <!-- Mass Schedule - Primary Focus (8 cols) -->
      <div class="md:col-span-8 bg-surface-container-low border border-outline-variant/30 rounded-xl p-8 sacred-gradient flex flex-col justify-between reveal">
        <div>
          <div class="flex items-center gap-4 mb-8">
            <div class="w-12 h-12 rounded-full bg-primary flex items-center justify-center text-on-primary shadow">
              <span class="material-symbols-outlined text-2xl">church</span>
            </div>
            <h2 class="font-display text-2xl sm:text-3xl font-bold text-primary">Horarios de Eucaristía</h2>
          </div>
          
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-12">
            <!-- Días de semana -->
            <div class="space-y-6">
              <h3 class="font-label text-xs font-bold text-secondary uppercase tracking-widest border-b border-outline-variant pb-2">Días de Semana</h3>
              {eucaristias.filter(e => !e.dias.toLowerCase().includes('domingo')).map(e => (
                <div class="flex justify-between items-center group py-1">
                  <span class="font-body text-sm text-on-surface font-medium">{e.dias}</span>
                  <span class="font-label text-sm text-primary font-bold">{e.horas}</span>
                </div>
              ))}
            </div>
            
            <!-- Domingos -->
            <div class="space-y-6">
              <h3 class="font-label text-xs font-bold text-secondary uppercase tracking-widest border-b border-outline-variant pb-2">Domingos</h3>
              <div class="flex flex-col space-y-4">
                {eucaristias.filter(e => e.dias.toLowerCase().includes('domingo')).map(e => {
                  const parts = e.horas.split('|').map(s => s.trim());
                  const manana = parts.filter(p => !p.includes('5:30') && !p.includes('PM'));
                  const tarde = parts.filter(p => p.includes('5:30') || p.includes('PM'));
                  return (
                    <>
                      {manana.length > 0 && (
                        <div class="flex justify-between items-center py-1">
                          <span class="font-body text-sm text-on-surface font-medium">Mañana</span>
                          <span class="font-label text-sm text-primary font-bold">{manana.join(' | ')}</span>
                        </div>
                      )}
                      {tarde.length > 0 && (
                        <div class="flex justify-between items-center py-1">
                          <span class="font-body text-sm text-on-surface font-medium">Tarde</span>
                          <span class="font-label text-sm text-primary font-bold">{tarde.join(' | ')}</span>
                        </div>
                      )}
                    </>
                  );
                })}
              </div>
            </div>
          </div>
        </div>
        
        <div class="mt-12 pt-6 border-t border-outline-variant/30">
          <p class="font-body text-xs text-on-surface-variant italic text-center">
            Transmisión en vivo por redes sociales de la misa dominical principal.
          </p>
        </div>
      </div>

      <!-- Confessions Sidebar (4 cols) -->
      <div class="md:col-span-4 bg-inverse-surface text-inverse-on-surface rounded-xl p-8 flex flex-col justify-between reveal stagger-1">
        <div class="mb-8">
          <span class="material-symbols-outlined text-secondary-fixed text-4xl mb-4">auto_awesome</span>
          <h2 class="font-display text-2xl font-bold mb-2">Confesiones</h2>
          <p class="font-body text-sm text-surface-variant opacity-80 mb-8 leading-relaxed">
            El sacramento de la reconciliación está disponible en los siguientes horarios y en la sede parroquial.
          </p>
          
          <ul class="space-y-6">
            {confesiones.map(c => (
              <li class="flex items-start gap-4">
                <span class="material-symbols-outlined text-secondary-fixed mt-0.5">schedule</span>
                <div>
                  <p class="font-label text-xs font-bold text-secondary-fixed uppercase tracking-wider">{c.dias}</p>
                  <p class="font-body text-sm text-surface-container-lowest font-medium mt-0.5">{c.horas}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
        
        <div class="mt-8 pt-4">
          <a 
            href={siteConfig.contact.whatsappHref} 
            target="_blank"
            rel="noopener"
            class="w-full inline-flex items-center justify-center border border-secondary-fixed text-secondary-fixed py-3 rounded font-label text-xs font-bold uppercase tracking-widest hover:bg-secondary-fixed hover:text-inverse-surface transition-all"
          >
            Consultar Sacerdote
          </a>
        </div>
      </div>

      <!-- Office Details (6 cols) -->
      <div class="md:col-span-6 bg-surface-container rounded-xl p-8 border border-outline-variant/20 flex flex-col justify-between reveal">
        <div>
          <h2 class="font-display text-2xl font-bold text-primary mb-6">Atención al Público</h2>
          <div class="space-y-6">
            <div class="flex items-start gap-4">
              <div class="bg-surface-container-high p-2 rounded-lg text-primary flex items-center justify-center">
                <span class="material-symbols-outlined text-2xl">access_time</span>
              </div>
              <div>
                <p class="font-label text-xs font-bold text-on-surface uppercase tracking-wider mb-1">Horario de Oficina</p>
                {secretaria.map(s => (
                  <p class="font-body text-sm text-on-surface-variant leading-relaxed">
                    <span class="font-semibold">{s.dias}:</span> {s.horas}
                  </p>
                ))}
              </div>
            </div>
            
            <div class="flex items-start gap-4">
              <div class="bg-surface-container-high p-2 rounded-lg text-primary flex items-center justify-center">
                <span class="material-symbols-outlined text-2xl">location_on</span>
              </div>
              <div>
                <p class="font-label text-xs font-bold text-on-surface uppercase tracking-wider mb-1">Dirección</p>
                <p class="font-body text-sm text-on-surface-variant leading-relaxed">{siteConfig.address.street}</p>
                <p class="font-body text-xs text-on-surface-variant opacity-70 mt-0.5">{siteConfig.address.locality}</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Contact Form / Quick Action (6 cols) -->
      <div class="md:col-span-6 bg-surface-container-high rounded-xl p-8 border border-outline-variant/20 flex flex-col justify-between reveal stagger-1">
        <div>
          <h2 class="font-display text-2xl font-bold text-primary mb-4">¿Necesitas ayuda?</h2>
          <p class="font-body text-sm text-on-surface-variant mb-8 leading-relaxed">
            Para trámites de fe de bautismo, constancias de confirmación, intenciones de misas o matrimonios, contáctanos directamente.
          </p>
        </div>
        
        <div class="flex flex-wrap gap-4 mt-auto">
          <a 
            class="flex items-center gap-2 bg-primary text-on-primary px-6 py-3 rounded-lg font-label text-xs font-bold uppercase tracking-widest hover:opacity-90 transition-all shadow" 
            href={siteConfig.contact.telefonoHref}
          >
            <span class="material-symbols-outlined text-sm">call</span>
            Llamar
          </a>
          <a 
            class="flex items-center gap-2 bg-surface-container-lowest border border-primary text-primary px-6 py-3 rounded-lg font-label text-xs font-bold uppercase tracking-widest hover:bg-primary hover:text-on-primary transition-all duration-300 shadow-sm" 
            href={siteConfig.contact.whatsappHref}
            target="_blank"
            rel="noopener"
          >
            <span class="material-symbols-outlined text-sm">message</span>
            Whatsapp
          </a>
        </div>
      </div>

      <!-- Interactive Map Section (12 cols) -->
      <div class="md:col-span-12 h-[450px] rounded-xl overflow-hidden border border-outline-variant/30 relative reveal">
        <div class="absolute top-4 left-4 z-10 bg-surface/90 backdrop-blur-md p-4 rounded shadow-lg border border-outline-variant/20 max-w-xs">
          <p class="font-label text-xs font-bold text-primary mb-1 uppercase tracking-wider">Ubicación</p>
          <p class="font-body text-xs text-on-surface-variant leading-relaxed">
            Sede parroquial: Colonia Cerro Grande Zona 4, calle principal. Tegucigalpa, Honduras.
          </p>
        </div>
        <div class="w-full h-full relative">
          <MapaInteractivo />
        </div>
      </div>
      
    </div>
  </section>

  <!-- Newsletter / Community Section -->
  <section class="bg-surface-container-low py-20 px-6 md:px-margin-desktop border-t border-outline-variant/10">
    <div class="max-w-[1280px] mx-auto text-center reveal">
      <span class="font-label text-xs font-bold text-secondary uppercase tracking-[0.2em] mb-4 block">Boletín Parroquial</span>
      <h2 class="font-display text-3xl md:text-4xl font-bold text-primary mb-8">Mantente conectado</h2>
      <form class="max-w-xl mx-auto flex flex-col sm:flex-row gap-4" onsubmit="event.preventDefault(); alert('¡Gracias por unirte a nuestro boletín!');">
        <input 
          class="flex-1 bg-surface border border-outline/30 focus:border-primary focus:ring-1 focus:ring-primary rounded-lg font-body text-sm py-4 px-4 shadow-sm" 
          placeholder="Tu correo electrónico" 
          type="email"
          required
        />
        <button 
          type="submit"
          class="bg-primary text-on-primary px-8 py-4 rounded-lg font-label text-xs font-bold uppercase tracking-widest hover:bg-primary-container transition-all shadow"
        >
          Unirse
        </button>
      </form>
    </div>
  </section>
</Layout>
