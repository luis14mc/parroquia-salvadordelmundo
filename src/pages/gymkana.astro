---
import Layout from '../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
import { siteConfig } from '../config/site';
import { gymkanaSectors, GYMKANA_MIN_AGE, GYMKANA_ADULT_AGE } from '../lib/gymkanaSchema';

export const prerender = false;

const hoy = new Date();
const eventoFecha = new Date('2026-10-25T08:00:00');
const fechaMaximaNacimiento = new Date(
  eventoFecha.getFullYear() - GYMKANA_MIN_AGE,
  eventoFecha.getMonth(),
  eventoFecha.getDate(),
);
const fechaMaximaInput = fechaMaximaNacimiento.toISOString().split('T')[0];
const mensajeEdad = `Debes tener al menos ${GYMKANA_MIN_AGE} años al ${eventoFecha.toLocaleDateString('es-HN', { day: 'numeric', month: 'long', year: 'numeric' })} para participar.`;

const heroImage = '/img/gymkana/jovenes.webp';

const datosEvento = [
  {
    icono: 'lucide:calendar-days',
    etiqueta: 'Fecha',
    valor: 'Domingo 25 de octubre',
    meta: '2026',
  },
  {
    icono: 'lucide:map-pin',
    etiqueta: 'Lugar',
    valor: 'Aldea Las Flores',
    meta: 'Iglesia Sagrado Corazón de Jesús',
  },
  {
    icono: 'lucide:clock',
    etiqueta: 'Horario',
    valor: '8:00 AM – 3:00 PM',
    meta: 'Convivencia de día completo',
  },
];

const detalles = [
  {
    icono: 'lucide:trophy',
    titulo: 'Gymkana por equipos',
    descripcion: 'Los equipos se forman el mismo día. Vení con actitud de colaborar, competir sanamente y pasarla bien.',
  },
  {
    icono: 'lucide:shirt',
    titulo: 'Ropa cómoda',
    descripcion: 'Trae ropa deportiva, tenis cómodos y protección solar. Estaremos al aire libre la mayor parte del día.',
  },
  {
    icono: 'lucide:utensils-crossed',
    titulo: 'Alimentación',
    descripcion: 'El almuerzo está incluido. Si tienes alergias o condiciones médicas, indícalo en el formulario.',
  },
  {
    icono: 'lucide:droplet',
    titulo: 'Hidratación',
    descripcion: 'Lleva tu cantimplora o botella de agua reutilizable. Estaremos en constante movimiento.',
  },
];
---

<Layout
  title="Gymkana — Al Cielo se llega en equipo"
  description="Inscripción para la Gymkana juvenil 'Al Cielo se llega en equipo' de la Parroquia El Salvador del Mundo. Domingo 25 de octubre de 2026, Aldea Las Flores."
>
  <!-- Hero editorial -->
  <section class="relative min-h-[70vh] lg:min-h-[80vh] flex items-center overflow-hidden bg-primary hero-clip">
    <div class="absolute inset-0 opacity-35 mix-blend-overlay">
      <img src={heroImage} alt="" class="h-full w-full object-cover" />
    </div>
    <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 50px 50px;"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-primary via-primary/55 to-primary/30"></div>

    <div class="container-tight relative z-10 text-on-primary">
      <div class="max-w-3xl reveal">
        <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-on-primary/25 bg-white/5 px-4 py-1.5 backdrop-blur-sm">
          <Icon name="lucide:sparkles" class="h-4 w-4 text-secondary-fixed" />
          <span class="font-label text-[11px] font-bold uppercase tracking-[0.22em] text-secondary-fixed">Pastoral Juvenil Parroquial</span>
        </div>

        <p class="font-label text-xs font-bold uppercase tracking-[0.25em] text-secondary-fixed mb-4">La pastoral juvenil parroquial te invita</p>

        <h1 class="font-display text-5xl md:text-6xl lg:text-7xl font-bold leading-[1.02] tracking-tight mb-6">
          Al Cielo se llega<br/>
          <span class="italic font-medium text-secondary-fixed">en equipo</span>
        </h1>

        <p class="font-body text-lg md:text-xl text-primary-fixed opacity-90 leading-relaxed max-w-2xl">
          Una gymkana para todos los jóvenes de la Parroquia El Salvador del Mundo. Convivencia, dinámicas y mucho espíritu fraterno.
        </p>

        <div class="mt-10 flex flex-wrap items-center gap-4">
          <a
            href="#inscripcion"
            class="inline-flex items-center gap-2 rounded-xl bg-secondary px-7 py-4 font-label text-xs font-bold uppercase tracking-widest text-on-secondary shadow-lg hover:opacity-90 transition-all"
          >
            Inscríbete gratis
            <Icon name="lucide:arrow-right" class="h-4 w-4" />
          </a>
          <a
            href="#detalles"
            class="inline-flex items-center gap-2 rounded-xl border border-on-primary/30 px-6 py-4 font-label text-xs font-bold uppercase tracking-widest text-on-primary hover:bg-on-primary/10 transition-all"
          >
            Ver detalles
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Datos del evento — Bento de 3 -->
  <section class="bg-surface py-14 md:py-20 border-y border-outline-variant/30">
    <div class="mx-auto max-w-[1280px] px-6 md:px-margin-desktop">
      <div class="grid grid-cols-1 gap-px bg-outline-variant/30 border border-outline-variant/30 rounded-xl overflow-hidden md:grid-cols-3 reveal">
        {datosEvento.map((dato) => (
          <article class="bg-surface-container-lowest p-8 lg:p-10 flex flex-col gap-4">
            <div class="flex h-12 w-12 items-center justify-center rounded-full border border-outline-variant/60 text-secondary">
              <Icon name={dato.icono} class="h-6 w-6" />
            </div>
            <div>
              <p class="font-label text-[10px] font-bold uppercase tracking-[0.25em] text-secondary mb-2">{dato.etiqueta}</p>
              <p class="font-display text-2xl lg:text-3xl font-bold text-primary leading-tight">{dato.valor}</p>
              <p class="mt-2 font-body text-sm text-on-surface-variant">{dato.meta}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Sobre la gymkana + cita -->
  <section id="detalles" class="bg-surface-container-low py-20 lg:py-28">
    <div class="mx-auto max-w-[1280px] px-6 md:px-margin-desktop">

      <!-- Header editorial -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 mb-16 lg:mb-20 items-end reveal">
        <div class="lg:col-span-7">
          <div class="flex items-center gap-3 mb-6">
            <span class="h-px w-10 bg-secondary"></span>
            <span class="font-label text-xs font-bold uppercase tracking-[0.3em] text-secondary">Convivencia juvenil</span>
          </div>
          <h2 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold text-primary leading-[1.05] tracking-tight">
            Una jornada para<br/>
            <span class="italic font-medium text-secondary">crecer juntos</span>
          </h2>
        </div>
        <div class="lg:col-span-5 lg:pb-3">
          <p class="font-body text-base lg:text-lg text-on-surface-variant leading-relaxed">
            Un día completo de actividades, retos y momentos fraternos junto a los demás jóvenes de los cuatro sectores de la parroquia. La meta no es competir: es caminar juntos hacia el cielo.
          </p>
        </div>
      </div>

      <!-- Bento de detalles + cita -->
      <div class="grid grid-cols-1 gap-px bg-outline-variant/30 border border-outline-variant/30 rounded-xl overflow-hidden lg:grid-cols-12 reveal">
        {detalles.map((detalle) => (
          <article class="bg-surface-container-lowest p-7 lg:p-9 flex flex-col gap-3 md:col-span-6 lg:col-span-3 hover:bg-surface transition-colors duration-500">
            <div class="flex h-11 w-11 items-center justify-center rounded-full border border-outline-variant/60 text-primary">
              <Icon name={detalle.icono} class="h-5 w-5" />
            </div>
            <h3 class="font-display text-lg font-bold text-primary leading-tight">{detalle.titulo}</h3>
            <p class="font-body text-sm text-on-surface-variant leading-relaxed">{detalle.descripcion}</p>
          </article>
        ))}

        <!-- Cita bíblica a ancho completo -->
        <article class="bg-primary text-on-primary p-8 lg:p-12 md:col-span-12 lg:col-span-12 flex flex-col items-center text-center gap-4">
          <Icon name="lucide:quote" class="h-8 w-8 text-secondary-fixed" />
          <blockquote class="font-display text-2xl md:text-3xl italic leading-[1.25] tracking-tight max-w-3xl">
            «Donde dos o tres se reúnen en mi nombre, allí estoy yo en medio de ellos.»
          </blockquote>
          <div class="flex items-center justify-center gap-3">
            <span class="h-px w-8 bg-secondary-fixed"></span>
            <p class="font-label text-xs font-bold uppercase tracking-[0.3em] text-secondary-fixed">Mateo 18, 20</p>
            <span class="h-px w-8 bg-secondary-fixed"></span>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Formulario de inscripción -->
  <section id="inscripcion" class="bg-surface py-20 lg:py-28 border-y border-outline-variant/30">
    <div class="mx-auto grid max-w-[1280px] gap-10 px-6 md:px-margin-desktop lg:grid-cols-[0.8fr_1.2fr] lg:gap-14">

      <!-- Sidebar -->
      <aside class="space-y-6 lg:sticky lg:top-28 lg:self-start">
        <div class="rounded-2xl border border-outline-variant/30 bg-surface-container-low p-6 md:p-7 reveal">
          <span class="font-label text-xs font-bold uppercase tracking-[0.2em] text-secondary">Antes de inscribirte</span>
          <h2 class="mt-3 font-display text-2xl font-bold text-primary">Requisitos</h2>
          <ul class="mt-6 space-y-4">
            <li class="flex items-start gap-3 font-body text-sm leading-relaxed text-on-surface-variant">
              <Icon name="lucide:circle-check" class="mt-0.5 h-5 w-5 shrink-0 text-secondary" />
              <span>Tener al menos {GYMKANA_MIN_AGE} años al 25 de octubre de 2026.</span>
            </li>
            <li class="flex items-start gap-3 font-body text-sm leading-relaxed text-on-surface-variant">
              <Icon name="lucide:circle-check" class="mt-0.5 h-5 w-5 shrink-0 text-secondary" />
              <span>Pertenecer a uno de los sectores de la Parroquia El Salvador del Mundo.</span>
            </li>
            <li class="flex items-start gap-3 font-body text-sm leading-relaxed text-on-surface-variant">
              <Icon name="lucide:circle-check" class="mt-0.5 h-5 w-5 shrink-0 text-secondary" />
              <span>Si eres menor de {GYMKANA_ADULT_AGE} años, contar con autorización de tu encargado.</span>
            </li>
            <li class="flex items-start gap-3 font-body text-sm leading-relaxed text-on-surface-variant">
              <Icon name="lucide:circle-check" class="mt-0.5 h-5 w-5 shrink-0 text-secondary" />
              <span>Disponibilidad para la jornada completa (8:00 AM – 3:00 PM).</span>
            </li>
          </ul>
        </div>

        <div class="rounded-2xl bg-primary p-6 text-on-primary md:p-7 reveal stagger-1">
          <Icon name="lucide:phone-call" class="h-7 w-7 text-secondary-fixed" />
          <h3 class="mt-3 font-display text-xl font-bold">Mantente atento al teléfono</h3>
          <p class="mt-2 font-body text-sm leading-relaxed text-on-primary/80">
            El equipo de pastoral juvenil utilizará el número registrado para confirmar tu lugar y dar seguimiento.
          </p>
        </div>

        <div class="rounded-2xl border border-secondary/20 bg-secondary-fixed/20 p-6 md:p-7 reveal stagger-2">
          <Icon name="lucide:users" class="h-7 w-7 text-secondary" />
          <h3 class="mt-3 font-display text-xl font-bold text-primary">¿Y los equipos?</h3>
          <p class="mt-2 font-body text-sm leading-relaxed text-on-surface-variant">
            Los equipos se forman el mismo día en la Aldea Las Flores. Solo inscríbete individualmente.
          </p>
        </div>
      </aside>

      <!-- Formulario -->
      <div class="rounded-2xl border border-outline-variant/30 bg-surface-container-lowest p-6 shadow-sm md:p-9 reveal stagger-1">
        <div class="mb-8 border-b border-outline-variant/30 pb-6">
          <span class="font-label text-xs font-bold uppercase tracking-[0.2em] text-secondary">Datos de inscripción</span>
          <h2 class="mt-2 font-display text-3xl font-bold text-primary">Inscríbete a la gymkana</h2>
          <p class="mt-3 font-body text-sm leading-relaxed text-on-surface-variant">
            La pastoral juvenil parroquial te invita a completar este formulario. Los campos marcados con <span class="font-bold text-primary">*</span> son obligatorios.
          </p>
        </div>

        <div id="form-alert" class="mb-6 hidden rounded-xl border px-4 py-3 font-body text-sm" role="alert" aria-live="polite"></div>

        <form id="gymkana-form" class="space-y-7" novalidate>
          <div class="hidden" aria-hidden="true">
            <label for="website">Sitio web</label>
            <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>

          <div class="grid gap-6 md:grid-cols-2">
            <div class="md:col-span-2">
              <label for="nombre_completo" class="mb-2 block font-label text-xs font-bold uppercase tracking-wider text-on-surface">
                Nombre completo <span class="text-primary">*</span>
              </label>
              <input
                id="nombre_completo"
                name="nombre_completo"
                type="text"
                autocomplete="name"
                required
                class="w-full rounded-xl border border-outline-variant bg-surface px-4 py-3.5 font-body text-sm text-on-surface outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/10"
                placeholder="Nombre y apellidos"
              />
              <p class="field-error mt-1 hidden text-xs text-red-700" data-error-for="nombre_completo"></p>
            </div>

            <div>
              <label for="fecha_nacimiento" class="mb-2 block font-label text-xs font-bold uppercase tracking-wider text-on-surface">
                Fecha de nacimiento <span class="text-primary">*</span>
              </label>
              <input
                id="fecha_nacimiento"
                name="fecha_nacimiento"
                type="date"
                required
                max={fechaMaximaInput}
                oninvalid={`this.setCustomValidity('${mensajeEdad}')`}
                oninput="this.setCustomValidity('')"
                class="w-full rounded-xl border border-outline-variant bg-surface px-4 py-3.5 font-body text-sm text-on-surface outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/10"
              />
              <p class="field-error mt-1 hidden text-xs text-red-700" data-error-for="fecha_nacimiento"></p>
            </div>

            <div>
              <label for="telefono_contacto" class="mb-2 block font-label text-xs font-bold uppercase tracking-wider text-on-surface">
                Número de contacto <span class="text-primary">*</span>
              </label>
              <input
                id="telefono_contacto"
                name="telefono_contacto"
                type="tel"
                inputmode="tel"
                autocomplete="tel"
                required
                class="w-full rounded-xl border border-outline-variant bg-surface px-4 py-3.5 font-body text-sm text-on-surface outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/10"
                placeholder="Ej. 9999-9999"
              />
              <p class="field-error mt-1 hidden text-xs text-red-700" data-error-for="telefono_contacto"></p>
            </div>

            <div>
              <label for="correo" class="mb-2 block font-label text-xs font-bold uppercase tracking-wider text-on-surface">
                Correo electrónico <span class="text-primary">*</span>
              </label>
              <input
                id="correo"
                name="correo"
                type="email"
                autocomplete="email"
                required
                class="w-full rounded-xl border border-outline-variant bg-surface px-4 py-3.5 font-body text-sm text-on-surface outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/10"
                placeholder="correo@ejemplo.com"
              />
              <p class="field-error mt-1 hidden text-xs text-red-700" data-error-for="correo"></p>
            </div>

            <div class="md:col-span-2">
              <label for="sector" class="mb-2 block font-label text-xs font-bold uppercase tracking-wider text-on-surface">
                Sector al que perteneces <span class="text-primary">*</span>
              </label>
              <select
                id="sector"
                name="sector"
                required
                class="w-full rounded-xl border border-outline-variant bg-surface px-4 py-3.5 font-body text-sm text-on-surface outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/10"
              >
                <option value="" disabled selected>Selecciona tu sector…</option>
                {gymkanaSectors.map((sector) => (
                  <option value={sector.value}>{sector.label}</option>
                ))}
              </select>
              <p class="field-error mt-1 hidden text-xs text-red-700" data-error-for="sector"></p>
            </div>

            <div class="md:col-span-2">
              <label for="alergias_medicas" class="mb-2 block font-label text-xs font-bold uppercase tracking-wider text-on-surface">
                Alergias o condiciones médicas
              </label>
              <textarea
                id="alergias_medicas"
                name="alergias_medicas"
                rows="3"
                class="w-full resize-y rounded-xl border border-outline-variant bg-surface px-4 py-3.5 font-body text-sm text-on-surface outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/10"
                placeholder="Indica cualquier alergia alimentaria, condición médica o medicamento que debamos conocer. Si no tienes, déjala en blanco."
              ></textarea>
            </div>
          </div>

          <div id="encargado-wrapper" class="hidden rounded-xl border border-outline-variant/40 bg-surface-container-low p-5">
            <label for="nombre_encargado" class="mb-2 block font-label text-xs font-bold uppercase tracking-wider text-on-surface">
              Padre, madre o encargado <span class="text-primary">*</span>
            </label>
            <input
              id="nombre_encargado"
              name="nombre_encargado"
              type="text"
              class="w-full rounded-xl border border-outline-variant bg-surface px-4 py-3.5 font-body text-sm text-on-surface outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/10"
              placeholder="Nombre completo del responsable"
            />
            <p class="mt-2 font-body text-xs text-on-surface-variant">
              Como tienes menos de {GYMKANA_ADULT_AGE} años, necesitamos el nombre de tu encargado para confirmar tu lugar.
            </p>
            <p class="field-error mt-1 hidden text-xs text-red-700" data-error-for="nombre_encargado"></p>
          </div>

          <div class="rounded-xl border border-secondary/20 bg-secondary-fixed/15 p-5">
            <label class="flex cursor-pointer items-start gap-3 font-body text-sm leading-relaxed text-on-surface-variant">
              <input name="privacidad_aceptada" type="checkbox" value="true" class="mt-1 h-4 w-4 accent-primary" required />
              <span>
                Autorizo a la Parroquia El Salvador del Mundo a utilizar estos datos exclusivamente para gestionar mi inscripción en la gymkana y brindarme seguimiento pastoral. <strong class="text-primary">*</strong>
              </span>
            </label>
            <p class="field-error mt-2 hidden text-xs text-red-700" data-error-for="privacidad_aceptada"></p>
          </div>

          <button
            id="submit-button"
            type="submit"
            class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-primary px-7 py-4 font-label text-xs font-bold uppercase tracking-widest text-on-primary shadow-md transition hover:bg-primary-container disabled:cursor-not-allowed disabled:opacity-60 sm:w-auto"
          >
            <span id="submit-label">Enviar inscripción</span>
            <Icon name="lucide:send" class="h-4 w-4" />
          </button>
        </form>
      </div>
    </div>
  </section>

  <script>
    const form = document.querySelector<HTMLFormElement>('#gymkana-form');
    const alertBox = document.querySelector<HTMLDivElement>('#form-alert');
    const submitButton = document.querySelector<HTMLButtonElement>('#submit-button');
    const submitLabel = document.querySelector<HTMLSpanElement>('#submit-label');
    const fechaNacimiento = document.querySelector<HTMLInputElement>('#fecha_nacimiento');
    const encargadoWrapper = document.querySelector<HTMLDivElement>('#encargado-wrapper');
    const encargadoInput = document.querySelector<HTMLInputElement>('#nombre_encargado');
    const ADULT_AGE = 18;
    const EVENT_DATE = new Date('2026-10-25T00:00:00');

    function calculateAge(value: string) {
      const birth = new Date(`${value}T00:00:00`);
      if (Number.isNaN(birth.getTime())) return Number.NaN;
      let age = EVENT_DATE.getFullYear() - birth.getFullYear();
      const monthDiff = EVENT_DATE.getMonth() - birth.getMonth();
      if (monthDiff < 0 || (monthDiff === 0 && EVENT_DATE.getDate() < birth.getDate())) age -= 1;
      return age;
    }

    function refreshEncargadoVisibility() {
      if (!encargadoWrapper || !encargadoInput || !fechaNacimiento) return;
      const value = fechaNacimiento.value;
      if (!value) {
        encargadoWrapper.classList.add('hidden');
        encargadoInput.required = false;
        return;
      }
      const age = calculateAge(value);
      if (Number.isFinite(age) && age < ADULT_AGE) {
        encargadoWrapper.classList.remove('hidden');
        encargadoInput.required = true;
      } else {
        encargadoWrapper.classList.add('hidden');
        encargadoInput.required = false;
        encargadoInput.value = '';
      }
    }

    fechaNacimiento?.addEventListener('change', refreshEncargadoVisibility);
    fechaNacimiento?.addEventListener('input', refreshEncargadoVisibility);

    function clearErrors() {
      document.querySelectorAll<HTMLElement>('.field-error').forEach((element) => {
        element.textContent = '';
        element.classList.add('hidden');
      });
      alertBox?.classList.add('hidden');
    }

    function showAlert(message: string, success = false) {
      if (!alertBox) return;
      alertBox.textContent = message;
      alertBox.className = `mb-6 rounded-xl border px-4 py-3 font-body text-sm ${
        success
          ? 'border-green-700/20 bg-green-50 text-green-800'
          : 'border-red-700/20 bg-red-50 text-red-800'
      }`;
      alertBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      clearErrors();

      refreshEncargadoVisibility();

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      const formData = new FormData(form);
      const payload = {
        nombre_completo: String(formData.get('nombre_completo') ?? ''),
        fecha_nacimiento: String(formData.get('fecha_nacimiento') ?? ''),
        telefono_contacto: String(formData.get('telefono_contacto') ?? ''),
        correo: String(formData.get('correo') ?? ''),
        sector: String(formData.get('sector') ?? ''),
        alergias_medicas: String(formData.get('alergias_medicas') ?? ''),
        nombre_encargado: String(formData.get('nombre_encargado') ?? ''),
        privacidad_aceptada: formData.get('privacidad_aceptada') === 'true',
        website: String(formData.get('website') ?? ''),
      };

      if (submitButton) submitButton.disabled = true;
      if (submitLabel) submitLabel.textContent = 'Enviando...';

      try {
        const response = await fetch('/api/gymkana/inscripciones', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(payload),
        });

        const result = await response.json();

        if (!response.ok || !result.ok) {
          if (Array.isArray(result.issues)) {
            result.issues.forEach((issue: { path?: string; message?: string }) => {
              const fieldError = document.querySelector<HTMLElement>(`[data-error-for="${issue.path}"]`);
              if (fieldError) {
                fieldError.textContent = issue.message ?? 'Revisa este campo.';
                fieldError.classList.remove('hidden');
              }
            });
          }
          showAlert(result.error ?? 'No se pudo enviar la inscripción.');
          return;
        }

        form.reset();
        refreshEncargadoVisibility();
        showAlert('¡Inscripción recibida! La pastoral juvenil se comunicará contigo al número registrado.', true);
      } catch {
        showAlert('No fue posible conectar con el servidor. Inténtalo nuevamente en unos minutos.');
      } finally {
        if (submitButton) submitButton.disabled = false;
        if (submitLabel) submitLabel.textContent = 'Enviar inscripción';
      }
    });
  </script>
</Layout>