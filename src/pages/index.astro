---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../config/site';
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import MapaInteractivo from '../components/ui/MapaInteractivo.astro';
import FAQ from '../components/ui/FAQ.astro';

const allSectores = await getCollection('sectores');
const sectores = allSectores
	.sort((a, b) => (a.data.orden ?? 0) - (b.data.orden ?? 0))
	.map(s => s.data);
---

<Layout title="Inicio">
  <!-- Hero Section -->
  <section class="relative h-[819px] flex items-center justify-center overflow-hidden bg-primary">
    <div class="absolute inset-0 z-0">
      <div 
        class="w-full h-full bg-cover bg-center transition-transform duration-1000 hover:scale-105 opacity-55" 
        style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuAztYR1-cgk0XRrXYv3JlYk9kqTM76G3kGdett6hCPmwYs0oaPK9-EYYiQjFdEcPYc0NHFgPECkMZ2Dzecaux23s57479eOK1FY5v69yWqz-Ts2B4yP2x02_tWwNr--V86xkjdu5qQC8lcMW1hn-as3VOjklPpLMj9B37z0Ei0DBl-bGC2tOcIZecSArsJDsfqoEZ5kfnHPGRrgnrlcUEn_pY6LJ1xpkKlSNVBe33Caj-pwMZSaLlR6I1c6NEZIF-M8PWUMdoFbJMs')"
      >
      </div>
      <div class="absolute inset-0 hero-gradient"></div>
    </div>
    
    <div class="relative z-10 text-center text-on-primary px-6 md:px-margin-desktop max-w-4xl mx-auto reveal">
      <span class="font-label text-xs font-bold uppercase tracking-[0.25em] text-secondary-fixed mb-4 block">
        {siteConfig.slogan}
      </span>
      <h1 class="font-display text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold mb-6 leading-tight tracking-tight">
        La Luz del Salvador
      </h1>
      <p class="font-body text-base sm:text-lg md:text-xl mb-10 opacity-90 max-w-2xl mx-auto leading-relaxed text-balance">
        Bienvenidos a nuestra comunidad de fe, un espacio de encuentro, oración y servicio dedicado al crecimiento espiritual y humano bajo la guía de Cristo.
      </p>
      <div class="flex flex-col sm:flex-row justify-center items-center gap-4">
        <a 
          href="/oficina" 
          class="w-full sm:w-auto bg-secondary-container text-on-secondary-container px-8 py-4 rounded-xl font-label text-xs font-bold uppercase tracking-widest hover:scale-105 transition-all shadow-lg"
        >
          Horarios de Misa
        </a>
        <a 
          href={siteConfig.contact.whatsappHref} 
          target="_blank"
          rel="noopener"
          class="w-full sm:w-auto border border-surface-container-lowest text-surface-container-lowest px-8 py-4 rounded-xl font-label text-xs font-bold uppercase tracking-widest hover:bg-surface-container-lowest/10 transition-all"
        >
          Unirse a la Comunidad
        </a>
      </div>
    </div>
  </section>

  <!-- Message from Pastor (Asymmetric Layout) -->
  <section class="py-24 px-6 md:px-margin-desktop max-w-[1280px] mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-16 items-center">
      <div class="md:col-span-5 relative reveal">
        <div class="aspect-[3/4] rounded-2xl border-4 border-secondary/20 p-4 bg-surface-container-low shadow-sm">
          <div 
            class="w-full h-full rounded-xl bg-cover bg-center grayscale hover:grayscale-0 transition-all duration-700 shadow-inner" 
            style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuB3S7FUcTW6lHcpEFfVKD81ypJQZ0ydAtbBLML6SKwkXIiEK0zRFxpt4VBMNNkGLAmQ7xdHxHbrC3jk0rg_funVCCdhexHEfd8W7mUi3EzMjYMqR3G9WA3sd4tLcPnrFnUVs3kQ50sUDwUsG72b82DxNxiL3pO-BITnPnnMj0GseJBKsJw7Q2Kn4wsrckiWbYe1mZ8GDVRYChopAmVqSydbtihocZOPnm8zEvon9SyLhxphQblmQViynz0U6kKN1mK8iVaRNT4Za7U')"
          >
          </div>
        </div>
        <div class="absolute -bottom-6 -right-6 bg-secondary-fixed p-6 rounded-xl hidden md:flex items-center justify-center shadow-lg">
          <span class="material-symbols-outlined text-4xl text-on-secondary-fixed">format_quote</span>
        </div>
      </div>
      
      <div class="md:col-span-7 space-y-6 reveal stagger-1">
        <span class="font-label text-xs font-bold uppercase tracking-[0.2em] text-secondary mb-4 block">Mensaje de nuestro Párroco</span>
        <h2 class="font-display text-3xl md:text-4xl font-bold text-primary">Caminando Juntos en Esperanza</h2>
        <p class="font-body text-base lg:text-lg text-on-surface-variant leading-relaxed">
          "En esta parroquia, cada rostro cuenta una historia de fe. Nuestra misión es ser un faro de esperanza en la ciudad, ofreciendo no solo sacramentos, sino una verdadera familia espiritual donde todos son bienvenidos."
        </p>
        <p class="font-body text-sm text-on-surface-variant italic border-l-4 border-secondary/40 pl-4">
          Queridos hermanos, les invito a ser parte activa de nuestra vida parroquial. No somos solo un edificio, somos piedras vivas de una Iglesia en salida, comprometida con los más necesitados y el crecimiento de nuestra comunidad.
        </p>
        <div class="font-label text-sm font-semibold text-primary pt-2">
          {siteConfig.parroco} <br/>
          <span class="text-on-surface-variant text-xs opacity-70 font-normal">Párroco</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Sacramentos (Bento Grid Pattern) -->
  <section class="py-24 bg-surface-container-low border-y border-outline-variant/30">
    <div class="px-6 md:px-margin-desktop max-w-[1280px] mx-auto">
      <div class="text-center mb-16 reveal">
        <span class="font-label text-xs font-bold uppercase tracking-[0.25em] text-secondary mb-3 block">Gracia Divina</span>
        <h2 class="font-display text-3xl md:text-4xl font-bold text-primary mb-4">Los Santos Sacramentos</h2>
        <div class="h-1 w-24 bg-secondary mx-auto rounded-full"></div>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-8">
        <!-- Bautismo (7/12 cols) -->
        <div class="md:col-span-7 bg-surface-container-lowest p-8 rounded-xl border border-outline-variant/20 hover:border-secondary hover:shadow-lg transition-all duration-300 group flex flex-col justify-between reveal stagger-1">
          <div>
            <div class="flex gap-4 items-start mb-6">
              <div class="bg-primary-fixed/30 p-4 rounded-full text-primary flex items-center justify-center">
                <span class="material-symbols-outlined text-4xl">water_drop</span>
              </div>
              <div>
                <h3 class="font-display text-2xl font-bold text-primary mb-2">Bautismo</h3>
                <p class="font-body text-sm text-on-surface-variant leading-relaxed">El fundamento de toda la vida cristiana, el pórtico de la vida en el espíritu. Realizamos bautizos comunitarios todos los fines de semana.</p>
              </div>
            </div>
          </div>
          <a class="text-secondary font-label text-xs font-bold uppercase tracking-wider flex items-center gap-2 hover:gap-4 transition-all" href="/sacramentos/bautismo">
            Requisitos <span class="material-symbols-outlined text-sm">arrow_forward</span>
          </a>
        </div>

        <!-- Eucaristía (5/12 cols) -->
        <div class="md:col-span-5 bg-surface-container-lowest p-8 rounded-xl border border-outline-variant/20 hover:border-secondary hover:shadow-lg transition-all duration-300 flex flex-col justify-between reveal stagger-2">
          <div>
            <div class="bg-secondary-fixed/30 p-4 rounded-full w-fit mb-6 text-secondary flex items-center justify-center">
              <span class="material-symbols-outlined text-4xl">restaurant_menu</span>
            </div>
            <h3 class="font-display text-2xl font-bold text-primary mb-2">Eucaristía</h3>
            <p class="font-body text-sm text-on-surface-variant mb-6 leading-relaxed">Fuente y culmen de nuestra vida cristiana en comunidad.</p>
          </div>
          <a class="text-secondary font-label text-xs font-bold uppercase tracking-wider flex items-center gap-2 hover:gap-4 transition-all" href="/oficina">
            Horarios <span class="material-symbols-outlined text-sm">arrow_forward</span>
          </a>
        </div>

        <!-- Confirmación (5/12 cols) -->
        <div class="md:col-span-5 bg-surface-container-lowest p-8 rounded-xl border border-outline-variant/20 hover:border-secondary hover:shadow-lg transition-all duration-300 flex flex-col justify-between reveal stagger-3">
          <div>
            <div class="bg-tertiary-fixed/50 p-4 rounded-full w-fit mb-6 text-primary flex items-center justify-center">
              <span class="material-symbols-outlined text-4xl">local_fire_department</span>
            </div>
            <h3 class="font-display text-2xl font-bold text-primary mb-2">Confirmación</h3>
            <p class="font-body text-sm text-on-surface-variant mb-6 leading-relaxed">Fortalece nuestra fe y sella nuestros dones con el Espíritu Santo.</p>
          </div>
          <a class="text-secondary font-label text-xs font-bold uppercase tracking-wider flex items-center gap-2 hover:gap-4 transition-all" href="/sacramentos/confirmacion">
            Requisitos <span class="material-symbols-outlined text-sm">arrow_forward</span>
          </a>
        </div>

        <!-- Matrimonio (7/12 cols) -->
        <div class="md:col-span-7 bg-primary text-on-primary p-8 rounded-xl overflow-hidden relative group flex flex-col justify-between reveal stagger-4">
          <div class="relative z-10">
            <h3 class="font-display text-2xl font-bold mb-2 text-primary-fixed">Matrimonio</h3>
            <p class="font-body text-sm text-on-primary/80 mb-6 max-w-md leading-relaxed">La alianza matrimonial constituida entre el varón y la mujer para toda la vida. Cursos prematrimoniales periódicos.</p>
          </div>
          <a href="/sacramentos/matrimonio" class="w-fit z-10 bg-surface-container-lowest text-primary px-6 py-2.5 rounded-lg font-label text-xs font-bold uppercase tracking-widest hover:bg-secondary-container hover:text-on-secondary-container transition-colors shadow">
            Requisitos
          </a>
          <span class="material-symbols-outlined absolute -right-8 -bottom-8 text-[12rem] text-primary-container opacity-20 transform -rotate-12 group-hover:rotate-0 transition-transform duration-700 pointer-events-none">favorite</span>
        </div>
      </div>
      
      <div class="text-center mt-12">
        <a 
          href="/sacramentos" 
          class="inline-flex items-center gap-2 border border-primary text-primary px-8 py-3 rounded-lg font-label text-xs font-semibold uppercase tracking-widest hover:bg-primary hover:text-on-primary transition-all duration-300"
        >
          Ver todos los sacramentos
        </a>
      </div>
    </div>
  </section>

  <!-- Sectores Section -->
  <section class="py-24 px-6 md:px-margin-desktop max-w-[1280px] mx-auto">
    <div class="text-center mb-16 reveal">
      <span class="font-label text-xs font-bold uppercase tracking-[0.25em] text-secondary mb-3 block">Comunidad</span>
      <h2 class="font-display text-3xl md:text-4xl font-bold text-primary">Nuestros Sectores</h2>
      <div class="h-1 w-24 bg-secondary mx-auto rounded-full mt-2"></div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {sectores.map((s, i) => (
        <div class={`group bg-surface-container-lowest rounded-xl border border-outline-variant/20 hover:border-primary/20 shadow-sm hover:shadow-lg transition-all duration-500 overflow-hidden reveal stagger-${i+1}`}>
          <div class="aspect-video overflow-hidden relative bg-surface-variant">
            <img 
              src={s.imagen} 
              alt={s.nombre} 
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent"></div>
          </div>
          <div class="p-6">
            <h3 class="font-display text-base font-bold text-on-surface mb-2 group-hover:text-primary transition-colors">{s.nombre}</h3>
            <p class="font-body text-xs lg:text-sm text-on-surface-variant leading-relaxed">{s.descripcion}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Oficina Parroquial (Interactive Section) -->
  <section class="py-24 bg-surface-container-low border-t border-outline-variant/30" id="oficina-seccion">
    <div class="px-6 md:px-margin-desktop max-w-[1280px] mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
        <div class="reveal">
          <span class="font-label text-xs font-bold uppercase tracking-[0.2em] text-secondary mb-4 block">Contacto</span>
          <h2 class="font-display text-3xl lg:text-4xl font-bold text-primary mb-8">Oficina Parroquial</h2>
          <div class="space-y-8">
            <div class="flex gap-6 items-start">
              <div class="bg-surface-container-high p-3 rounded-lg text-primary flex items-center justify-center">
                <span class="material-symbols-outlined text-2xl">schedule</span>
              </div>
              <div>
                <h4 class="font-label text-xs font-bold text-primary uppercase mb-1">Horarios de Atención</h4>
                <p class="font-body text-sm text-on-surface-variant">Lunes, Miércoles, Jueves, Viernes: 2:00 PM - 6:15 PM</p>
                <p class="font-body text-sm text-on-surface-variant">Martes: 4:00 PM - 6:15 PM | Sábado: 8:00 AM - 12:00 M</p>
              </div>
            </div>
            
            <div class="flex gap-6 items-start">
              <div class="bg-surface-container-high p-3 rounded-lg text-primary flex items-center justify-center">
                <span class="material-symbols-outlined text-2xl">location_on</span>
              </div>
              <div>
                <h4 class="font-label text-xs font-bold text-primary uppercase mb-1">Dirección</h4>
                <p class="font-body text-sm text-on-surface-variant">{siteConfig.address.street}</p>
                <p class="font-body text-xs text-on-surface-variant opacity-70">{siteConfig.address.locality}, {siteConfig.address.country}</p>
              </div>
            </div>
            
            <div class="flex gap-6 items-start">
              <div class="bg-surface-container-high p-3 rounded-lg text-primary flex items-center justify-center">
                <span class="material-symbols-outlined text-2xl">mail</span>
              </div>
              <div>
                <h4 class="font-label text-xs font-bold text-primary uppercase mb-1">Secretaría Parroquial</h4>
                <p class="font-body text-sm text-on-surface-variant">Tel: {siteConfig.contact.telefonoDisplay}</p>
                <p class="font-body text-sm text-on-surface-variant">Whatsapp: {siteConfig.contact.whatsappDisplay}</p>
                <p class="font-body text-sm text-on-surface-variant">Correo: {siteConfig.contact.email}</p>
              </div>
            </div>
          </div>
          
          <div class="mt-8 flex flex-wrap gap-4">
            <a 
              href={siteConfig.contact.telefonoHref} 
              class="inline-flex items-center gap-2 bg-primary text-on-primary px-6 py-3 rounded-lg font-label text-xs font-bold uppercase tracking-widest hover:opacity-90 transition-all shadow"
            >
              <span class="material-symbols-outlined text-sm">call</span>
              Llamar
            </a>
            <a 
              href={`mailto:${siteConfig.contact.email}`} 
              class="inline-flex items-center gap-2 border border-primary text-primary px-6 py-3 rounded-lg font-label text-xs font-bold uppercase tracking-widest hover:bg-primary hover:text-on-primary transition-all duration-300"
            >
              <span class="material-symbols-outlined text-sm">mail</span>
              Enviar Correo
            </a>
          </div>
        </div>
        
        <div class="rounded-2xl overflow-hidden h-[400px] shadow-2xl shadow-primary/10 border border-outline-variant/30 relative reveal stagger-1">
          <MapaInteractivo />
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-24 bg-surface">
    <div class="px-6 md:px-margin-desktop max-w-[1280px] mx-auto reveal">
      <FAQ />
    </div>
  </section>
</Layout>
