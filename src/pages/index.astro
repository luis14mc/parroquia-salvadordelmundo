---
import Layout from '../layouts/Layout.astro';
import HomeCatequesis from '../components/home/HomeCatequesis.astro';
import { siteConfig } from '../config/site';
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';

const allSectores = await getCollection('sectores');
const sectores = allSectores
	.sort((a, b) => (a.data.orden ?? 0) - (b.data.orden ?? 0))
	.map(s => s.data);

const sede = sectores.find(s => s.nombre === 'Sector Salvador del Mundo');
const sectoresRestantes = sectores.filter(s => s.nombre !== 'Sector Salvador del Mundo');

const allHorarios = await getCollection('horarios');
const eucaristiaData = allHorarios.find(h => h.data.tipo === 'eucaristia');
const eucaristias = eucaristiaData?.data.items ?? [];

const semana = [
	{ dia: 'Lun', completo: 'Lunes', masas: ['7:00 PM'], diaSemana: 1 },
	{ dia: 'Mar', completo: 'Martes', masas: ['7:00 PM'], diaSemana: 2 },
	{ dia: 'Mié', completo: 'Miércoles', masas: ['7:00 PM'], diaSemana: 3 },
	{ dia: 'Jue', completo: 'Jueves', masas: ['7:00 PM'], diaSemana: 4 },
	{ dia: 'Vie', completo: 'Viernes', masas: ['7:00 PM'], diaSemana: 5 },
	{ dia: 'Sáb', completo: 'Sábado', masas: ['7:00 AM'], diaSemana: 6 },
	{ dia: 'Dom', completo: 'Domingo', masas: ['9:00 AM', '11:00 AM', '5:30 PM'], diaSemana: 0, destacado: true },
];

const allSacerdotes = await getCollection('sacerdotes');
const sacerdotes = allSacerdotes
	.sort((a, b) => (a.data.orden ?? 0) - (b.data.orden ?? 0))
	.map(s => s.data);
const parroco = sacerdotes.find(s => s.cargo === 'Párroco');
const vicario = sacerdotes.find(s => s.cargo === 'Vicario');
const colaborador = sacerdotes.find(s => s.cargo === 'Colaborador');
---

<Layout title="Inicio">
  <!-- Hero Section -->
  <section class="relative h-[819px] flex items-center justify-center overflow-hidden bg-primary">
    <div class="absolute inset-0 z-0">
      <div
        class="w-full h-full bg-cover bg-center transition-transform duration-1000 hover:scale-105 opacity-55"
        style="background-image: url('/img/institucionales/templo-sede.webp')"
      >
      </div>
      <div class="absolute inset-0 hero-gradient"></div>
    </div>
    
    <div class="relative z-10 text-center text-on-primary px-6 md:px-margin-desktop max-w-4xl mx-auto reveal">
      <span class="font-label text-xs font-bold uppercase tracking-[0.25em] text-secondary-fixed mb-4 block">
        {siteConfig.slogan}
      </span>
      <h1 class="font-display text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold mb-6 leading-tight tracking-tight">
        La Luz del Salvador
      </h1>
      <p class="font-body text-base sm:text-lg md:text-xl mb-10 opacity-90 max-w-2xl mx-auto leading-relaxed text-balance">
        Bienvenidos a nuestra comunidad de fe, un espacio de encuentro, oración y servicio dedicado al crecimiento espiritual y humano bajo la guía de Cristo.
      </p>
      <div class="flex flex-col sm:flex-row justify-center items-center gap-4">
        <a 
          href="/oficina" 
          class="w-full sm:w-auto bg-secondary-container text-on-secondary-container px-8 py-4 rounded-xl font-label text-xs font-bold uppercase tracking-widest hover:scale-105 transition-all shadow-lg"
        >
          Horarios de Misa
        </a>
        <a
          href="https://whatsapp.com/channel/0029Vb7CGfTC6Zvs7BBYE51P"
          target="_blank"
          rel="noopener"
          class="w-full sm:w-auto border border-surface-container-lowest text-surface-container-lowest px-8 py-4 rounded-xl font-label text-xs font-bold uppercase tracking-widest hover:bg-surface-container-lowest/10 transition-all"
        >
          Unirse a la Comunidad
        </a>
      </div>
    </div>
  </section>

  <!-- Message from Pastor (Asymmetric Layout) -->
  <section class="py-24 px-6 md:px-margin-desktop max-w-[1280px] mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-16 items-center">
      <div class="md:col-span-5 relative reveal">
        <div class="aspect-[3/4] rounded-2xl border-4 border-secondary/20 p-4 bg-surface-container-low shadow-sm overflow-hidden">
          <div
            class="w-full h-full rounded-xl bg-cover bg-center transition-transform duration-700 hover:scale-105 shadow-inner"
            style="background-image: url('/img/institucionales/salvador-del-mundo.webp')"
          >
          </div>
        </div>
        <div class="absolute -bottom-6 -right-6 bg-secondary-fixed p-6 rounded-xl hidden md:flex items-center justify-center shadow-lg">
          <span class="material-symbols-outlined text-4xl text-on-secondary-fixed">format_quote</span>
        </div>
      </div>
      
      <div class="md:col-span-7 space-y-6 reveal stagger-1">
        <span class="font-label text-xs font-bold uppercase tracking-[0.2em] text-secondary mb-4 block">Mensaje de nuestro Párroco</span>
        <h2 class="font-display text-3xl md:text-4xl font-bold text-primary">Caminando Juntos en Esperanza</h2>
        <p class="font-body text-base lg:text-lg text-on-surface-variant leading-relaxed">
          "En esta parroquia, cada rostro cuenta una historia de fe. Nuestra misión es ser un faro de esperanza en la ciudad, ofreciendo no solo sacramentos, sino una verdadera familia espiritual donde todos son bienvenidos."
        </p>
        <p class="font-body text-sm text-on-surface-variant italic border-l-4 border-secondary/40 pl-4">
          Queridos hermanos, les invito a ser parte activa de nuestra vida parroquial. No somos solo un edificio, somos piedras vivas de una Iglesia en salida, comprometida con los más necesitados y el crecimiento de nuestra comunidad.
        </p>
        <div class="font-label text-sm font-semibold text-primary pt-2">
          {siteConfig.parroco} <br/>
          <span class="text-on-surface-variant text-xs opacity-70 font-normal">Párroco</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Catequesis y formación (sección compacta — 2da posición) -->
  <HomeCatequesis />

  <!-- Horarios de Misa (Liturgical Week) -->
  <section class="py-24 lg:py-28 bg-surface border-y border-outline-variant/30">
    <div class="px-6 md:px-margin-desktop max-w-[1280px] mx-auto">

      <!-- Header editorial -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 mb-16 lg:mb-20 items-end reveal">
        <div class="lg:col-span-7">
          <div class="flex items-center gap-3 mb-6">
            <span class="h-px w-10 bg-secondary"></span>
            <span class="font-label text-xs font-bold uppercase tracking-[0.3em] text-secondary">Sede Parroquial</span>
          </div>
          <h2 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold text-primary leading-[1.05] tracking-tight">
            Horarios<br/>
            <span class="italic font-medium text-secondary">de Misa</span>
          </h2>
        </div>
        <div class="lg:col-span-5 lg:pb-3">
          <p class="font-body text-base lg:text-lg text-on-surface-variant leading-relaxed">
            Las celebraciones eucarísticas de nuestra sede parroquial, de lunes a domingo.
          </p>
        </div>
      </div>

      <!-- Bento: entre semana + fin de semana -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-px bg-outline-variant/30 border border-outline-variant/30 rounded-xl overflow-hidden reveal">

        <!-- Entre semana (7 cols) -->
        <div class="md:col-span-7 bg-surface-container-lowest">
          <div class="px-6 lg:px-8 py-5 border-b border-outline-variant/30 flex items-center justify-between">
            <span class="font-label text-xs font-bold uppercase tracking-[0.25em] text-secondary">Entre semana</span>
            <span class="font-label text-[10px] font-bold uppercase tracking-[0.2em] text-on-surface-variant">Lun — Vie</span>
          </div>
          {semana.slice(0, 5).map((d, idx) => (
            <div class={`group flex items-center justify-between gap-4 px-6 lg:px-8 py-5 border-b border-outline-variant/30 last:border-0 hover:bg-surface transition-colors duration-300`}>
              <div class="flex items-center gap-4">
                <span class="font-display text-lg sm:text-xl font-bold text-outline-variant/50 group-hover:text-secondary transition-colors duration-300 w-7 flex-shrink-0">
                  {String(idx + 1).padStart(2, '0')}
                </span>
                <span class="font-display text-base sm:text-lg font-bold text-on-surface">{d.completo}</span>
              </div>
              <div class="flex items-baseline gap-1.5">
                <span class="font-display text-xl sm:text-2xl font-bold text-primary leading-none">{d.masas[0].split(' ')[0]}</span>
                <span class="font-label text-[10px] font-bold uppercase tracking-wider text-secondary">{d.masas[0].split(' ')[1]}</span>
              </div>
            </div>
          ))}
        </div>

        <!-- Fin de semana (5 cols) -->
        <div class="md:col-span-5 flex flex-col">
          <div class="px-6 lg:px-8 py-5 border-b border-outline-variant/30 flex items-center justify-between bg-secondary/10">
            <span class="font-label text-xs font-bold uppercase tracking-[0.25em] text-secondary">Fin de semana</span>
            <span class="font-label text-[10px] font-bold uppercase tracking-[0.2em] text-primary">Sáb — Dom</span>
          </div>

          <!-- Sábado -->
          <div class="group bg-surface-container-lowest px-6 lg:px-8 py-6 border-b border-outline-variant/30 flex items-center justify-between hover:bg-surface transition-colors duration-300 flex-1">
            <div class="flex items-center gap-4">
              <span class="font-display text-lg sm:text-xl font-bold text-outline-variant/50 w-7 flex-shrink-0">06</span>
              <span class="font-display text-base sm:text-lg font-bold text-on-surface">Sábado</span>
            </div>
            <div class="flex items-baseline gap-1.5">
              <span class="font-display text-xl sm:text-2xl font-bold text-primary leading-none">7:00</span>
              <span class="font-label text-[10px] font-bold uppercase tracking-wider text-secondary">AM</span>
            </div>
          </div>

          <!-- Domingo (destacado) -->
          <div class="group bg-primary text-on-primary px-6 lg:px-8 py-6 flex flex-col justify-between flex-1">
            <div class="flex items-center justify-between mb-4">
              <div class="flex items-center gap-4">
                <span class="font-display text-lg sm:text-xl font-bold text-secondary-fixed w-7 flex-shrink-0">07</span>
                <span class="font-display text-base sm:text-lg font-bold text-primary-fixed">Domingo</span>
              </div>
              <span class="font-label text-[10px] font-bold uppercase tracking-[0.2em] text-secondary-fixed">Principal</span>
            </div>
            <div class="flex flex-wrap items-baseline gap-x-5 gap-y-2 justify-end">
              <div class="flex items-baseline gap-1.5">
                <span class="font-display text-xl sm:text-2xl font-bold text-primary-fixed leading-none">9:00</span>
                <span class="font-label text-[10px] font-bold uppercase tracking-wider text-secondary-fixed">AM</span>
              </div>
              <div class="flex items-baseline gap-1.5">
                <span class="font-display text-xl sm:text-2xl font-bold text-primary-fixed leading-none">11:00</span>
                <span class="font-label text-[10px] font-bold uppercase tracking-wider text-secondary-fixed">AM</span>
              </div>
              <div class="flex items-baseline gap-1.5">
                <span class="font-display text-xl sm:text-2xl font-bold text-primary-fixed leading-none">5:30</span>
                <span class="font-label text-[10px] font-bold uppercase tracking-wider text-secondary-fixed">PM</span>
              </div>
            </div>
          </div>
        </div>

      </div>

      <!-- Footer minimalista: solo ubicación -->
      <div class="mt-8 flex flex-col sm:flex-row items-center justify-between gap-4 reveal">
        <p class="flex items-center gap-2 font-body text-sm text-on-surface-variant">
          <Icon name="lucide:map-pin" class="w-4 h-4 text-secondary" />
          <span>Cerro Grande Zona 4, calle principal, Comayagüela</span>
        </p>
        <a
          href="/oficina"
          class="inline-flex items-center gap-3 font-label text-xs font-bold uppercase tracking-[0.2em] text-primary hover:text-secondary transition-colors group"
        >
          Ver horarios completos
          <Icon name="lucide:arrow-right" class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
        </a>
      </div>

    </div>
  </section>

  <!-- Sacramentos (Editorial Layout) -->
  <section class="py-28 bg-surface border-y border-outline-variant/30">
    <div class="px-6 md:px-margin-desktop max-w-[1280px] mx-auto">

      <!-- Header editorial: eyebrow + título grande a la izquierda, descripción a la derecha -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 mb-20 items-end reveal">
        <div class="lg:col-span-7">
          <div class="flex items-center gap-3 mb-6">
            <span class="h-px w-10 bg-secondary"></span>
            <span class="font-label text-xs font-bold uppercase tracking-[0.3em] text-secondary">Gracia Divina</span>
          </div>
          <h2 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold text-primary leading-[1.05] tracking-tight">
            Los Sacramentos<br/>
            <span class="italic font-medium text-secondary">que nos unen</span>
          </h2>
        </div>
        <div class="lg:col-span-5 lg:pb-3">
          <p class="font-body text-base lg:text-lg text-on-surface-variant leading-relaxed">
            Siete sacramentos instituidos por Cristo, fuente y culmen de toda la vida cristiana. Conoce los que celebramos en nuestra parroquia y el camino para recibirlos.
          </p>
        </div>
      </div>

      <!-- Cards de sacramentos -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-px bg-outline-variant/30 border border-outline-variant/30 rounded-xl overflow-hidden">

        <!-- Bautismo -->
        <article class="group bg-surface-container-lowest p-8 lg:p-10 flex flex-col justify-between hover:bg-surface transition-colors duration-500 reveal stagger-1 h-full min-h-[360px]">
          <div>
            <div class="flex items-start justify-between mb-8">
              <span class="font-display text-xs font-semibold text-secondary tracking-widest">01</span>
              <div class="w-14 h-14 rounded-full border border-outline-variant/60 flex items-center justify-center text-primary group-hover:border-secondary group-hover:text-secondary transition-all duration-500">
                <Icon name="lucide:droplets" class="w-7 h-7" />
              </div>
            </div>
            <h3 class="font-display text-xl lg:text-2xl font-bold text-primary mb-3 leading-tight">Bautismo</h3>
            <p class="font-body text-sm text-on-surface-variant leading-relaxed mb-8">
              El fundamento de toda la vida cristiana, el pórtico de entrada a la vida en el espíritu.
            </p>
          </div>
          <a class="font-label text-xs font-bold uppercase tracking-[0.2em] text-primary flex items-center gap-3 group/link" href="/sacramentos/bautismo">
            <span class="relative">
              Conocer
              <span class="absolute left-0 -bottom-1 h-px w-full bg-primary origin-left scale-x-50 group-hover/link:scale-x-100 transition-transform duration-500"></span>
            </span>
            <Icon name="lucide:arrow-right" class="w-4 h-4 group-hover/link:translate-x-1 transition-transform" />
          </a>
        </article>

        <!-- Eucaristía (Primera Comunión) -->
        <article class="group bg-surface-container-lowest p-8 lg:p-10 flex flex-col justify-between hover:bg-surface transition-colors duration-500 reveal stagger-2 h-full min-h-[360px]">
          <div>
            <div class="flex items-start justify-between mb-8">
              <span class="font-display text-xs font-semibold text-secondary tracking-widest">02</span>
              <div class="w-14 h-14 rounded-full border border-outline-variant/60 flex items-center justify-center text-primary group-hover:border-secondary group-hover:text-secondary transition-all duration-500">
                <Icon name="lucide:wheat" class="w-7 h-7" />
              </div>
            </div>
            <h3 class="font-display text-xl lg:text-2xl font-bold text-primary mb-3 leading-tight">Eucaristía</h3>
            <p class="font-body text-sm text-on-surface-variant leading-relaxed mb-8">
              Fuente y culmen de la vida cristiana: recibir el Cuerpo y la Sangre de Cristo en comunidad.
            </p>
          </div>
          <a class="font-label text-xs font-bold uppercase tracking-[0.2em] text-primary flex items-center gap-3 group/link" href="/sacramentos/primera-comunion">
            <span class="relative">
              Conocer
              <span class="absolute left-0 -bottom-1 h-px w-full bg-primary origin-left scale-x-50 group-hover/link:scale-x-100 transition-transform duration-500"></span>
            </span>
            <Icon name="lucide:arrow-right" class="w-4 h-4 group-hover/link:translate-x-1 transition-transform" />
          </a>
        </article>

        <!-- Confirmación -->
        <article class="group bg-surface-container-lowest p-8 lg:p-10 flex flex-col justify-between hover:bg-surface transition-colors duration-500 reveal stagger-3 h-full min-h-[360px]">
          <div>
            <div class="flex items-start justify-between mb-8">
              <span class="font-display text-xs font-semibold text-secondary tracking-widest">03</span>
              <div class="w-14 h-14 rounded-full border border-outline-variant/60 flex items-center justify-center text-primary group-hover:border-secondary group-hover:text-secondary transition-all duration-500">
                <Icon name="lucide:flame" class="w-7 h-7" />
              </div>
            </div>
            <h3 class="font-display text-xl lg:text-2xl font-bold text-primary mb-3 leading-tight">Confirmación</h3>
            <p class="font-body text-sm text-on-surface-variant leading-relaxed mb-8">
              Perfecciona la gracia bautismal y sella nuestros dones con la fuerza del Espíritu Santo.
            </p>
          </div>
          <a class="font-label text-xs font-bold uppercase tracking-[0.2em] text-primary flex items-center gap-3 group/link" href="/sacramentos/confirmacion">
            <span class="relative">
              Conocer
              <span class="absolute left-0 -bottom-1 h-px w-full bg-primary origin-left scale-x-50 group-hover/link:scale-x-100 transition-transform duration-500"></span>
            </span>
            <Icon name="lucide:arrow-right" class="w-4 h-4 group-hover/link:translate-x-1 transition-transform" />
          </a>
        </article>

        <!-- Matrimonio -->
        <article class="group bg-surface-container-lowest p-8 lg:p-10 flex flex-col justify-between hover:bg-surface transition-colors duration-500 reveal stagger-4 h-full min-h-[360px]">
          <div>
            <div class="flex items-start justify-between mb-8">
              <span class="font-display text-xs font-semibold text-secondary tracking-widest">04</span>
              <div class="w-14 h-14 rounded-full border border-outline-variant/60 flex items-center justify-center text-primary group-hover:border-secondary group-hover:text-secondary transition-all duration-500">
                <Icon name="lucide:heart-handshake" class="w-7 h-7" />
              </div>
            </div>
            <h3 class="font-display text-xl lg:text-2xl font-bold text-primary mb-3 leading-tight">Matrimonio</h3>
            <p class="font-body text-sm text-on-surface-variant leading-relaxed mb-8">
              La alianza sagrada entre un varón y una mujer, elevada por Cristo a la dignidad de sacramento.
            </p>
          </div>
          <a class="font-label text-xs font-bold uppercase tracking-[0.2em] text-primary flex items-center gap-3 group/link" href="/sacramentos/matrimonio">
            <span class="relative">
              Conocer
              <span class="absolute left-0 -bottom-1 h-px w-full bg-primary origin-left scale-x-50 group-hover/link:scale-x-100 transition-transform duration-500"></span>
            </span>
            <Icon name="lucide:arrow-right" class="w-4 h-4 group-hover/link:translate-x-1 transition-transform" />
          </a>
        </article>

      </div>

      <!-- Footer -->
      <div class="mt-12 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6 reveal">
        <p class="font-body text-sm text-on-surface-variant italic max-w-md">
          «Los sacramentos son signos sensibles y eficaces de la gracia, instituidos por Cristo y confiados a la Iglesia.»
        </p>
        <a
          href="/sacramentos"
          class="inline-flex items-center gap-3 font-label text-xs font-bold uppercase tracking-[0.2em] text-primary hover:text-secondary transition-colors group"
        >
          Ver todos los sacramentos
          <Icon name="lucide:arrow-right" class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
        </a>
      </div>
    </div>
  </section>

  <!-- Sectores Section (Editorial Layout) -->
  <section class="py-28 bg-surface-container-low border-y border-outline-variant/30">
    <div class="px-6 md:px-margin-desktop max-w-[1280px] mx-auto">

      <!-- Header editorial -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 mb-20 items-end reveal">
        <div class="lg:col-span-7">
          <div class="flex items-center gap-3 mb-6">
            <span class="h-px w-10 bg-secondary"></span>
            <span class="font-label text-xs font-bold uppercase tracking-[0.3em] text-secondary">Geografía de Fe</span>
          </div>
          <h2 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold text-primary leading-[1.05] tracking-tight">
            Nuestros<br/>
            <span class="italic font-medium text-secondary">Sectores</span>
          </h2>
        </div>
        <div class="lg:col-span-5 lg:pb-3">
          <p class="font-body text-base lg:text-lg text-on-surface-variant leading-relaxed">
            Una parroquia organizada en comunidades, cada una con su propio caminar pastoral y unidas por una misma fe en Cristo Salvador.
          </p>
        </div>
      </div>

      {/* Sede Parroquial — featured */}
      {sede && (
        <article class="group bg-surface-container-lowest border border-outline-variant/30 rounded-2xl overflow-hidden grid grid-cols-1 md:grid-cols-2 mb-12 reveal hover:shadow-2xl hover:border-secondary/40 transition-all duration-700">
          <div class="relative aspect-[4/3] md:aspect-auto overflow-hidden bg-surface-variant">
            <img
              src={sede.imagen}
              alt={sede.nombre}
              class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105"
              loading="lazy"
            />
            <div class="absolute top-4 left-4 bg-secondary text-on-secondary font-label text-[10px] font-bold uppercase tracking-[0.2em] px-3 py-1.5 rounded-full">
              Sede Parroquial
            </div>
            <div class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent md:hidden"></div>
          </div>
          <div class="p-8 lg:p-12 flex flex-col justify-center">
            <span class="font-display text-xs font-semibold text-secondary tracking-widest mb-3">PRINCIPAL</span>
            <h3 class="font-display text-3xl lg:text-4xl font-bold text-primary mb-4 leading-tight">{sede.nombre}</h3>
            <p class="font-body text-base text-on-surface-variant leading-relaxed mb-8">{sede.descripcion}</p>
            <div class="flex items-center gap-2 font-label text-xs text-on-surface-variant pt-6 border-t border-outline-variant/40">
              <Icon name="lucide:map-pin" class="w-4 h-4 text-secondary" />
              <span>Colonia Cerro Grande, Tegucigalpa</span>
            </div>
          </div>
        </article>
      )}

      {/* Sectores restantes — grilla numerada */}
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-px bg-outline-variant/30 border border-outline-variant/30 rounded-xl overflow-hidden">
        {sectoresRestantes.map((s, i) => (
          <article class={`group bg-surface-container-lowest p-8 lg:p-10 flex flex-col hover:bg-surface transition-colors duration-500 reveal stagger-${(i % 6) + 1} h-full min-h-[220px]`}>
            <div class="flex items-start justify-between mb-6">
              <span class="font-display text-xs font-semibold text-secondary tracking-widest">{String(i + 1).padStart(2, '0')}</span>
              <Icon name="lucide:map-pin" class="w-5 h-5 text-outline-variant group-hover:text-secondary transition-colors duration-500" />
            </div>
            <h3 class="font-display text-lg lg:text-xl font-bold text-primary mb-3 leading-tight">{s.nombre}</h3>
            <p class="font-body text-sm text-on-surface-variant leading-relaxed">{s.descripcion}</p>
          </article>
        ))}
      </div>

    </div>
  </section>

  <!-- Horarios de Misa — después de Mensaje del Párroco -->

  <!-- Nuestros Sacerdotes (Editorial Layout) -->
  {(parroco || vicario || colaborador) && (
    <section class="py-28 bg-surface border-y border-outline-variant/30">
      <div class="px-6 md:px-margin-desktop max-w-[1280px] mx-auto">

        <!-- Header editorial -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 mb-20 items-end reveal">
          <div class="lg:col-span-7">
            <div class="flex items-center gap-3 mb-6">
              <span class="h-px w-10 bg-secondary"></span>
              <span class="font-label text-xs font-bold uppercase tracking-[0.3em] text-secondary">Liderazgo Pastoral</span>
            </div>
            <h2 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold text-primary leading-[1.05] tracking-tight">
              Nuestros<br/>
              <span class="italic font-medium text-secondary">Sacerdotes</span>
            </h2>
          </div>
          <div class="lg:col-span-5 lg:pb-3">
            <p class="font-body text-base lg:text-lg text-on-surface-variant leading-relaxed">
              Los pastores que Cristo ha puesto al servicio de nuestra comunidad para guiarnos, santificarnos y enseñarnos el Evangelio.
            </p>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-outline-variant/30 border border-outline-variant/30 rounded-xl overflow-hidden">

          {parroco && (
            <article class="group bg-surface-container-lowest hover:bg-surface transition-colors duration-500 reveal">
              <div class="relative aspect-[4/3] overflow-hidden bg-surface-variant">
                <img
                  src={parroco.imagen}
                  alt={parroco.nombre}
                  class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent"></div>
                <div class="absolute top-4 left-4 bg-secondary text-on-secondary font-label text-[10px] font-bold uppercase tracking-[0.2em] px-3 py-1.5 rounded-full">
                  Párroco
                </div>
              </div>
              <div class="p-8 lg:p-10">
                <span class="font-display text-xs font-semibold text-secondary tracking-widest mb-3 block">PRINCIPAL</span>
                <h3 class="font-display text-xl lg:text-2xl font-bold text-primary mb-3 leading-tight">{parroco.nombre}</h3>
                <p class="font-body text-sm text-on-surface-variant leading-relaxed">
                  {parroco.descripcion}
                </p>
              </div>
            </article>
          )}

          {vicario && (
            <article class="group bg-surface-container-lowest hover:bg-surface transition-colors duration-500 reveal stagger-1">
              <div class="relative aspect-[4/3] overflow-hidden bg-surface-variant">
                <img
                  src={vicario.imagen}
                  alt={vicario.nombre}
                  class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent"></div>
                <div class="absolute top-4 left-4 bg-secondary text-on-secondary font-label text-[10px] font-bold uppercase tracking-[0.2em] px-3 py-1.5 rounded-full">
                  Vicario
                </div>
              </div>
              <div class="p-8 lg:p-10">
                <span class="font-display text-xs font-semibold text-secondary tracking-widest mb-3 block">VICARIO</span>
                <h3 class="font-display text-xl lg:text-2xl font-bold text-primary mb-3 leading-tight">{vicario.nombre}</h3>
                <p class="font-body text-sm text-on-surface-variant leading-relaxed">
                  {vicario.descripcion}
                </p>
              </div>
            </article>
          )}

          {colaborador && (
            <article class="group bg-surface-container-lowest hover:bg-surface transition-colors duration-500 reveal stagger-2">
              <div class="relative aspect-[4/3] overflow-hidden bg-surface-variant">
                <img
                  src={colaborador.imagen}
                  alt={colaborador.nombre}
                  class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent"></div>
                <div class="absolute top-4 left-4 bg-secondary text-on-secondary font-label text-[10px] font-bold uppercase tracking-[0.2em] px-3 py-1.5 rounded-full">
                  Colaborador
                </div>
              </div>
              <div class="p-8 lg:p-10">
                <span class="font-display text-xs font-semibold text-secondary tracking-widest mb-3 block">COLABORADOR</span>
                <h3 class="font-display text-xl lg:text-2xl font-bold text-primary mb-3 leading-tight">{colaborador.nombre}</h3>
                <p class="font-body text-sm text-on-surface-variant leading-relaxed">
                  {colaborador.descripcion}
                </p>
              </div>
            </article>
          )}

        </div>

      </div>
    </section>
  )}

</Layout>
