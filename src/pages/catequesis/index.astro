---
import Layout from '../../layouts/Layout.astro';
import { catequesisProgramas } from '../../config/catequesis';
import { Icon } from 'astro-icon/components';
---

<Layout
  title="Inscripciones de Catequesis"
  description="Inscripciones para catequesis de adultos, Primera Comunión, Confirmación y programa de catequesis matrimonial en la Parroquia El Salvador del Mundo."
>
  <section class="relative min-h-[55vh] flex items-center justify-center overflow-hidden bg-primary hero-clip">
    <div class="absolute inset-0 opacity-30 mix-blend-overlay">
      <div class="absolute inset-0 bg-cover bg-center" style="background-image: url('/img/institucionales/templo_interior.webp');"></div>
    </div>
    <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 50px 50px;"></div>

    <div class="container-tight relative z-10 text-center">
      <div class="inline-flex items-center justify-center w-20 h-20 rounded-3xl bg-white/10 backdrop-blur-sm mb-8">
        <Icon name="lucide:book-open-check" class="w-10 h-10 text-on-primary" />
      </div>
      <h1 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold text-on-primary mb-6">Inscripciones de Catequesis</h1>
      <p class="font-body text-lg lg:text-xl text-primary-fixed max-w-2xl mx-auto">
        Selecciona el proceso de formación correspondiente y completa la inscripción en línea. La oficina parroquial se comunicará al número de contacto registrado para dar seguimiento.
      </p>
    </div>
  </section>

  <section class="bg-surface py-20 md:py-24">
    <div class="mx-auto max-w-[1280px] px-6 md:px-margin-desktop">
      <div class="mb-12 max-w-2xl reveal">
        <span class="font-label text-xs font-bold uppercase tracking-[0.25em] text-secondary">Procesos disponibles</span>
        <h2 class="mt-3 font-display text-3xl font-bold text-primary md:text-4xl">Elige tu catequesis</h2>
        <p class="mt-4 font-body text-on-surface-variant">
          Consulta los requisitos de cada proceso antes de completar el formulario.
        </p>
      </div>

      <div class="grid gap-8 lg:grid-cols-3">
        {catequesisProgramas.map((programa, index) => (
          <article class={`group overflow-hidden rounded-2xl border border-outline-variant/30 bg-surface-container-lowest shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-xl reveal stagger-${index + 1}`}>
            <div class="relative aspect-[16/10] overflow-hidden">
              <img
                src={programa.imagen}
                alt={programa.nombre}
                class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-primary/75 via-primary/15 to-transparent"></div>
              <div class="absolute bottom-4 left-4 rounded-full bg-surface/95 px-3 py-1 font-label text-[11px] font-bold uppercase tracking-wider text-primary backdrop-blur-sm">
                Desde {programa.edadMinima} años
              </div>
            </div>

            <div class="flex h-full flex-col p-7">
              <p class="font-label text-xs font-bold uppercase tracking-[0.18em] text-secondary">{programa.subtitulo}</p>
              <h3 class="mt-3 font-display text-2xl font-bold text-primary">{programa.nombre}</h3>
              <p class="mt-4 font-body text-sm leading-relaxed text-on-surface-variant">{programa.descripcion}</p>

              <div class="mt-6 border-t border-outline-variant/30 pt-5">
                <p class="mb-3 font-label text-xs font-bold uppercase tracking-wider text-on-surface">Requisitos principales</p>
                <ul class="space-y-2">
                  {programa.requisitos.slice(0, 3).map((requisito) => (
                    <li class="flex items-start gap-2 font-body text-sm text-on-surface-variant">
                      <span class="material-symbols-outlined mt-0.5 text-base text-secondary">check_circle</span>
                      <span>{requisito}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <a
                href={`/catequesis/${programa.slug}`}
                class="mt-7 inline-flex items-center justify-center gap-2 rounded-xl bg-primary px-6 py-3.5 font-label text-xs font-bold uppercase tracking-widest text-on-primary transition-all hover:bg-primary-container"
              >
                Inscribirme
                <span class="material-symbols-outlined text-lg">arrow_forward</span>
              </a>
            </div>
          </article>
        ))}
      </div>

      <div class="mt-14 overflow-hidden rounded-2xl border border-secondary/30 bg-primary text-on-primary shadow-lg reveal">
        <div class="grid lg:grid-cols-12">
          <div class="relative min-h-[260px] overflow-hidden lg:col-span-5">
            <img
              src="/img/institucionales/templo-sede.webp"
              alt="Parroquia El Salvador del Mundo"
              class="absolute inset-0 h-full w-full object-cover"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-r from-primary/45 to-primary/75"></div>
            <div class="relative flex h-full min-h-[260px] items-end p-7 md:p-9">
              <div>
                <span class="rounded-full bg-secondary px-3 py-1 font-label text-[10px] font-bold uppercase tracking-wider text-on-secondary">Calendario 2026</span>
                <h3 class="mt-4 font-display text-3xl font-bold leading-tight text-primary-fixed">Catequesis Matrimonial</h3>
              </div>
            </div>
          </div>

          <div class="p-7 md:p-9 lg:col-span-7 lg:p-10">
            <span class="font-label text-xs font-bold uppercase tracking-[0.2em] text-secondary-fixed">Preparación al Matrimonio</span>
            <h3 class="mt-3 font-display text-2xl font-bold text-primary-fixed md:text-3xl">Programa de formación para parejas</h3>
            <p class="mt-4 max-w-2xl font-body text-sm leading-relaxed text-on-primary/80 md:text-base">
              Consulta las fechas y horarios del programa de catequesis de preparación al sacramento del Matrimonio durante 2026.
            </p>

            <div class="mt-6 rounded-xl border border-on-primary/15 bg-on-primary/5 p-5">
              <div class="flex items-start gap-3">
                <Icon name="lucide:calendar-check" class="mt-0.5 h-5 w-5 shrink-0 text-secondary-fixed" />
                <div>
                  <p class="font-label text-[10px] font-bold uppercase tracking-[0.18em] text-secondary-fixed">Próxima jornada</p>
                  <p class="mt-1 font-body text-sm font-semibold text-primary-fixed">14-15 y 21-22 de noviembre de 2026</p>
                  <p class="mt-1 font-body text-xs text-on-primary/70">Sábados 2:00 PM - 5:00 PM · Domingos 9:00 AM - 1:00 PM</p>
                </div>
              </div>
            </div>

            <a
              href="/catequesis/matrimonio"
              class="mt-7 inline-flex items-center gap-2 rounded-xl bg-secondary px-6 py-3.5 font-label text-xs font-bold uppercase tracking-widest text-on-secondary transition-all hover:opacity-90"
            >
              Ver calendario completo
              <Icon name="lucide:arrow-right" class="h-4 w-4" />
            </a>
          </div>
        </div>
      </div>

      <div class="mt-12 rounded-2xl border border-secondary/20 bg-secondary-fixed/20 p-6 md:p-8 reveal">
        <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
          <div>
            <h3 class="font-display text-xl font-bold text-primary">Importante</h3>
            <p class="mt-2 max-w-3xl font-body text-sm leading-relaxed text-on-surface-variant">
              La inscripción en línea registra tus datos para iniciar el proceso. Los documentos indicados en los requisitos deberán presentarse a la parroquia cuando sean solicitados por el equipo de catequesis.
            </p>
          </div>
          <a href="/oficina" class="shrink-0 font-label text-xs font-bold uppercase tracking-wider text-secondary hover:underline">
            Contactar oficina parroquial
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>