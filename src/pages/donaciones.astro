---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/ui/Hero.astro';
import { Icon } from 'astro-icon/components';
import { siteConfig, whatsappLink } from '../config/site';

const categorias = [
	{ nombre: "Granos", items: ["Arroz", "Frijoles", "Lentejas"], icono: "lucide:wheat" },
	{ nombre: "Enlatados", items: ["Atún", "Sardinas", "Vegetales"], icono: "lucide:package" },
	{ nombre: "Aceites", items: ["Aceite vegetal"], icono: "lucide:droplet" },
	{ nombre: "Lácteos", items: ["Leche en polvo"], icono: "lucide:milk" },
	{ nombre: "Pastas", items: ["Espaguetis", "Coditos"], icono: "lucide:utensils" },
	{ nombre: "Endulzantes", items: ["Azúcar", "Café"], icono: "lucide:cookie" }
];

const puntos = [
	{ titulo: "Sede Parroquial", descripcion: "Colonia Cerro Grande Zona 4, Comayagüela.", icono: "lucide:map-pin", horario: "Lun a Vie · 2:00 PM - 6:15 PM" },
	{ titulo: "En los horarios de misa", descripcion: "Puedes llevar tu donación en cualquiera de los sectores durante los horarios de misa.", icono: "lucide:church", horario: "" },
];
---

<Layout
	title="Donaciones"
	description="Apoya la misión de nuestra parroquia a través de tus ofrendas, donaciones y la Libra de Amor."
>
	<Hero
		title="Apoya nuestra misión"
		subtitle="Tus ofrendas y tu tiempo hacen posible la labor evangelizadora y social de nuestra parroquia."
		image="https://images.unsplash.com/photo-1532629345422-7515f3d16bb6?q=80&w=2400"
	/>

	<!-- Cita Bíblica destacada -->
	<section class="py-24 lg:py-32 bg-surface border-y border-outline-variant/30">
		<div class="px-6 md:px-margin-desktop max-w-[1280px] mx-auto">

			<div class="text-center max-w-4xl mx-auto reveal">
				<div class="inline-flex items-center justify-center w-20 h-20 rounded-full border border-outline-variant/60 bg-surface-container-lowest mb-10">
					<Icon name="lucide:quote" class="w-10 h-10 text-secondary" />
				</div>
				<blockquote class="font-display text-3xl md:text-4xl lg:text-5xl italic text-primary leading-[1.2] tracking-tight mb-10">
					"Dios ama al que da con alegría."
				</blockquote>
				<div class="flex items-center justify-center gap-4">
					<span class="h-px w-12 bg-secondary"></span>
					<p class="font-label text-sm font-bold uppercase tracking-[0.3em] text-secondary">2 Corintios 9, 7</p>
					<span class="h-px w-12 bg-secondary"></span>
				</div>
			</div>

		</div>
	</section>

	<!-- ¿Qué es la Libra de Amor? -->
	<section class="py-24 lg:py-28 bg-surface-container-low">
		<div class="px-6 md:px-margin-desktop max-w-[1280px] mx-auto">

			<!-- Header editorial -->
			<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 mb-16 lg:mb-20 items-end reveal">
				<div class="lg:col-span-7">
					<div class="flex items-center gap-3 mb-6">
						<span class="h-px w-10 bg-secondary"></span>
						<span class="font-label text-xs font-bold uppercase tracking-[0.3em] text-secondary">Solidaridad Parroquial</span>
					</div>
					<h2 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold text-primary leading-[1.05] tracking-tight">
						Libra<br/>
						<span class="italic font-medium text-secondary">de Amor</span>
					</h2>
				</div>
				<div class="lg:col-span-5 lg:pb-3">
					<p class="font-body text-base lg:text-lg text-on-surface-variant leading-relaxed">
						Una iniciativa de nuestra comunidad para llevar alimento a familias vulnerables. Tu donación se convierte en esperanza compartida.
					</p>
				</div>
			</div>

			<!-- Descripción destacada + Categorías -->
			<div class="grid grid-cols-1 lg:grid-cols-12 gap-px bg-outline-variant/30 border border-outline-variant/30 rounded-xl overflow-hidden">

				<!-- Descripción destacada (5 cols) -->
				<div class="lg:col-span-5 bg-surface-container-lowest p-8 lg:p-10 reveal flex flex-col justify-between">
					<div>
						<div class="w-14 h-14 rounded-full border border-outline-variant/60 flex items-center justify-center text-primary mb-6">
							<Icon name="lucide:heart-handshake" class="w-7 h-7" />
						</div>
						<span class="font-label text-[10px] font-bold uppercase tracking-[0.25em] text-secondary mb-3 block">La iniciativa</span>
						<h3 class="font-display text-2xl lg:text-3xl font-bold text-primary leading-tight mb-6">
							Una libra de alimento, una libra de amor
						</h3>
						<p class="font-body text-base text-on-surface-variant leading-relaxed mb-8">
							Cada mes, nuestra parroquia recolecta alimentos no perecederos para distribuirlos a familias necesitadas de la comunidad. Una sola libra de arroz, frijol o aceite puede ser la diferencia para una familia.
						</p>
					</div>
					<div class="pt-6 border-t border-outline-variant/30">
						<p class="font-body text-sm text-on-surface-variant italic leading-relaxed">
							«Allí donde hay amor, hay Dios. Y donde hay Dios, nada falta.»
						</p>
					</div>
				</div>

				<!-- Categorías de alimentos (7 cols) -->
				<div class="lg:col-span-7 bg-surface-container-lowest p-8 lg:p-10 reveal stagger-1">
					<span class="font-label text-[10px] font-bold uppercase tracking-[0.25em] text-secondary mb-6 block">Alimentos que recolectamos</span>
					<div class="grid grid-cols-2 sm:grid-cols-3 gap-px bg-outline-variant/30 border border-outline-variant/30 rounded-xl overflow-hidden">
						{categorias.map((cat, i) => (
							<article class={`group bg-surface-container-lowest p-6 flex flex-col hover:bg-surface transition-colors duration-500 reveal stagger-${(i % 6) + 1} h-full min-h-[180px]`}>
								<div class="flex items-start justify-between mb-4">
									<span class="font-display text-xs font-semibold text-secondary tracking-widest">{String(i + 1).padStart(2, '0')}</span>
									<div class="w-10 h-10 rounded-full border border-outline-variant/60 flex items-center justify-center text-primary group-hover:border-secondary group-hover:text-secondary transition-all duration-500">
										<Icon name={cat.icono} class="w-5 h-5" />
									</div>
								</div>
								<h4 class="font-display text-base lg:text-lg font-bold text-primary mb-2 leading-tight">{cat.nombre}</h4>
								<ul class="space-y-1 mt-auto">
									{cat.items.map(item => (
										<li class="font-body text-xs text-on-surface-variant leading-relaxed">{item}</li>
									))}
								</ul>
							</article>
						))}
					</div>
				</div>

			</div>

		</div>
	</section>

	<!-- Puntos de acopio -->
	<section class="py-24 lg:py-28 bg-surface border-y border-outline-variant/30">
		<div class="px-6 md:px-margin-desktop max-w-[1280px] mx-auto">

			<!-- Header editorial -->
			<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 mb-16 lg:mb-20 items-end reveal">
				<div class="lg:col-span-7">
					<div class="flex items-center gap-3 mb-6">
						<span class="h-px w-10 bg-secondary"></span>
						<span class="font-label text-xs font-bold uppercase tracking-[0.3em] text-secondary">¿Cómo participar?</span>
					</div>
					<h2 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold text-primary leading-[1.05] tracking-tight">
						Lleva tu<br/>
						<span class="italic font-medium text-secondary">donación</span>
					</h2>
				</div>
				<div class="lg:col-span-5 lg:pb-3">
					<p class="font-body text-base lg:text-lg text-on-surface-variant leading-relaxed">
						Puedes traer tus alimentos no perecederos a cualquiera de estos puntos en los horarios indicados.
					</p>
				</div>
			</div>

			<!-- Puntos de acopio — bento 2-col -->
			<div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-outline-variant/30 border border-outline-variant/30 rounded-xl overflow-hidden">
				{puntos.map((p, i) => (
					<article class={`group bg-surface-container-lowest p-8 lg:p-10 flex flex-col hover:bg-surface transition-colors duration-500 reveal stagger-${(i % 2) + 1} h-full min-h-[240px]`}>
						<div class="flex items-start justify-between mb-6">
							<span class="font-display text-xs font-semibold text-secondary tracking-widest">{String(i + 1).padStart(2, '0')}</span>
							<div class="w-14 h-14 rounded-full border border-outline-variant/60 flex items-center justify-center text-primary group-hover:border-secondary group-hover:text-secondary transition-all duration-500">
								<Icon name={p.icono} class="w-7 h-7" />
							</div>
						</div>
						<h3 class="font-display text-xl lg:text-2xl font-bold text-primary mb-3 leading-tight">{p.titulo}</h3>
						<p class="font-body text-base text-on-surface-variant leading-relaxed mb-4">{p.descripcion}</p>
						{p.horario && (
							<div class="mt-auto pt-4 border-t border-outline-variant/30 flex items-center gap-2">
								<Icon name="lucide:clock" class="w-4 h-4 text-secondary flex-shrink-0" />
								<p class="font-label text-xs uppercase tracking-[0.2em] text-on-surface-variant">{p.horario}</p>
							</div>
						)}
					</article>
				))}
			</div>

		</div>
	</section>

	<!-- Transferencia Bancaria -->
	<section class="py-24 lg:py-28 bg-surface-container-low border-y border-outline-variant/30">
		<div class="px-6 md:px-margin-desktop max-w-[1280px] mx-auto">

			<!-- Header editorial -->
			<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 mb-16 lg:mb-20 items-end reveal">
				<div class="lg:col-span-7">
					<div class="flex items-center gap-3 mb-6">
						<span class="h-px w-10 bg-secondary"></span>
						<span class="font-label text-xs font-bold uppercase tracking-[0.3em] text-secondary">Transferencia Bancaria</span>
					</div>
					<h2 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold text-primary leading-[1.05] tracking-tight">
						Dona por<br/>
						<span class="italic font-medium text-secondary">transferencia</span>
					</h2>
				</div>
				<div class="lg:col-span-5 lg:pb-3">
					<p class="font-body text-base lg:text-lg text-on-surface-variant leading-relaxed">
						Si prefieres hacerlo desde la comodidad de tu casa o app bancaria, puedes hacer una transferencia directa a nuestra cuenta parroquial.
					</p>
				</div>
			</div>

			<!-- Bento: Datos bancarios (8 cols) + Instrucciones (4 cols) -->
			<div class="grid grid-cols-1 lg:grid-cols-12 gap-px bg-outline-variant/30 border border-outline-variant/30 rounded-xl overflow-hidden">

				<!-- Datos bancarios (8 cols) -->
				<article class="lg:col-span-8 bg-surface-container-lowest p-8 lg:p-12 reveal">
					<div class="flex items-start gap-4 mb-8">
						<div class="w-16 h-16 rounded-full border border-outline-variant/60 flex items-center justify-center text-primary flex-shrink-0">
							<Icon name="lucide:landmark" class="w-8 h-8" />
						</div>
						<div>
							<span class="font-label text-[10px] font-bold uppercase tracking-[0.25em] text-secondary mb-2 block">Banco</span>
							<p class="font-display text-2xl lg:text-3xl font-bold text-primary leading-tight">Banpais</p>
						</div>
					</div>

					<div class="grid grid-cols-1 sm:grid-cols-2 gap-px bg-outline-variant/30 border border-outline-variant/30 rounded-xl overflow-hidden">
						<div class="bg-surface-container-lowest p-6 lg:p-8">
							<div class="flex items-center justify-between gap-3 mb-2">
								<span class="font-label text-[10px] font-bold uppercase tracking-[0.25em] text-secondary">Número de Cuenta</span>
								<button
									type="button"
									onclick="copyAccount('21-300-032384-0', this)"
									class="copy-btn flex items-center gap-1.5 font-label text-[10px] font-bold uppercase tracking-[0.2em] text-secondary hover:text-primary transition-colors"
									aria-label="Copiar número de cuenta"
								>
									<Icon name="lucide:copy" class="copy-icon w-3.5 h-3.5" />
									<Icon name="lucide:check" class="check-icon w-3.5 h-3.5 hidden" />
									<span class="copy-label">Copiar</span>
								</button>
							</div>
							<p class="font-display text-2xl lg:text-3xl font-bold text-primary leading-tight tracking-tight">21-300-032384-0</p>
						</div>
						<div class="bg-surface-container-lowest p-6 lg:p-8">
							<span class="font-label text-[10px] font-bold uppercase tracking-[0.25em] text-secondary mb-2 block">Titular</span>
							<p class="font-display text-base lg:text-lg font-bold text-primary leading-tight">Parroquia El Salvador del Mundo</p>
						</div>
					</div>
				</article>

				<!-- Instrucciones (4 cols, dark) -->
				<aside class="lg:col-span-4 bg-primary text-on-primary p-8 lg:p-10 reveal stagger-1 flex flex-col justify-between">
					<div>
						<div class="w-14 h-14 rounded-full border border-on-primary/30 flex items-center justify-center text-primary-fixed mb-6">
							<Icon name="lucide:message-circle" class="w-7 h-7" />
						</div>
						<span class="font-label text-[10px] font-bold uppercase tracking-[0.25em] text-secondary-fixed mb-3 block">Importante</span>
						<p class="font-display text-xl lg:text-2xl italic text-primary-fixed leading-snug">
							"Envíanos tu comprobante por WhatsApp para registrar tu ofrenda y agradecerte personalmente."
						</p>
					</div>
					<div class="mt-8 pt-6 border-t border-on-primary/20">
						<p class="font-body text-xs text-on-primary/80 leading-relaxed">
							Tu generosidad se transforma en alimento para familias de nuestra comunidad.
						</p>
					</div>
				</aside>

			</div>

		</div>
	</section>

	<script>
		function copyAccount(accountNumber, btn) {
			const fallback = () => {
				const ta = document.createElement('textarea');
				ta.value = accountNumber;
				ta.style.position = 'fixed';
				ta.style.opacity = '0';
				document.body.appendChild(ta);
				ta.select();
				try { document.execCommand('copy'); } catch (_) {}
				document.body.removeChild(ta);
			};
			const showCopied = () => {
				const label = btn.querySelector('.copy-label');
				const copyIcon = btn.querySelector('.copy-icon');
				const checkIcon = btn.querySelector('.check-icon');
				if (label) label.textContent = '¡Copiado!';
				if (copyIcon) copyIcon.classList.add('hidden');
				if (checkIcon) checkIcon.classList.remove('hidden');
				btn.classList.add('text-primary');
				setTimeout(() => {
					if (label) label.textContent = 'Copiar';
					if (copyIcon) copyIcon.classList.remove('hidden');
					if (checkIcon) checkIcon.classList.add('hidden');
					btn.classList.remove('text-primary');
				}, 2000);
			};
			if (navigator.clipboard && window.isSecureContext) {
				navigator.clipboard.writeText(accountNumber).then(showCopied).catch(() => { fallback(); showCopied(); });
			} else {
				fallback();
				showCopied();
			}
		}
	</script>

	<!-- CTA -->
	<section class="section-padding bg-primary">
		<div class="container-tight max-w-3xl text-center">
			<Icon name="mdi:whatsapp" class="w-12 h-12 lg:w-16 lg:h-16 text-on-primary mx-auto mb-6" />
			<h2 class="font-display text-2xl lg:text-3xl font-bold text-on-primary mb-4">¿Quieres sumarte como voluntario?</h2>
			<p class="font-body text-base lg:text-lg text-on-primary/90 mb-8">
				Si deseas colaborar con la clasificación, distribución o logística de la Libra de Amor, contáctanos directamente por WhatsApp.
			</p>
			<div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
				<a
					href={whatsappLink('Hola, quisiera sumarme a la Libra de Amor')}
					target="_blank"
					class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-on-primary text-primary px-6 lg:px-8 py-3 lg:py-4 rounded-lg font-label text-sm font-semibold hover:bg-surface-container-low transition-all duration-300"
				>
					<Icon name="mdi:whatsapp" class="w-5 h-5" />
					Contactar por WhatsApp
				</a>
				<a
					href="/oficina"
					class="w-full sm:w-auto inline-flex items-center justify-center gap-2 border-2 border-on-primary text-on-primary px-6 lg:px-8 py-3 lg:py-4 rounded-lg font-label text-sm font-semibold hover:bg-white/10 transition-all duration-300"
				>
					Ver horarios de oficina
				</a>
			</div>
		</div>
	</section>
</Layout>