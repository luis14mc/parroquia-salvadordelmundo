---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/ui/Hero.astro';
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';
import { siteConfig } from '../config/site';

const allSectores = await getCollection('sectores');
const sectores = allSectores
	.sort((a, b) => (a.data.orden ?? 0) - (b.data.orden ?? 0))
	.map(s => s.data);

const allGrupos = await getCollection('grupos');
const grupos = allGrupos
	.sort((a, b) => (a.data.orden ?? 0) - (b.data.orden ?? 0))
	.map(g => g.data);
---

<Layout
	title="Nosotros"
	description="Conoce la historia, misión, visión y sectores de la Parroquia El Salvador del Mundo en Tegucigalpa, Honduras."
>
	<Hero
		title="Nuestra Identidad"
		subtitle="Conoce la historia, misión y visión de nuestra comunidad parroquial comprometida con la fe."
		image="https://images.unsplash.com/photo-1548625361-195fe5772c97?q=80&w=2400"
	/>

	<!-- Historia -->
	<section class="section-padding bg-surface">
		<div class="container-tight">
			<div class="max-w-3xl mx-auto text-center space-y-6 lg:space-y-8">
				<div class="reveal">
					<span class="text-xs font-bold uppercase tracking-[0.3em] text-primary mb-4 block font-label">Historia</span>
					<h2 class="font-display text-3xl lg:text-4xl font-bold text-on-background mb-4 lg:mb-6">Nuestra Trayectoria</h2>
				</div>

				<p class="font-body text-base lg:text-lg text-on-surface-variant leading-relaxed reveal">
					{siteConfig.resenaHistorica}
				</p>

				<div class="pt-8 border-t border-outline-variant/30 reveal">
					<p class="font-label text-xs font-bold uppercase tracking-[0.2em] text-on-surface-variant mb-2">Párroco Actual</p>
					<p class="font-display text-lg lg:text-xl font-bold text-primary">{siteConfig.parroco}</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Misión y Visión -->
	<section class="section-padding bg-surface-container-low">
		<div class="container-tight">
			<div class="grid lg:grid-cols-2 gap-10 lg:gap-16">
				<!-- Misión -->
				<div class="space-y-4 lg:space-y-6 bg-surface-container-lowest p-8 lg:p-10 rounded-xl border border-outline-variant shadow-sm reveal">
					<span class="text-xs font-bold uppercase tracking-[0.3em] text-primary font-label">Nuestra Misión</span>
					<h2 class="font-display text-2xl lg:text-3xl font-bold text-on-background leading-tight">
						Enviados para evangelizar
					</h2>
					<p class="font-body text-base lg:text-lg text-on-surface-variant leading-relaxed italic">
						"{siteConfig.mision}"
					</p>
				</div>

				<!-- Visión -->
				<div class="space-y-4 lg:space-y-6 bg-surface-container-lowest p-8 lg:p-10 rounded-xl border border-outline-variant shadow-sm reveal">
					<span class="text-xs font-bold uppercase tracking-[0.3em] text-primary font-label">Nuestra Visión</span>
					<h2 class="font-display text-2xl lg:text-3xl font-bold text-on-background leading-tight">
						Comunidad evangelizadora
					</h2>
					<p class="font-body text-base lg:text-lg text-on-surface-variant leading-relaxed italic">
						"{siteConfig.vision}"
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Sectores -->
	<section class="section-padding bg-surface">
		<div class="container-tight">
			<div class="text-center mb-12 lg:mb-16 reveal">
				<span class="text-xs font-bold uppercase tracking-[0.3em] text-primary mb-3 block font-label">Geografía de Fe</span>
				<h2 class="font-display text-3xl lg:text-4xl font-bold text-on-background">Nuestros Sectores</h2>
			</div>

			<div class="grid sm:grid-cols-2 lg:grid-cols-5 gap-6">
				{sectores.map(s => (
					<div class="group bg-surface-container-lowest rounded-xl border border-outline-variant shadow-sm hover:shadow-lg transition-all duration-500 overflow-hidden reveal">
						<div class="aspect-video overflow-hidden relative">
							<img
								src={s.imagen}
								alt={s.nombre}
								class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
								loading="lazy"
							/>
							<div class="absolute inset-0 bg-gradient-to-t from-background/40 to-transparent"></div>
						</div>
						<div class="p-6">
							<div class="flex items-center gap-2 mb-2">
								<h3 class="font-display text-base font-bold text-on-surface group-hover:text-primary transition-colors">{s.nombre}</h3>
								{s.descripcion === 'Sede parroquial.' && (
									<span class="font-label text-[10px] font-bold uppercase tracking-wider bg-primary text-on-primary px-2 py-0.5 rounded-full">Sede</span>
								)}
							</div>
							<p class="font-body text-sm text-on-surface-variant leading-relaxed">{s.descripcion}</p>
						</div>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- Grupos y Movimientos -->
	<section class="section-padding bg-surface-container-low">
		<div class="container-tight">
			<div class="text-center mb-12 lg:mb-16 reveal">
				<span class="text-xs font-bold uppercase tracking-[0.3em] text-primary mb-3 block font-label">Participación</span>
				<h2 class="font-display text-3xl lg:text-4xl font-bold text-on-background">Grupos y Movimientos</h2>
				<p class="font-body text-sm lg:text-base text-on-surface-variant mt-4 max-w-2xl mx-auto">
					La vitalidad de nuestra parroquia se manifiesta a través de sus diversos carismas y servicios.
				</p>
			</div>

			<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
				{grupos.map(g => (
					<div class="group bg-surface-container-lowest p-8 rounded-xl border border-outline-variant shadow-sm hover:shadow-lg hover:-translate-y-2 transition-all duration-500 reveal">
						<div class="w-14 h-14 rounded-2xl bg-primary-fixed flex items-center justify-center mb-6 group-hover:bg-primary group-hover:scale-110 transition-all duration-500">
							<Icon name={g.icono} class="w-7 h-7 text-on-primary-fixed-variant group-hover:text-on-primary transition-colors duration-500" />
						</div>
						<h3 class="font-display text-lg font-bold text-on-surface mb-3 group-hover:text-primary transition-colors">{g.nombre}</h3>
						<p class="font-body text-sm text-on-surface-variant leading-relaxed">
							{g.descripcion ?? `Un espacio de crecimiento espiritual y servicio comunitario bajo el carisma de ${g.nombre}.`}
						</p>
					</div>
				))}
			</div>
		</div>
	</section>
</Layout>
