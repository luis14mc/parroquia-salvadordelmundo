---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/ui/Hero.astro';
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';
import { siteConfig, whatsappLink } from '../config/site';

const allSectores = await getCollection('sectores');
const sectores = allSectores
	.sort((a, b) => (a.data.orden ?? 0) - (b.data.orden ?? 0))
	.map(s => s.data);

const sede = sectores.find(s => s.nombre === 'Sector Salvador del Mundo');
const sectoresRestantes = sectores.filter(s => s.nombre !== 'Sector Salvador del Mundo');

const allGrupos = await getCollection('grupos');
const grupos = allGrupos
	.sort((a, b) => (a.data.orden ?? 0) - (b.data.orden ?? 0))
	.map(g => g.data);
---

<Layout
	title="Nosotros"
	description="Conoce la historia, misión, visión y sectores de la Parroquia El Salvador del Mundo en Tegucigalpa, Honduras."
>
	<Hero
		title="Nuestra Identidad"
		subtitle="Conoce la historia, misión y visión de nuestra comunidad parroquial comprometida con la fe."
		image="/img/institucionales/templo-sede.webp"
	/>

	<!-- Historia -->
	<section class="section-padding bg-surface">
		<div class="container-tight">

			<div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center mb-16 lg:mb-20">

				<!-- Imagen -->
				<div class="lg:col-span-5 reveal">
					<div class="relative aspect-[4/5] rounded-2xl overflow-hidden border border-outline-variant/30 bg-surface-variant shadow-lg">
						<img
							src="/img/institucionales/salvador-del-mundo.webp"
							alt="Imagen del Salvador del Mundo"
							class="w-full h-full object-cover"
							loading="lazy"
						/>
						<div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent"></div>
						<div class="absolute bottom-6 left-6 right-6 text-on-primary">
							<span class="font-label text-[10px] font-bold uppercase tracking-[0.25em] text-secondary-fixed mb-2 block">Desde 1996</span>
							<p class="font-display text-lg lg:text-xl font-bold text-primary-fixed leading-tight">Sirviendo a la comunidad</p>
						</div>
					</div>
				</div>

				<!-- Texto -->
				<div class="lg:col-span-7 reveal stagger-1">
					<div class="flex items-center gap-3 mb-6">
						<span class="h-px w-10 bg-secondary"></span>
						<span class="text-xs font-bold uppercase tracking-[0.3em] text-primary font-label">Historia</span>
					</div>
					<h2 class="font-display text-3xl lg:text-4xl xl:text-5xl font-bold text-on-background mb-6 lg:mb-8 leading-[1.1]">
						Nuestra<br/>
						<span class="italic font-medium text-secondary">Trayectoria</span>
					</h2>

					<p class="font-body text-base lg:text-lg text-on-surface-variant leading-relaxed mb-10">
						{siteConfig.resenaHistorica}
					</p>

					<div class="pt-8 border-t border-outline-variant/30 grid grid-cols-1 sm:grid-cols-2 gap-6">
						<div>
							<p class="font-label text-xs font-bold uppercase tracking-[0.2em] text-on-surface-variant mb-2">Párroco Actual</p>
							<p class="font-display text-lg lg:text-xl font-bold text-primary">P. Juan Martínez</p>
						</div>
						<div>
							<p class="font-label text-xs font-bold uppercase tracking-[0.2em] text-on-surface-variant mb-2">Vicario</p>
							<p class="font-display text-lg lg:text-xl font-bold text-primary">P. Samuel Salgado</p>
						</div>
					</div>
				</div>

			</div>

			<!-- Comunidad Presbiteral — conectado a Historia -->
			<div class="reveal rounded-2xl overflow-hidden shadow-lg max-w-5xl mx-auto bg-surface-container-lowest">

				<!-- Mobile: imagen arriba + texto abajo -->
				<div class="md:hidden">
					<img
						src="/img/institucionales/sacerdotes.webp"
						alt="P. Juan Martínez y P. Samuel celebrando juntos"
						class="w-full h-72 object-cover"
						loading="lazy"
					/>
					<div class="bg-primary text-on-primary p-6">
						<span class="font-label text-[10px] font-bold uppercase tracking-[0.25em] text-secondary-fixed mb-2 block">Comunidad Presbiteral</span>
						<h2 class="font-display text-xl font-bold text-primary-fixed mb-2 leading-tight">Sirviendo juntos a nuestra parroquia</h2>
						<p class="font-body text-sm text-on-primary/85 leading-relaxed">
							Nuestros sacerdotes caminan unidos en la misión de anunciar el Evangelio, celebrar los sacramentos y acompañar a cada familia de nuestra comunidad.
						</p>
					</div>
				</div>

				<!-- Desktop: imagen con overlay -->
				<div class="hidden md:block relative">
					<img
						src="/img/institucionales/sacerdotes.webp"
						alt="P. Juan Martínez y P. Samuel celebrando juntos"
						class="w-full h-96 object-cover"
						loading="lazy"
					/>
					<div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent flex items-end">
						<div class="p-12 text-on-primary max-w-2xl">
							<span class="font-label text-[10px] font-bold uppercase tracking-[0.25em] text-secondary-fixed mb-2 block">Comunidad Presbiteral</span>
							<h2 class="font-display text-3xl font-bold text-primary-fixed mb-3 leading-tight">Sirviendo juntos a nuestra parroquia</h2>
							<p class="font-body text-base text-on-primary/85 leading-relaxed">
								Nuestros sacerdotes caminan unidos en la misión de anunciar el Evangelio, celebrar los sacramentos y acompañar a cada familia de nuestra comunidad.
							</p>
						</div>
					</div>
				</div>

			</div>

		</div>
	</section>

	<!-- Misión y Visión (Editorial Layout) -->
	<section class="py-28 bg-surface-container-low border-y border-outline-variant/30">
		<div class="px-6 md:px-margin-desktop max-w-[1280px] mx-auto">

			<!-- Header editorial -->
			<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 mb-20 items-end reveal">
				<div class="lg:col-span-7">
					<div class="flex items-center gap-3 mb-6">
						<span class="h-px w-10 bg-secondary"></span>
						<span class="font-label text-xs font-bold uppercase tracking-[0.3em] text-secondary">Nuestro Horizonte</span>
					</div>
					<h2 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold text-primary leading-[1.05] tracking-tight">
						Misión<br/>
						<span class="italic font-medium text-secondary">&nbsp;y Visión</span>
					</h2>
				</div>
				<div class="lg:col-span-5 lg:pb-3">
					<p class="font-body text-base lg:text-lg text-on-surface-variant leading-relaxed">
						El rumbo que guía nuestra parroquia: lo que somos llamados a hacer hoy y la comunidad que deseamos construir mañana.
					</p>
				</div>
			</div>

			<!-- Cards Misión y Visión -->
			<div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-outline-variant/30 border border-outline-variant/30 rounded-xl overflow-hidden">

				<!-- Misión -->
				<article class="group bg-surface-container-lowest p-10 lg:p-14 flex flex-col hover:bg-surface transition-colors duration-500 reveal h-full min-h-[420px]">
					<div class="flex items-start justify-between mb-8">
						<span class="font-display text-xs font-semibold text-secondary tracking-widest">01</span>
						<div class="w-16 h-16 rounded-full border border-outline-variant/60 flex items-center justify-center text-primary group-hover:border-secondary group-hover:text-secondary transition-all duration-500">
							<Icon name="lucide:cross" class="w-8 h-8" />
						</div>
					</div>
					<span class="font-label text-xs font-bold uppercase tracking-[0.25em] text-secondary mb-3 inline-block">Nuestra Misión</span>
					<h3 class="font-display text-2xl lg:text-3xl font-bold text-primary mb-6 leading-tight">
						Enviados para evangelizar
					</h3>
					<blockquote class="font-display text-lg lg:text-xl italic text-on-surface leading-relaxed border-l-2 border-secondary pl-6">
						"{siteConfig.mision}"
					</blockquote>
				</article>

				<!-- Visión -->
				<article class="group bg-surface-container-lowest p-10 lg:p-14 flex flex-col hover:bg-surface transition-colors duration-500 reveal stagger-1 h-full min-h-[420px]">
					<div class="flex items-start justify-between mb-8">
						<span class="font-display text-xs font-semibold text-secondary tracking-widest">02</span>
						<div class="w-16 h-16 rounded-full border border-outline-variant/60 flex items-center justify-center text-primary group-hover:border-secondary group-hover:text-secondary transition-all duration-500">
							<Icon name="lucide:church" class="w-8 h-8" />
						</div>
					</div>
					<span class="font-label text-xs font-bold uppercase tracking-[0.25em] text-secondary mb-3 inline-block">Nuestra Visión</span>
					<h3 class="font-display text-2xl lg:text-3xl font-bold text-primary mb-6 leading-tight">
						Comunidad evangelizadora
					</h3>
					<blockquote class="font-display text-lg lg:text-xl italic text-on-surface leading-relaxed border-l-2 border-secondary pl-6">
						"{siteConfig.vision}"
					</blockquote>
				</article>

			</div>

		</div>
	</section>

	<!-- Sectores (Bento Asimétrico) -->
	<section class="py-28 bg-surface border-y border-outline-variant/30">
		<div class="px-6 md:px-margin-desktop max-w-[1280px] mx-auto">

			<!-- Header editorial -->
			<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 mb-16 lg:mb-20 items-end reveal">
				<div class="lg:col-span-7">
					<div class="flex items-center gap-3 mb-6">
						<span class="h-px w-10 bg-secondary"></span>
						<span class="font-label text-xs font-bold uppercase tracking-[0.3em] text-secondary">Comunidad Extendida</span>
					</div>
					<h2 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold text-primary leading-[1.05] tracking-tight">
						Diez sectores,<br/>
						<span class="italic font-medium text-secondary">una sola fe</span>
					</h2>
				</div>
				<div class="lg:col-span-5 lg:pb-3">
					<p class="font-body text-base lg:text-lg text-on-surface-variant leading-relaxed">
						Cada sector es una comunidad viva, con carismas propios que enriquecen la fe compartida en Cristo Salvador.
					</p>
				</div>
			</div>

			<!-- Bento Grid -->
			<div class="grid grid-cols-2 md:grid-cols-12 gap-4 lg:gap-6 auto-rows-[200px]">

				<!-- Sede Parroquial — featured grande (8 cols x 3 rows) -->
				{sede && (
					<article class="group md:col-span-8 md:row-span-3 bg-surface-container-lowest border border-outline-variant/30 rounded-2xl overflow-hidden reveal hover:shadow-2xl hover:border-secondary/40 transition-all duration-700 flex flex-col">
						<div class="relative flex-1 overflow-hidden bg-surface-variant min-h-[200px]">
							<img
								src={sede.imagen}
								alt={sede.nombre}
								class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105"
								loading="lazy"
							/>
							<div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/20 to-transparent"></div>
							<div class="absolute top-4 left-4 bg-secondary text-on-secondary font-label text-[10px] font-bold uppercase tracking-[0.2em] px-3 py-1.5 rounded-full">
								Sede Parroquial
							</div>
						</div>
						<div class="p-6 lg:p-8">
							<div class="flex items-end justify-between gap-4 mb-3">
								<h3 class="font-display text-2xl lg:text-3xl font-bold text-primary leading-tight">{sede.nombre}</h3>
								<span class="font-display text-3xl lg:text-4xl font-bold text-secondary leading-none tracking-tighter">01</span>
							</div>
							<p class="font-body text-sm lg:text-base text-on-surface-variant leading-relaxed mb-3">{sede.descripcion}</p>
							<div class="flex items-center gap-2 font-label text-xs text-on-surface-variant">
								<Icon name="lucide:map-pin" class="w-3.5 h-3.5 text-secondary" />
								<span>Colonia Cerro Grande, Tegucigalpa</span>
							</div>
						</div>
					</article>
				)}

				<!-- 3 sectores compactos apilados a la derecha (4 cols) -->
				{sectoresRestantes.slice(0, 3).map((s, i) => (
					<article class="md:col-span-4 group bg-surface-container-lowest border border-outline-variant/30 rounded-2xl p-6 reveal hover:bg-surface hover:border-secondary/40 transition-all duration-500 flex flex-col justify-between">
						<div class="flex items-start justify-between mb-4">
							<span class="font-label text-[10px] font-bold uppercase tracking-[0.25em] text-secondary">Sector</span>
							<span class="font-display text-2xl font-bold text-outline-variant/60 group-hover:text-secondary transition-colors duration-500">{String(i + 2).padStart(2, '0')}</span>
						</div>
						<div>
							<h3 class="font-display text-lg font-bold text-on-surface group-hover:text-primary transition-colors duration-500 mb-2 leading-tight">{s.nombre}</h3>
							<p class="font-body text-xs text-on-surface-variant leading-relaxed">{s.descripcion}</p>
						</div>
					</article>
				))}

				<!-- 4 sectores medianos (3 cols cada uno, 1 fila) -->
				{sectoresRestantes.slice(3, 7).map((s, i) => (
					<article class="md:col-span-3 group bg-surface-container-lowest border border-outline-variant/30 rounded-2xl p-6 reveal hover:bg-surface hover:border-secondary/40 transition-all duration-500 flex flex-col justify-between">
						<div class="flex items-start justify-between mb-4">
							<span class="font-label text-[10px] font-bold uppercase tracking-[0.25em] text-secondary">Sector</span>
							<span class="font-display text-2xl font-bold text-outline-variant/60 group-hover:text-secondary transition-colors duration-500">{String(i + 5).padStart(2, '0')}</span>
						</div>
						<div>
							<h3 class="font-display text-base font-bold text-on-surface group-hover:text-primary transition-colors duration-500 mb-2 leading-tight">{s.nombre}</h3>
							<p class="font-body text-xs text-on-surface-variant leading-relaxed line-clamp-3">{s.descripcion}</p>
						</div>
					</article>
				))}

				<!-- 2 sectores amplios al final (6 cols cada uno) -->
				{sectoresRestantes.slice(7, 9).map((s, i) => (
					<article class="md:col-span-6 group bg-primary text-on-primary rounded-2xl p-6 lg:p-8 reveal hover:shadow-2xl transition-all duration-500 flex flex-col justify-between">
						<div class="flex items-start justify-between mb-4">
							<span class="font-label text-[10px] font-bold uppercase tracking-[0.25em] text-secondary-fixed">Sector</span>
							<span class="font-display text-2xl font-bold text-secondary-fixed">{String(i + 9).padStart(2, '0')}</span>
						</div>
						<div>
							<h3 class="font-display text-xl lg:text-2xl font-bold text-primary-fixed mb-3 leading-tight">{s.nombre}</h3>
							<p class="font-body text-sm text-on-primary/85 leading-relaxed">{s.descripcion}</p>
						</div>
					</article>
				))}

			</div>

			<!-- Footer de la sección -->
			<div class="mt-12 lg:mt-16 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 reveal">
				<p class="font-body text-sm text-on-surface-variant italic max-w-md">
					Diez comunidades, una parroquia: caminando juntos en la fe y la misión.
				</p>
				<a
					href="/oficina"
					class="inline-flex items-center gap-3 font-label text-xs font-bold uppercase tracking-[0.2em] text-primary hover:text-secondary transition-colors group"
				>
					Cómo llegar a la sede
					<Icon name="lucide:arrow-right" class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
				</a>
			</div>

		</div>
	</section>

	<!-- Grupos y Movimientos -->
	<section class="section-padding bg-surface-container-low">
		<div class="container-tight">
			<div class="text-center mb-12 lg:mb-16 reveal">
				<span class="text-xs font-bold uppercase tracking-[0.3em] text-primary mb-3 block font-label">Participación</span>
				<h2 class="font-display text-3xl lg:text-4xl font-bold text-on-background">Grupos y Movimientos</h2>
				<p class="font-body text-sm lg:text-base text-on-surface-variant mt-4 max-w-2xl mx-auto">
					La vitalidad de nuestra parroquia se manifiesta a través de sus diversos carismas y servicios.
				</p>
			</div>

			<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
				{grupos.map(g => (
					<div class="group bg-surface-container-lowest p-8 rounded-xl border border-outline-variant shadow-sm hover:shadow-lg hover:-translate-y-2 transition-all duration-500 reveal">
						<div class="w-14 h-14 rounded-2xl bg-primary-fixed flex items-center justify-center mb-6 group-hover:bg-primary group-hover:scale-110 transition-all duration-500">
							<Icon name={g.icono} class="w-7 h-7 text-on-primary-fixed-variant group-hover:text-on-primary transition-colors duration-500" />
						</div>
						<h3 class="font-display text-lg font-bold text-on-surface mb-3 group-hover:text-primary transition-colors">{g.nombre}</h3>
						<p class="font-body text-sm text-on-surface-variant leading-relaxed">
							{g.descripcion ?? `Un espacio de crecimiento espiritual y servicio comunitario bajo el carisma de ${g.nombre}.`}
						</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- CTA -->
	<section class="section-padding bg-primary">
		<div class="container-tight max-w-3xl text-center">
			<Icon name="mdi:church" class="w-12 h-12 lg:w-16 lg:h-16 text-on-primary mx-auto mb-6" />
			<h2 class="font-display text-2xl lg:text-3xl font-bold text-on-primary mb-4">¿Quieres visitarnos?</h2>
			<p class="font-body text-base lg:text-lg text-on-primary/90 mb-8">
				Te invitamos a conocer nuestra comunidad, participar en la Eucaristía y sumarte a los grupos pastorales que sostienen nuestra misión.
			</p>
			<div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
				<a
					href={whatsappLink('Hola, quisiera información sobre la parroquia')}
					target="_blank"
					class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-on-primary text-primary px-6 lg:px-8 py-3 lg:py-4 rounded-lg font-label text-sm font-semibold hover:bg-surface-container-low transition-all duration-300"
				>
					<Icon name="mdi:whatsapp" class="w-5 h-5" />
					Contactar por WhatsApp
				</a>
				<a
					href="/oficina"
					class="w-full sm:w-auto inline-flex items-center justify-center gap-2 border-2 border-on-primary text-on-primary px-6 lg:px-8 py-3 lg:py-4 rounded-lg font-label text-sm font-semibold hover:bg-white/10 transition-all duration-300"
				>
					Ver horarios de misa
				</a>
			</div>
		</div>
	</section>
</Layout>
