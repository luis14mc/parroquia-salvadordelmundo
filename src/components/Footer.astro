---
import { Icon } from 'astro-icon/components';

const socialLinks = [
	{ name: 'Facebook', icon: 'lucide:facebook', url: '#' },
	{ name: 'Instagram', icon: 'lucide:instagram', url: '#' },
	{ name: 'TikTok', icon: 'mdi:music-note', url: '#' },
];
---

<footer class="bg-slate-950 text-white">
	<div class="container-tight py-12 lg:py-16">
		<div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-12 mb-12 lg:mb-16">
			<!-- Logo & Descripción -->
			<div class="sm:col-span-2 space-y-4 lg:space-y-6">
				<img src="/logo_white.png" alt="Logo" class="h-20 lg:h-24 w-auto object-contain" />
				<p class="text-slate-400 leading-relaxed max-w-md text-xs lg:text-sm">
					"Salvados por Cristo, enviados al mundo". Una comunidad de fe viva comprometida con la evangelización y el servicio en Tegucigalpa.
				</p>
			</div>

			<!-- Contacto -->
			<div>
				<h4 class="font-bold text-white mb-4 lg:mb-6 text-sm lg:text-base">Contacto</h4>
				<ul class="space-y-2 lg:space-y-3 text-xs lg:text-sm">
					<li class="flex items-center gap-2 text-slate-400">
						<Icon name="lucide:phone" class="w-3 h-3 lg:w-4 lg:h-4 flex-shrink-0" />
						<span>2224-0263</span>
					</li>
					<li class="flex items-center gap-2 text-slate-400">
						<Icon name="mdi:whatsapp" class="w-3 h-3 lg:w-4 lg:h-4 flex-shrink-0" />
						<span>9534-5899</span>
					</li>
					<li class="flex items-start gap-2 text-slate-400">
						<Icon name="lucide:mail" class="w-3 h-3 lg:w-4 lg:h-4 flex-shrink-0 mt-0.5" />
						<span class="break-all">pelsalvadordelmundohn@gmail.com</span>
					</li>
				</ul>
			</div>

			<!-- Redes Sociales -->
			<div>
				<h4 class="font-bold text-white mb-4 lg:mb-6 text-sm lg:text-base">Síguenos</h4>
				<div class="flex gap-2 lg:gap-3">
					{socialLinks.map(social => (
						<a 
							href={social.url} 
							class="w-9 h-9 lg:w-10 lg:h-10 rounded-xl bg-white/5 hover:bg-primary flex items-center justify-center transition-colors duration-300"
							aria-label={social.name}
						>
							<Icon name={social.icon} class="w-4 h-4 lg:w-5 lg:h-5" />
						</a>
					))}
				</div>
			</div>
		</div>

		<!-- Bottom -->
		<div class="pt-6 lg:pt-8 border-t border-white/10 flex flex-col md:flex-row justify-between items-center gap-3 lg:gap-4 text-xs lg:text-sm text-slate-500">
			<p class="text-center md:text-left">&copy; {new Date().getFullYear()} Parroquia El Salvador del Mundo. Todos los derechos reservados.</p>
			<p>Tegucigalpa, Honduras</p>
		</div>
	</div>
</footer>
