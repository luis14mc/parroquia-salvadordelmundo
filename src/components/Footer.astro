---
import { Icon } from 'astro-icon/components';
import { siteConfig } from '../config/site';
import { mainNavigation } from '../config/navigation';
---

<footer class="bg-inverse-surface border-t border-primary/10 transition-all ease-in-out duration-200">
  <div class="flex flex-col items-center w-full py-16 px-6 md:px-margin-desktop max-w-[1280px] mx-auto space-y-8">
    <!-- Logo -->
    <a href="/" aria-label={`${siteConfig.name} — Ir al inicio`}>
      <img src="/logo_white.png" alt={siteConfig.name} class="h-logo-lg w-auto" />
    </a>

    <!-- Navigation Links -->
    <nav class="flex flex-wrap justify-center gap-x-8 gap-y-4" aria-label="Navegación del pie de página">
      {mainNavigation.map(item => (
        <a 
          href={item.href} 
          class="font-body text-sm font-medium text-surface-variant/80 hover:text-secondary-fixed transition-colors"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <!-- Social Icons -->
    <div class="flex gap-6 mt-4">
      {siteConfig.social.map(s => (
        <a 
          href={s.url} 
          class="text-surface-variant/80 hover:text-secondary-fixed transition-all duration-300 transform hover:scale-110 flex items-center justify-center" 
          aria-label={s.name}
        >
          <Icon name={s.icon} class="w-6 h-6" />
        </a>
      ))}
    </div>

    <!-- Contact & Copyright -->
    <div class="text-center font-body text-xs text-surface-variant/60 space-y-2">
      <p>
        Teléfono: <a href={siteConfig.contact.telefonoHref} class="hover:text-secondary-fixed transition-colors">{siteConfig.contact.telefonoDisplay}</a> 
        | Whatsapp: <a href={siteConfig.contact.whatsappHref} target="_blank" rel="noopener" class="hover:text-secondary-fixed transition-colors">{siteConfig.contact.whatsappDisplay}</a> 
        | Correo: <a href={`mailto:${siteConfig.contact.email}`} class="hover:text-secondary-fixed transition-colors">{siteConfig.contact.email}</a>
      </p>
      <p>
        &copy; {new Date().getFullYear()} {siteConfig.name}. Todos los derechos reservados.
      </p>
    </div>
  </div>
</footer>
