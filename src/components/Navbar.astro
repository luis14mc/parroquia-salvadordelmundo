---
---
<nav class="fixed top-0 w-full z-50 bg-white/95 backdrop-blur-md border-b border-slate-100 shadow-sm" id="navbar">
	<div class="container-tight">
		<div class="flex items-center justify-between h-20 lg:h-24">
			<!-- Logo -->
			<a href="/" class="flex items-center group">
				<img src="/logo_original.png" alt="Logo" class="h-16 lg:h-20 w-auto transition-all duration-300 group-hover:scale-105" />
			</a>
			
			<!-- Desktop Menu -->
			<div class="hidden lg:flex items-center gap-1">
				<a href="/" class="px-4 py-2 text-sm font-medium text-slate-700 hover:text-primary hover:bg-primary/5 rounded-lg transition-all duration-200">Inicio</a>
				<a href="/nosotros" class="px-4 py-2 text-sm font-medium text-slate-700 hover:text-primary hover:bg-primary/5 rounded-lg transition-all duration-200">Nosotros</a>
				<a href="/sacramentos" class="px-4 py-2 text-sm font-medium text-slate-700 hover:text-primary hover:bg-primary/5 rounded-lg transition-all duration-200">Sacramentos</a>
				<a href="/oficina" class="px-4 py-2 text-sm font-medium text-slate-700 hover:text-primary hover:bg-primary/5 rounded-lg transition-all duration-200">Oficina</a>
				<a href="/donaciones" class="ml-2 px-5 py-2 text-sm font-medium bg-primary text-white rounded-full hover:bg-primary/90 transition-all duration-200 shadow-sm">Donaciones</a>
			</div>

			<!-- Mobile Menu Button -->
			<button id="mobile-menu-btn" class="lg:hidden p-2 text-slate-700 hover:bg-slate-100 rounded-lg transition-colors">
				<svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
					<path d="M4 6h16M4 12h16M4 18h16"/>
				</svg>
			</button>
		</div>
	</div>
</nav>

<!-- Mobile Menu -->
<div id="mobile-menu" class="fixed inset-0 bg-white z-[60] lg:hidden translate-x-full transition-transform duration-300">
	<div class="flex flex-col h-full">
		<div class="flex items-center justify-between p-6 border-b border-slate-100">
			<img src="/logo_original.png" alt="Logo" class="h-12 w-auto" />
			<button id="close-menu" class="p-2 hover:bg-slate-100 rounded-lg transition-colors">
				<svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
					<path d="M6 18L18 6M6 6l12 12"/>
				</svg>
			</button>
		</div>
		<div class="flex-1 flex flex-col p-6 space-y-1">
			<a href="/" class="px-4 py-3 text-base font-medium text-slate-900 hover:text-primary hover:bg-slate-50 rounded-lg transition-colors">Inicio</a>
			<a href="/nosotros" class="px-4 py-3 text-base font-medium text-slate-900 hover:text-primary hover:bg-slate-50 rounded-lg transition-colors">Nosotros</a>
			<a href="/sacramentos" class="px-4 py-3 text-base font-medium text-slate-900 hover:text-primary hover:bg-slate-50 rounded-lg transition-colors">Sacramentos</a>
			<a href="/oficina" class="px-4 py-3 text-base font-medium text-slate-900 hover:text-primary hover:bg-slate-50 rounded-lg transition-colors">Oficina</a>
			<a href="/donaciones" class="mt-4 px-4 py-3 text-base font-medium bg-primary text-white rounded-lg text-center hover:bg-primary/90 transition-colors">Donaciones</a>
		</div>
	</div>
</div>

<script>
	function initNav() {
		const mobileMenu = document.getElementById('mobile-menu');
		const openBtn = document.getElementById('mobile-menu-btn');
		const closeBtn = document.getElementById('close-menu');

		// Mobile menu
		openBtn?.addEventListener('click', () => mobileMenu?.classList.remove('translate-x-full'));
		closeBtn?.addEventListener('click', () => mobileMenu?.classList.add('translate-x-full'));
		
		mobileMenu?.querySelectorAll('a').forEach(link => {
			link.addEventListener('click', () => mobileMenu?.classList.add('translate-x-full'));
		});
	}

	initNav();
	document.addEventListener('astro:after-swap', initNav);
</script>
