---
import { siteConfig } from '../config/site';
import { mainNavigation } from '../config/navigation';

const pathname = new URL(Astro.request.url).pathname;
const isActive = (href: string) => {
  if (href === '/') {
    return pathname === '/' || pathname === '';
  }
  return pathname.startsWith(href);
};
---
<nav class="w-full top-0 sticky z-50 bg-surface border-b border-outline-variant/30 transition-all ease-in-out duration-200" id="navbar" aria-label="Navegación principal">
  <div class="flex justify-between items-center w-full px-6 md:px-margin-desktop py-4 max-w-[1280px] mx-auto">
    <!-- Logo -->
    <a href="/" class="flex items-center group py-1" aria-label={`${siteConfig.shortName} — Ir al inicio`}>
      <span class="font-display text-xl md:text-2xl font-bold text-primary tracking-tight">{siteConfig.shortName}</span>
    </a>

    <!-- Desktop Menu -->
    <div class="hidden md:flex items-center space-x-8">
      {mainNavigation.map(item => (
        item.isCTA ? (
          <a 
            href={item.href} 
            class="bg-primary text-on-primary px-6 py-2 rounded-lg font-label text-xs font-semibold uppercase tracking-widest hover:bg-primary-container transition-all"
          >
            {item.label}
          </a>
        ) : (
          <a 
            href={item.href} 
            class={`font-label text-xs font-semibold uppercase tracking-widest pb-1 transition-all ${
              isActive(item.href) 
                ? 'text-primary border-b-2 border-secondary' 
                : 'text-on-surface-variant hover:text-primary'
            }`}
          >
            {item.label}
          </a>
        )
      ))}
    </div>

    <!-- Mobile Menu Toggle -->
    <button 
      id="mobile-menu-btn" 
      class="md:hidden text-primary p-2 flex items-center justify-center" 
      aria-expanded="false" 
      aria-controls="mobile-menu" 
      aria-label="Abrir menú de navegación"
    >
      <span class="material-symbols-outlined text-2xl">menu</span>
    </button>
  </div>
</nav>

<!-- Mobile Menu -->
<div id="mobile-menu" class="fixed inset-0 bg-surface z-[60] md:hidden translate-x-full transition-transform duration-300" role="dialog" aria-modal="true" aria-label="Menú de navegación">
  <div class="flex flex-col h-full">
    <div class="flex items-center justify-between px-6 py-5 border-b border-outline-variant/30">
      <span class="font-display text-xl font-bold text-primary">{siteConfig.shortName}</span>
      <button id="close-menu" class="p-2 text-primary flex items-center justify-center" aria-label="Cerrar menú de navegación">
        <span class="material-symbols-outlined text-2xl">close</span>
      </button>
    </div>
    <nav class="flex-1 flex flex-col py-6 px-6 space-y-6" aria-label="Menú móvil">
      {mainNavigation.map(item => (
        item.isCTA ? (
          <a 
            href={item.href} 
            class="bg-primary text-on-primary px-6 py-4 rounded-lg font-label text-sm font-semibold uppercase tracking-widest text-center mt-auto hover:bg-primary-container transition-colors"
          >
            {item.label}
          </a>
        ) : (
          <a 
            href={item.href} 
            class={`font-label text-base font-semibold uppercase tracking-widest pb-2 border-b border-outline-variant/10 ${
              isActive(item.href) 
                ? 'text-primary font-bold' 
                : 'text-on-surface-variant'
            }`}
          >
            {item.label}
          </a>
        )
      ))}
    </nav>
  </div>
</div>

<script>
  function initNav() {
    const mobileMenu = document.getElementById('mobile-menu');
    const openBtn = document.getElementById('mobile-menu-btn');
    const closeBtn = document.getElementById('close-menu');
    const nav = document.getElementById('navbar');

    function openMenu() {
      mobileMenu?.classList.remove('translate-x-full');
      openBtn?.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      closeBtn?.focus();
    }

    function closeMenu() {
      mobileMenu?.classList.add('translate-x-full');
      openBtn?.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      openBtn?.focus();
    }

    openBtn?.addEventListener('click', openMenu);
    closeBtn?.addEventListener('click', closeMenu);

    mobileMenu?.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', closeMenu);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !mobileMenu?.classList.contains('translate-x-full')) {
        closeMenu();
      }
    });

    // Scroll Navbar Effect
    window.addEventListener('scroll', () => {
      if (window.scrollY > 50) {
        nav?.classList.add('shadow-md', 'py-1');
        nav?.classList.remove('py-4');
      } else {
        nav?.classList.remove('shadow-md', 'py-1');
        nav?.classList.add('py-4');
      }
    });
  }

  initNav();
  document.addEventListener('astro:after-swap', initNav);
</script>
