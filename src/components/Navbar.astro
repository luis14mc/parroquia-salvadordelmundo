---
import { siteConfig } from '../config/site';
import { mainNavigation } from '../config/navigation';

const pathname = new URL(Astro.request.url).pathname;
const isActive = (href: string) => {
  if (href === '/') {
    return pathname === '/' || pathname === '';
  }
  return pathname.startsWith(href);
};

const navLinks = mainNavigation.filter(item => !item.isCTA);
const ctaItem = mainNavigation.find(item => item.isCTA);
---
<header class="w-full h-22 top-0 sticky z-50 bg-surface/95 backdrop-blur-sm border-b border-outline-variant/30 transition-all ease-in-out duration-200" id="navbar" aria-label="Navegación principal">
  <div class="flex justify-between items-center w-full h-full px-5 md:px-16 max-w-[1280px] mx-auto">
    <!-- Logo only -->
    <a href="/" class="shrink-0" aria-label={`${siteConfig.name} — Ir al inicio`}>
      <img src="/logo_original.png" alt="Logo Parroquia El Salvador del Mundo" class="h-26 w-auto" />
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden md:flex items-center gap-6 lg:gap-8" aria-label="Menú principal">
      {navLinks.map(item => (
        <a 
          href={item.href} 
          class={`text-[13px] leading-5 font-semibold uppercase tracking-[0.08em] pb-0.5 transition-all ease-in-out duration-200 whitespace-nowrap ${
            isActive(item.href) 
              ? 'text-primary border-b-2 border-secondary' 
              : 'text-on-surface-variant hover:text-primary'
          }`}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <!-- CTA Button + Mobile Toggle -->
    <div class="flex items-center gap-3 shrink-0">
      {ctaItem && (
        <a 
          href={ctaItem.href} 
          class="bg-primary text-on-primary px-5 py-1.5 rounded-lg text-[13px] leading-5 font-semibold uppercase tracking-wider hover:opacity-90 transition-all hidden md:inline-flex"
        >
          {ctaItem.label}
        </a>
      )}
      <button 
        id="mobile-menu-btn" 
        class="md:hidden text-primary p-1 flex items-center justify-center" 
        aria-expanded="false" 
        aria-controls="mobile-menu" 
        aria-label="Abrir menú de navegación"
      >
        <span class="material-symbols-outlined text-2xl">menu</span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Menu -->
<div id="mobile-menu" class="fixed inset-0 bg-surface z-[60] md:hidden translate-x-full transition-transform duration-300 ease-in-out" role="dialog" aria-modal="true" aria-label="Menú de navegación">
  <div class="flex flex-col h-full">
    <div class="flex items-center justify-between px-5 h-12 border-b border-outline-variant/30">
      <a href="/">
        <img src="/logo_original.png" alt="Logo Parroquia El Salvador del Mundo" class="h-8 w-auto" />
      </a>
      <button id="close-menu" class="p-1 text-primary flex items-center justify-center" aria-label="Cerrar menú de navegación">
        <span class="material-symbols-outlined text-2xl">close</span>
      </button>
    </div>
    <nav class="flex-1 flex flex-col py-8 px-5 space-y-5" aria-label="Menú móvil">
      {navLinks.map(item => (
        <a 
          href={item.href} 
          class={`text-[15px] font-semibold uppercase tracking-[0.08em] pb-2 border-b border-outline-variant/10 transition-colors ${
            isActive(item.href) 
              ? 'text-primary font-bold' 
              : 'text-on-surface-variant'
          }`}
        >
          {item.label}
        </a>
      ))}
      {ctaItem && (
        <a 
          href={ctaItem.href} 
          class="bg-primary text-on-primary px-6 py-3.5 rounded-lg text-sm font-semibold uppercase tracking-widest text-center mt-auto hover:bg-primary-container transition-colors"
        >
          {ctaItem.label}
        </a>
      )}
    </nav>
  </div>
</div>

<script>
  function initNav() {
    const mobileMenu = document.getElementById('mobile-menu');
    const openBtn = document.getElementById('mobile-menu-btn');
    const closeBtn = document.getElementById('close-menu');
    const navbar = document.getElementById('navbar');

    function openMenu() {
      mobileMenu?.classList.remove('translate-x-full');
      openBtn?.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      closeBtn?.focus();
    }

    function closeMenu() {
      mobileMenu?.classList.add('translate-x-full');
      openBtn?.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      openBtn?.focus();
    }

    openBtn?.addEventListener('click', openMenu);
    closeBtn?.addEventListener('click', closeMenu);

    mobileMenu?.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', closeMenu);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !mobileMenu?.classList.contains('translate-x-full')) {
        closeMenu();
      }
    });

    // Scroll — shadow only
    window.addEventListener('scroll', () => {
      if (window.scrollY > 50) {
        navbar?.classList.add('shadow-md');
      } else {
        navbar?.classList.remove('shadow-md');
      }
    });
  }

  initNav();
  document.addEventListener('astro:after-swap', initNav);
</script>
