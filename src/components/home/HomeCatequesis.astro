---
import { Icon } from 'astro-icon/components';
---

<section id="home-catequesis" class="border-y border-outline-variant/30 bg-surface-container-low py-12 lg:py-16">
	<div class="mx-auto max-w-[1280px] px-6 md:px-margin-desktop">
		<!-- Header compacto en una sola línea -->
		<div class="mb-6 flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between lg:gap-8 reveal">
			<div class="flex items-center gap-4">
				<div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-outline-variant/60 text-secondary">
					<Icon name="lucide:book-open-check" class="h-6 w-6" />
				</div>
				<div>
					<span class="font-label text-[10px] font-bold uppercase tracking-[0.25em] text-secondary">Formación en la fe</span>
					<h2 class="font-display text-2xl font-bold leading-tight text-primary md:text-3xl">
						Catequesis <span class="italic font-medium text-secondary">&nbsp;y formación</span>
					</h2>
				</div>
			</div>
			<a href="/catequesis" class="inline-flex items-center gap-2 self-start font-label text-xs font-bold uppercase tracking-[0.2em] text-primary hover:text-secondary transition-colors group lg:self-end">
				Ver todo
				<Icon name="lucide:arrow-right" class="h-4 w-4 transition-transform group-hover:translate-x-1" />
			</a>
		</div>

		<!-- Bento: 2 cards compactas -->
		<div class="grid grid-cols-1 gap-px bg-outline-variant/30 border border-outline-variant/30 rounded-xl overflow-hidden lg:grid-cols-2">
			<!-- Inscripciones de Catequesis (dark) -->
			<article class="group bg-primary p-6 text-on-primary md:p-8 reveal">
				<div class="flex items-center justify-between gap-3 mb-4">
					<div class="flex h-10 w-10 items-center justify-center rounded-full border border-on-primary/25 text-secondary-fixed">
						<Icon name="lucide:book-open-check" class="h-5 w-5" />
					</div>
					<span class="rounded-full bg-secondary-fixed px-2.5 py-0.5 font-label text-[10px] font-bold uppercase tracking-[0.18em] text-on-secondary-fixed">Inscripciones</span>
				</div>
				<h3 class="font-display text-xl font-bold text-primary-fixed leading-tight md:text-2xl">Inscripciones de Catequesis</h3>
				<p class="mt-2 font-body text-sm leading-relaxed text-on-primary/80">
					Catequesis para adultos, Primera Comunión y Confirmación.
				</p>
				<div class="mt-4 flex flex-wrap gap-1.5">
					<span class="rounded-full border border-on-primary/20 px-2.5 py-1 font-body text-[11px] text-primary-fixed">Adultos +18</span>
					<span class="rounded-full border border-on-primary/20 px-2.5 py-1 font-body text-[11px] text-primary-fixed">1.ª Comunión</span>
					<span class="rounded-full border border-on-primary/20 px-2.5 py-1 font-body text-[11px] text-primary-fixed">Confirmación +15</span>
				</div>
				<a href="/catequesis" class="mt-5 inline-flex w-fit items-center gap-2 rounded-lg bg-surface-container-lowest px-4 py-2 font-label text-[11px] font-bold uppercase tracking-widest text-primary transition-all group-hover:gap-3">
					Inscribirme
					<Icon name="lucide:arrow-right" class="h-3.5 w-3.5" />
				</a>
			</article>

			<!-- Catequesis Matrimonial (light) -->
			<article class="group bg-surface-container-lowest p-6 md:p-8 reveal stagger-1">
				<div class="flex items-center justify-between gap-3 mb-4">
					<div class="flex h-10 w-10 items-center justify-center rounded-full bg-secondary-fixed/30 text-secondary">
						<Icon name="lucide:calendar-days" class="h-5 w-5" />
					</div>
					<span class="rounded-full bg-secondary-fixed/30 px-2.5 py-0.5 font-label text-[10px] font-bold uppercase tracking-[0.18em] text-secondary">2026</span>
				</div>
				<h3 class="font-display text-xl font-bold text-primary leading-tight md:text-2xl">Catequesis Matrimonial</h3>
				<p class="mt-2 font-body text-sm leading-relaxed text-on-surface-variant">
					Preparación al sacramento del Matrimonio para parejas.
				</p>
				<div class="mt-4 flex items-center gap-3 rounded-lg border border-secondary/20 bg-secondary-fixed/15 p-3">
					<div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-md bg-secondary text-on-secondary">
						<Icon name="lucide:calendar-check-2" class="h-4 w-4" />
					</div>
					<div class="min-w-0">
						<p class="font-label text-[9px] font-bold uppercase tracking-[0.18em] text-secondary leading-tight">Cuarta catequesis</p>
						<p class="font-display text-sm font-bold text-primary leading-tight">14–15 y 21–22 nov</p>
					</div>
				</div>
				<a href="/catequesis/matrimonio" class="mt-4 inline-flex items-center gap-2 font-label text-[11px] font-bold uppercase tracking-[0.18em] text-primary transition-colors hover:text-secondary">
					Ver calendario
					<Icon name="lucide:arrow-right" class="h-3.5 w-3.5 transition-transform group-hover:translate-x-1" />
				</a>
			</article>
		</div>
	</div>
</section>
