---
interface Props {
	nombre: string;
	cargo: string;
	descripcion: string;
	imagen: string;
}

const { nombre, cargo, descripcion, imagen } = Astro.props;
---

<div class="group">
	<!-- Imagen — sin border-radius, cruda -->
	<div class="aspect-[3/4] overflow-hidden mb-4 bg-surface-container relative">
		<img
			src={imagen}
			alt={nombre}
			loading="lazy"
			decoding="async"
			class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-700"
		/>
	</div>

	<!-- Texto -->
	<div class="space-y-1">
		<span class="font-label text-[10px] font-bold uppercase tracking-[0.2em] text-primary block">{cargo}</span>
		<h3 class="font-display text-xl font-bold text-on-surface leading-tight">{nombre}</h3>
		<p class="font-body text-sm text-on-surface-variant leading-relaxed">
			{descripcion}
		</p>
	</div>
</div>
