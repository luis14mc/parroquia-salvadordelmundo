---
interface Props {
	title: string;
	subtitle?: string;
	image?: string;
}

const {
	title,
	subtitle,
	image = "/img/institucionales/templo-sede.webp"
} = Astro.props;
---

<header class="relative w-full h-[400px] flex items-center overflow-hidden bg-primary hero-clip">
	<div class="absolute inset-0 opacity-40 mix-blend-overlay">
		<img
			src={image}
			alt=""
			class="w-full h-full object-cover"
		/>
	</div>
	<div class="relative w-full px-6 md:px-margin-desktop max-w-[1280px] mx-auto text-on-primary">
		<div class="max-w-2xl reveal">
			<span class="font-label text-xs font-bold uppercase tracking-[0.2em] text-secondary-fixed mb-2 block">
				Parroquia El Salvador del Mundo
			</span>
			<h1 class="font-display text-4xl sm:text-5xl font-bold mb-4">{title}</h1>
			{subtitle && (
				<p class="font-body text-base sm:text-lg text-primary-fixed opacity-90 leading-relaxed">
					{subtitle}
				</p>
			)}
		</div>
	</div>
</header>
