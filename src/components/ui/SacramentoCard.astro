---
import { Icon } from 'astro-icon/components';

interface Props {
	nombre: string;
	requisitos: string[];
	dias?: string;
	ofrenda?: string;
	contacto?: string;
}

const { nombre, requisitos, dias, ofrenda, contacto } = Astro.props;

const iconMap: Record<string, string> = {
	"Bautismo": "lucide:droplets",
	"Primera Comunión": "lucide:wheat",
	"Confirmación": "lucide:flame",
	"Matrimonio": "lucide:heart",
	"Unción de los Enfermos": "lucide:cross"
};

const iconName = iconMap[nombre] || "lucide:scroll-text";
---

<article class="border-2 border-on-surface p-6 lg:p-8 bg-surface hover:bg-on-surface hover:text-on-surface group transition-colors">
	<!-- Header -->
	<div class="flex items-center gap-4 mb-6 pb-6 border-b border-on-surface/10 group-hover:border-on-surface/20">
		<Icon name={iconName} class="w-8 h-8 text-primary group-hover:text-primary" />
		<h3 class="font-display text-2xl font-bold">{nombre}</h3>
	</div>

	<!-- Requisitos -->
	<div class="space-y-3 mb-6">
		{requisitos.map(r => (
			<div class="flex items-start gap-3">
				<Icon name="lucide:check" class="w-4 h-4 text-primary mt-0.5 flex-shrink-0" />
				<p class="font-body text-sm leading-relaxed opacity-80">{r}</p>
			</div>
		))}
	</div>

	<!-- Info adicional -->
	{(dias || ofrenda || contacto) && (
		<div class="pt-6 border-t border-on-surface/10 space-y-2 text-sm">
			{dias && (
				<div class="flex items-center gap-2 opacity-70">
					<Icon name="lucide:calendar" class="w-4 h-4" />
					<span>{dias}</span>
				</div>
			)}
			{ofrenda && (
				<div class="flex items-center gap-2 opacity-70">
					<Icon name="lucide:banknote" class="w-4 h-4" />
					<span>Ofrenda: {ofrenda}</span>
				</div>
			)}
			{contacto && (
				<div class="flex items-center gap-2 text-primary font-bold">
					<Icon name="mdi:whatsapp" class="w-4 h-4" />
					<span>{contacto}</span>
				</div>
			)}
		</div>
	)}
</article>
