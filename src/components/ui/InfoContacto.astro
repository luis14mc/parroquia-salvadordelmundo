---
import { Icon } from 'astro-icon/components';

const info = {
	tel: "2224-0263",
	whatsapp: "9534-5899",
	email: "pelsalvadordelmundohn@gmail.com",
	direccion: "Colonia Cerro Grande Zona 4, calle principal, Comayagüela"
};
---

<section class="section-padding bg-white">
	<div class="container-tight">
		<div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
			<!-- Info -->
			<div class="space-y-6 lg:space-y-8">
				<div>
					<span class="text-xs font-bold uppercase tracking-[0.3em] text-primary mb-4 block">Ubicación</span>
					<h2 class="text-3xl lg:text-4xl font-bold text-slate-900 mb-4 lg:mb-6">Visítanos</h2>
					<p class="text-sm lg:text-base text-slate-600 leading-relaxed">
						Estamos ubicados en el corazón de Tegucigalpa, listos para servirte y acompañarte en tu camino de fe.
					</p>
				</div>

				<div class="space-y-4 lg:space-y-6">
					<div class="flex items-start gap-3 lg:gap-4">
						<div class="w-10 h-10 lg:w-12 lg:h-12 rounded-xl lg:rounded-2xl bg-primary/5 flex items-center justify-center flex-shrink-0">
							<Icon name="lucide:map-pin" class="w-4 h-4 lg:w-5 lg:h-5 text-primary" />
						</div>
						<div>
							<h4 class="font-bold text-sm lg:text-base text-slate-900 mb-1">Dirección</h4>
							<p class="text-slate-600 text-xs lg:text-sm">{info.direccion}</p>
						</div>
					</div>

					<div class="flex items-start gap-3 lg:gap-4">
						<div class="w-10 h-10 lg:w-12 lg:h-12 rounded-xl lg:rounded-2xl bg-primary/5 flex items-center justify-center flex-shrink-0">
							<Icon name="lucide:phone" class="w-4 h-4 lg:w-5 lg:h-5 text-primary" />
						</div>
						<div>
							<h4 class="font-bold text-sm lg:text-base text-slate-900 mb-1">Contacto</h4>
							<p class="text-slate-600 text-xs lg:text-sm">Tel: {info.tel}</p>
							<p class="text-slate-600 text-xs lg:text-sm">WhatsApp: {info.whatsapp}</p>
							<p class="text-slate-600 text-xs lg:text-sm break-all">{info.email}</p>
						</div>
					</div>
				</div>
			</div>

			<!-- Mapa -->
			<div class="aspect-square rounded-2xl lg:rounded-3xl overflow-hidden shadow-xl border border-slate-100">
				<iframe 
					src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3869.8!2d-87.2206!3d14.1219!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8f6fa2e555555555%3A0x0!2zMTTCsDA3JzE5LjAiTiA4N8KwMTMnMTQuMyJX!5e0!3m2!1ses!2shn!4v1234567890" 
					width="100%" 
					height="100%" 
					style="border:0;" 
					allowfullscreen="" 
					loading="lazy"
					title="Mapa"
				></iframe>
			</div>
		</div>
	</div>
</section>
