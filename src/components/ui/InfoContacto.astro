---
import { Icon } from 'astro-icon/components';
import MapaInteractivo from './MapaInteractivo.astro';
import { siteConfig } from '../../config/site';

const { contact, address } = siteConfig;
---

<section class="section-padding bg-surface border-t-2 border-outline">
	<div class="container-tight">
		<!-- Header -->
		<div class="mb-12 lg:mb-16 reveal">
			<span class="font-label text-xs font-bold uppercase tracking-[0.2em] text-primary block mb-3">Ubicación</span>
			<h2 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold text-on-background leading-[0.9]">
				Visítanos
			</h2>
		</div>

		<!-- Grid de 2 columnas -->
		<div class="grid lg:grid-cols-2 gap-0 border-2 border-outline">
			<!-- Info -->
			<div class="p-8 lg:p-12 border-b lg:border-b-0 lg:border-r-2 border-outline reveal stagger-1">
				<div class="space-y-6">
					<div class="flex items-start gap-4">
						<Icon name="lucide:map-pin" class="w-5 h-5 text-primary mt-0.5 flex-shrink-0" />
						<div>
							<h4 class="font-label text-xs font-bold uppercase tracking-[0.15em] text-on-surface-variant mb-1">Dirección</h4>
							<p class="font-body text-sm text-on-surface">{address.street}, {address.locality}</p>
						</div>
					</div>

					<div class="flex items-start gap-4">
						<Icon name="lucide:phone" class="w-5 h-5 text-primary mt-0.5 flex-shrink-0" />
						<div>
							<h4 class="font-label text-xs font-bold uppercase tracking-[0.15em] text-on-surface-variant mb-1">Teléfono</h4>
							<a href={contact.telefonoHref} class="font-body text-sm text-on-surface hover:text-primary transition-colors">{contact.telefonoDisplay}</a>
						</div>
					</div>

					<div class="flex items-start gap-4">
						<Icon name="mdi:whatsapp" class="w-5 h-5 text-primary mt-0.5 flex-shrink-0" />
						<div>
							<h4 class="font-label text-xs font-bold uppercase tracking-[0.15em] text-on-surface-variant mb-1">WhatsApp</h4>
							<a href={contact.whatsappHref} target="_blank" rel="noopener" class="font-body text-sm text-on-surface hover:text-primary transition-colors">{contact.whatsappDisplay}</a>
						</div>
					</div>

					<div class="flex items-start gap-4">
						<Icon name="lucide:mail" class="w-5 h-5 text-primary mt-0.5 flex-shrink-0" />
						<div>
							<h4 class="font-label text-xs font-bold uppercase tracking-[0.15em] text-on-surface-variant mb-1">Correo</h4>
							<a href={`mailto:${contact.email}`} class="font-body text-sm text-on-surface break-all hover:text-primary transition-colors">{contact.email}</a>
						</div>
					</div>
				</div>

<!-- Botones -->
			<div class="flex gap-0 mt-8 border-t-2 border-outline">
				<a href={address.googleMapsUrl} target="_blank" class="flex-1 flex items-center justify-center gap-2 px-4 py-3 bg-primary text-on-primary font-label text-xs font-bold uppercase tracking-wider hover:bg-primary-container transition-colors">
					Google Maps
				</a>
				<a href={address.wazeUrl} target="_blank" class="flex-1 flex items-center justify-center gap-2 px-4 py-3 border-l-2 border-outline text-on-surface font-label text-xs font-bold uppercase tracking-wider hover:bg-inverse-surface hover:text-inverse-on-surface transition-colors">
					Waze
				</a>
			</div>
			</div>

			<!-- Mapa -->
			<div class="reveal stagger-2">
				<div class="h-[400px] lg:h-full min-h-[400px]">
					<MapaInteractivo />
				</div>
			</div>
		</div>
	</div>
</section>
