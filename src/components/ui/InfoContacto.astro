---
import { Icon } from 'astro-icon/components';
import MapaInteractivo from './MapaInteractivo.astro';

const info = {
	tel: "2224-0263",
	whatsapp: "9534-5899",
	email: "pelsalvadordelmundohn@gmail.com",
	direccion: "Colonia Cerro Grande Zona 4, calle principal, Comayagüela"
};
---

<section class="section-padding bg-white">
	<div class="container-tight">
		<div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
			<!-- Info -->
			<div class="space-y-6 lg:space-y-8">
				<div>
					<span class="text-xs font-bold uppercase tracking-[0.3em] text-primary mb-4 block">Ubicación</span>
					<h2 class="text-3xl lg:text-4xl font-bold text-slate-900 mb-4 lg:mb-6">Visítanos</h2>
					<p class="text-sm lg:text-base text-slate-600 leading-relaxed">
						Estamos ubicados en el corazón de Tegucigalpa, listos para servirte y acompañarte en tu camino de fe.
					</p>
				</div>

				<div class="space-y-4 lg:space-y-6">
					<div class="flex items-start gap-3 lg:gap-4">
						<div class="w-10 h-10 lg:w-12 lg:h-12 rounded-xl lg:rounded-2xl bg-primary/5 flex items-center justify-center flex-shrink-0">
							<Icon name="lucide:map-pin" class="w-4 h-4 lg:w-5 lg:h-5 text-primary" />
						</div>
						<div>
							<h4 class="font-bold text-sm lg:text-base text-slate-900 mb-1">Dirección</h4>
							<p class="text-slate-600 text-xs lg:text-sm">{info.direccion}</p>
						</div>
					</div>

					<div class="flex items-start gap-3 lg:gap-4">
						<div class="w-10 h-10 lg:w-12 lg:h-12 rounded-xl lg:rounded-2xl bg-primary/5 flex items-center justify-center flex-shrink-0">
							<Icon name="lucide:phone" class="w-4 h-4 lg:w-5 lg:h-5 text-primary" />
						</div>
						<div>
							<h4 class="font-bold text-sm lg:text-base text-slate-900 mb-1">Contacto</h4>
							<p class="text-slate-600 text-xs lg:text-sm">Tel: {info.tel}</p>
							<p class="text-slate-600 text-xs lg:text-sm">WhatsApp: {info.whatsapp}</p>
							<p class="text-slate-600 text-xs lg:text-sm break-all">{info.email}</p>
						</div>
					</div>
				</div>
			</div>

			<!-- Mapa -->
			<div class="space-y-4">
				<div class="h-[300px] lg:h-[400px] rounded-2xl overflow-hidden shadow-xl border border-slate-100">
					<MapaInteractivo />
				</div>
				
				<!-- Botones de navegación -->
				<div class="grid grid-cols-2 gap-3">
					<a 
						href="https://www.google.com/maps/dir/?api=1&destination=14.1219,-87.2206" 
						target="_blank"
						class="flex items-center justify-center gap-2 px-4 py-3 bg-primary text-white rounded-xl font-medium hover:bg-primary/90 transition-all duration-200 text-sm"
					>
						<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
							<path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
						</svg>
						Google Maps
					</a>
					<a 
						href="https://waze.com/ul?ll=14.1219,-87.2206&navigate=yes" 
						target="_blank"
						class="flex items-center justify-center gap-2 px-4 py-3 rounded-xl font-medium transition-all duration-200 text-sm border-2 border-primary text-primary hover:bg-primary/5"
					>
						<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
							<path d="M12 2L4.5 20.29l.71.71L12 18l6.79 3 .71-.71z"/>
						</svg>
						Waze
					</a>
				</div>
			</div>
		</div>
	</div>
</section>
