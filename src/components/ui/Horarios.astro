---
import { Icon } from 'astro-icon/components';

const eucaristia = [
	{ day: "Lunes - Viernes", time: "7:00 PM" },
	{ day: "Sábados", time: "7:00 AM" },
	{ day: "Domingos", time: "9:00 AM | 11:00 AM | 5:30 PM" },
];

const confesiones = "Lunes, martes, miércoles y viernes después de misa de 7:00 PM. Jueves a las 6:00 PM y domingo a las 11:00 AM.";
---

<section id="horarios" class="section-padding bg-slate-50">
	<div class="container-tight">
		<div class="grid lg:grid-cols-5 gap-12 lg:gap-16 items-start">
			<!-- Header -->
			<div class="lg:col-span-2 lg:sticky lg:top-32">
				<span class="text-xs font-bold uppercase tracking-[0.3em] text-primary mb-4 block">Comunidad</span>
				<h2 class="text-3xl lg:text-4xl xl:text-5xl font-bold text-slate-900 mb-4 lg:mb-6 leading-tight">
					Celebramos juntos
				</h2>
				<p class="text-sm lg:text-base text-slate-600 leading-relaxed">
					Únete a nuestra comunidad en la celebración de la Eucaristía y la Reconciliación.
				</p>
			</div>

			<!-- Content -->
			<div class="lg:col-span-3 space-y-6 lg:space-y-8">
				<!-- Eucaristía -->
				<div class="bg-white rounded-2xl lg:rounded-3xl p-6 lg:p-8 xl:p-10 shadow-sm border border-slate-100">
					<div class="flex items-center gap-3 mb-6 lg:mb-8">
						<div class="w-10 h-10 lg:w-12 lg:h-12 rounded-xl lg:rounded-2xl bg-primary/5 flex items-center justify-center">
							<Icon name="lucide:cross" class="w-5 h-5 lg:w-6 lg:h-6 text-primary" />
						</div>
						<h3 class="text-lg lg:text-xl font-bold text-slate-900">Eucaristía</h3>
					</div>
					
					<div class="space-y-3 lg:space-y-4">
						{eucaristia.map((item, index) => (
							<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between py-3 lg:py-4 border-b border-slate-100 last:border-0 gap-2 sm:gap-4">
								<span class="text-sm lg:text-base text-slate-600 font-medium">{item.day}</span>
								<span class="text-base lg:text-lg text-slate-900 font-bold">{item.time}</span>
							</div>
						))}
					</div>
				</div>

				<!-- Confesiones -->
				<div class="bg-gradient-to-br from-primary to-primary/90 rounded-2xl lg:rounded-3xl p-6 lg:p-8 xl:p-10 text-white">
					<div class="flex items-center gap-3 mb-4 lg:mb-6">
						<div class="w-10 h-10 lg:w-12 lg:h-12 rounded-xl lg:rounded-2xl bg-white/10 flex items-center justify-center">
							<Icon name="lucide:heart" class="w-5 h-5 lg:w-6 lg:h-6 text-white" />
						</div>
						<h3 class="text-lg lg:text-xl font-bold">Reconciliación</h3>
					</div>
					
					<p class="text-sm lg:text-base text-white/90 leading-relaxed">
						{confesiones}
					</p>
				</div>
			</div>
		</div>
	</div>
</section>
