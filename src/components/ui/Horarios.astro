---
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';

const allHorarios = await getCollection('horarios');
const eucaristiaData = allHorarios.find(h => h.data.tipo === 'eucaristia');
const confesionData = allHorarios.find(h => h.data.tipo === 'confesion');

const eucaristia = eucaristiaData?.data.items ?? [];
const confesionItems = confesionData?.data.items ?? [];
---

<section id="horarios" class="section-padding bg-surface">
	<div class="container-tight">
		<!-- Header -->
		<div class="mb-12 lg:mb-16 reveal">
			<span class="font-label text-xs font-bold uppercase tracking-[0.2em] text-primary block mb-3">Comunidad</span>
			<h2 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold text-on-background leading-[0.9]">
				Celebramos<br/>juntos
			</h2>
		</div>

		<!-- Grid de 2 columnas -->
		<div class="grid md:grid-cols-2 gap-0 border-2 border-outline">
			<!-- Eucaristía -->
			<div class="p-8 lg:p-12 border-b md:border-b-0 md:border-r-2 border-outline reveal stagger-1">
				<div class="flex items-center gap-3 mb-8">
					<Icon name="lucide:cross" class="w-6 h-6 text-primary" />
					<h3 class="font-display text-2xl font-bold">Eucaristía</h3>
				</div>

				<div class="space-y-0">
					{eucaristia.map((item, i) => (
						<div class={`flex flex-col sm:flex-row sm:items-baseline sm:justify-between py-4 gap-1 ${i < eucaristia.length - 1 ? 'border-b border-outline-variant/40' : ''}`}>
							<span class="font-body text-sm text-on-surface-variant">{item.dias}</span>
							<span class="font-display text-xl font-bold text-primary">{item.horas}</span>
						</div>
					))}
				</div>
			</div>

			<!-- Confesiones -->
			<div class="p-8 lg:p-12 bg-inverse-surface text-inverse-on-surface reveal stagger-2">
				<div class="flex items-center gap-3 mb-8">
					<Icon name="lucide:heart" class="w-6 h-6 text-secondary-fixed" />
					<h3 class="font-display text-2xl font-bold">Reconciliación</h3>
				</div>

				<div class="font-body text-sm text-inverse-on-surface/70 leading-relaxed">
					{confesionItems.map((item, i) => (
						<>{item.dias}: {item.horas}{i < confesionItems.length - 1 ? '. ' : '.'}</>
					))}
					{confesionData?.data.nota && <> {confesionData.data.nota}.</>}
				</div>
			</div>
		</div>
	</div>
</section>
