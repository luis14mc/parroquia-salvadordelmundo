---
// Coordenadas de la Parroquia El Salvador del Mundo
const lat = 14.1219;
const lng = -87.2206;
---

<div class="relative w-full h-full">
	<div id="map" class="w-full h-full"></div>

	<!-- Botones de acción flotantes -->
	<div class="absolute top-4 right-4 z-[400] flex flex-col gap-2">
		<a
			href={`https://www.google.com/maps/dir/?api=1&destination=${lat},${lng}`}
			target="_blank"
			rel="noopener"
			aria-label="Abrir en Google Maps"
			class="group flex items-center gap-3 bg-primary text-on-primary pl-3 pr-4 py-2.5 rounded-xl font-label text-xs font-bold uppercase tracking-widest shadow-lg hover:bg-primary-container hover:text-primary transition-all duration-300"
		>
			<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" class="flex-shrink-0">
				<path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
			</svg>
			<span>Maps</span>
		</a>
		<a
			href={`https://waze.com/ul?ll=${lat},${lng}&navigate=yes`}
			target="_blank"
			rel="noopener"
			aria-label="Abrir en Waze"
			class="group flex items-center gap-3 bg-[#33CCFF] text-white pl-3 pr-4 py-2.5 rounded-xl font-label text-xs font-bold uppercase tracking-widest shadow-lg hover:bg-[#1AB7E8] transition-all duration-300"
		>
			<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" class="flex-shrink-0">
				<path d="M12 2L4.5 20.29l.71.71L12 18l6.79 3 .71-.71z"/>
			</svg>
			<span>Waze</span>
		</a>
	</div>
</div>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<script>
	import L from 'leaflet';

	function initMap() {
		// Verificar si el mapa ya existe
		const mapContainer = document.getElementById('map');
		if (!mapContainer || mapContainer.classList.contains('leaflet-container')) {
			return;
		}

		// Crear el mapa
		const map = L.map('map', {
			center: [14.1219, -87.2206],
			zoom: 16,
			zoomControl: true,
			scrollWheelZoom: false
		});

		// Estilo de mapa suave y elegante
		L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
			attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>',
			subdomains: 'abcd',
			maxZoom: 20
		}).addTo(map);

		// Icono personalizado con colores de la parroquia
		const customIcon = L.divIcon({
			className: 'custom-marker',
			html: `
				<div style="
					position: relative;
					width: 50px;
					height: 50px;
				">
					<!-- Glow effect -->
					<div style="
						position: absolute;
						width: 50px;
						height: 50px;
						background: radial-gradient(circle, rgba(132, 20, 67, 0.3) 0%, transparent 70%);
						border-radius: 50%;
						animation: pulse 2s ease-in-out infinite;
					"></div>
					<!-- Main pin -->
					<div style="
						position: absolute;
						top: 5px;
						left: 5px;
						background: linear-gradient(135deg, #841443 0%, #f9cb33 100%);
						width: 40px;
						height: 40px;
						border-radius: 50% 50% 50% 0;
						transform: rotate(-45deg);
						border: 3px solid white;
						box-shadow: 0 6px 20px rgba(132, 20, 67, 0.5), 0 2px 8px rgba(0,0,0,0.1);
						display: flex;
						align-items: center;
						justify-content: center;
					">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="white" style="transform: rotate(45deg)">
							<path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
						</svg>
					</div>
				</div>
			`,
			iconSize: [50, 50],
			iconAnchor: [25, 50],
			popupAnchor: [0, -50]
		});

		// Agregar marcador
		const marker = L.marker([14.1219, -87.2206], { icon: customIcon }).addTo(map);

		// Ajustar el mapa cuando cambia el tamaño
		window.addEventListener('resize', () => {
			map.invalidateSize();
		});
	}

	// Inicializar cuando el DOM está listo
	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initMap);
	} else {
		initMap();
	}

	// Reinicializar en navegación de Astro
	document.addEventListener('astro:after-swap', initMap);
</script>

<style>
	#map {
		border-radius: inherit;
	}

	:global(.leaflet-container) {
		font-family: 'Montserrat', system-ui, sans-serif;
	}

	:global(.custom-marker) {
		background: transparent !important;
		border: none !important;
	}

	@keyframes pulse {
		0%, 100% {
			transform: scale(1);
			opacity: 0.8;
		}
		50% {
			transform: scale(1.15);
			opacity: 0.4;
		}
	}

	:global(.leaflet-control-zoom) {
		border: none !important;
		box-shadow: 0 4px 12px rgba(132, 20, 67, 0.1) !important;
		border-radius: 10px !important;
		overflow: hidden;
	}

	:global(.leaflet-control-zoom a) {
		width: 36px !important;
		height: 36px !important;
		line-height: 36px !important;
		color: #841443 !important;
		border: none !important;
		background: white !important;
		transition: all 0.2s;
		font-size: 18px !important;
		font-weight: 600 !important;
	}

	:global(.leaflet-control-zoom a:hover) {
		background: #f8fafc !important;
		color: #841443 !important;
	}

	:global(.leaflet-control-zoom a:first-child) {
		border-bottom: 1px solid #e2e8f0 !important;
	}

	:global(.leaflet-control-attribution) {
		background: rgba(255, 255, 255, 0.9) !important;
		backdrop-filter: blur(8px);
		color: #64748b !important;
		border-radius: 6px !important;
		padding: 3px 6px !important;
		font-size: 9px !important;
	}

	:global(.leaflet-control-attribution a) {
		color: #841443 !important;
	}
</style>