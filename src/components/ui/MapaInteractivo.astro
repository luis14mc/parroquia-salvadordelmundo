---
// Coordenadas de la Parroquia El Salvador del Mundo
const lat = 14.1219;
const lng = -87.2206;
---

<div id="map" class="w-full h-full"></div>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<script>
	import L from 'leaflet';

	function initMap() {
		// Verificar si el mapa ya existe
		const mapContainer = document.getElementById('map');
		if (!mapContainer || mapContainer.classList.contains('leaflet-container')) {
			return;
		}

		// Crear el mapa
		const map = L.map('map', {
			center: [14.1219, -87.2206],
			zoom: 16,
			zoomControl: true,
			scrollWheelZoom: false
		});

		// Estilo de mapa suave y elegante
		L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
			attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>',
			subdomains: 'abcd',
			maxZoom: 20
		}).addTo(map);

		// Icono personalizado con colores de la parroquia
		const customIcon = L.divIcon({
			className: 'custom-marker',
			html: `
				<div style="
					position: relative;
					width: 50px;
					height: 50px;
				">
					<!-- Glow effect -->
					<div style="
						position: absolute;
						width: 50px;
						height: 50px;
						background: radial-gradient(circle, rgba(132, 20, 67, 0.3) 0%, transparent 70%);
						border-radius: 50%;
						animation: pulse 2s ease-in-out infinite;
					"></div>
					<!-- Main pin -->
					<div style="
						position: absolute;
						top: 5px;
						left: 5px;
						background: linear-gradient(135deg, #841443 0%, #f9cb33 100%);
						width: 40px;
						height: 40px;
						border-radius: 50% 50% 50% 0;
						transform: rotate(-45deg);
						border: 3px solid white;
						box-shadow: 0 6px 20px rgba(132, 20, 67, 0.5), 0 2px 8px rgba(0,0,0,0.1);
						display: flex;
						align-items: center;
						justify-content: center;
					">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="white" style="transform: rotate(45deg)">
							<path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
						</svg>
					</div>
				</div>
			`,
			iconSize: [50, 50],
			iconAnchor: [25, 50],
			popupAnchor: [0, -50]
		});

		// Agregar marcador
		const marker = L.marker([14.1219, -87.2206], { icon: customIcon }).addTo(map);
		
		// Popup personalizado con colores de la parroquia
		marker.bindPopup(`
			<div style="padding: 16px; font-family: 'Montserrat', system-ui, sans-serif;">
				<div style="display: flex; align-items: center; gap: 8px; margin-bottom: 10px;">
					<div style="
						width: 8px;
						height: 8px;
						border-radius: 50%;
						background: linear-gradient(135deg, #841443 0%, #f9cb33 100%);
						box-shadow: 0 0 8px rgba(132, 20, 67, 0.4);
					"></div>
					<h3 style="font-weight: 700; color: #841443; margin: 0; font-size: 14px;">
						Parroquia El Salvador del Mundo
					</h3>
				</div>
				<p style="margin: 0 0 12px 0; font-size: 12px; color: #64748b; line-height: 1.5;">
					Colonia Cerro Grande Zona 4<br>
					Comayagüela, Tegucigalpa
				</p>
				<div style="display: flex; gap: 6px;">
					<a 
						href="https://www.google.com/maps/dir/?api=1&destination=14.1219,-87.2206" 
						target="_blank"
						style="
							flex: 1;
							display: inline-flex;
							align-items: center;
							justify-content: center;
							gap: 4px;
							padding: 8px 10px;
							background: #841443;
							color: white;
							text-decoration: none;
							border-radius: 8px;
							font-size: 11px;
							font-weight: 600;
						"
					>
						<svg width="12" height="12" fill="white" viewBox="0 0 24 24">
							<path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
						</svg>
						Maps
					</a>
					<a 
						href="https://waze.com/ul?ll=14.1219,-87.2206&navigate=yes" 
						target="_blank"
						style="
							flex: 1;
							display: inline-flex;
							align-items: center;
							justify-content: center;
							gap: 4px;
							padding: 8px 10px;
							background: white;
							color: #841443;
							text-decoration: none;
							border-radius: 8px;
							font-size: 11px;
							font-weight: 600;
							border: 2px solid #841443;
						"
					>
						<svg width="12" height="12" fill="currentColor" viewBox="0 0 24 24">
							<path d="M12 2L4.5 20.29l.71.71L12 18l6.79 3 .71-.71z"/>
						</svg>
						Waze
					</a>
				</div>
			</div>
		`);

		// Ajustar el mapa cuando cambia el tamaño
		window.addEventListener('resize', () => {
			map.invalidateSize();
		});
	}

	// Inicializar cuando el DOM está listo
	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initMap);
	} else {
		initMap();
	}

	// Reinicializar en navegación de Astro
	document.addEventListener('astro:after-swap', initMap);
</script>

<style>
	#map {
		border-radius: inherit;
	}

	:global(.leaflet-container) {
		font-family: 'Montserrat', system-ui, sans-serif;
	}

	:global(.leaflet-popup-content-wrapper) {
		background: white !important;
		border-radius: 16px !important;
		box-shadow: 0 10px 40px rgba(132, 20, 67, 0.15), 0 0 0 1px rgba(132, 20, 67, 0.1) !important;
		padding: 0 !important;
	}

	:global(.leaflet-popup-tip) {
		background: white !important;
	}

	:global(.leaflet-popup-content) {
		margin: 0 !important;
	}

	:global(.custom-marker) {
		background: transparent !important;
		border: none !important;
	}

	@keyframes pulse {
		0%, 100% {
			transform: scale(1);
			opacity: 0.8;
		}
		50% {
			transform: scale(1.15);
			opacity: 0.4;
		}
	}

	:global(.leaflet-control-zoom) {
		border: none !important;
		box-shadow: 0 4px 12px rgba(132, 20, 67, 0.1) !important;
		border-radius: 10px !important;
		overflow: hidden;
	}

	:global(.leaflet-control-zoom a) {
		width: 36px !important;
		height: 36px !important;
		line-height: 36px !important;
		color: #841443 !important;
		border: none !important;
		background: white !important;
		transition: all 0.2s;
		font-size: 18px !important;
		font-weight: 600 !important;
	}

	:global(.leaflet-control-zoom a:hover) {
		background: #f8fafc !important;
		color: #841443 !important;
	}

	:global(.leaflet-control-zoom a:first-child) {
		border-bottom: 1px solid #e2e8f0 !important;
	}

	:global(.leaflet-control-attribution) {
		background: rgba(255, 255, 255, 0.9) !important;
		backdrop-filter: blur(8px);
		color: #64748b !important;
		border-radius: 6px !important;
		padding: 3px 6px !important;
		font-size: 9px !important;
	}

	:global(.leaflet-control-attribution a) {
		color: #841443 !important;
	}
</style>
