---
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';

const allFaqs = await getCollection('faqs');
const faqs = allFaqs
	.sort((a, b) => (a.data.orden ?? 0) - (b.data.orden ?? 0))
	.map(f => f.data);
---

<section class="section-padding bg-surface border-t-2 border-on-surface">
	<div class="container-tight">
		<!-- Header -->
		<div class="mb-12 lg:mb-16 reveal">
			<span class="font-label text-xs font-bold uppercase tracking-[0.2em] text-primary block mb-3">Ayuda</span>
			<h2 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold text-on-background leading-[0.9]">
				Preguntas<br/>Frecuentes
			</h2>
		</div>

		<div class="max-w-3xl">
			{faqs.map((faq, i) => (
				<details class={`group border-b-2 border-on-surface/10 ${i === 0 ? 'border-t-2 border-on-surface' : ''} reveal stagger-${(i % 6) + 1}`}>
					<summary class="flex items-center justify-between py-5 cursor-pointer list-none hover:bg-on-surface/5 transition-colors px-4 -mx-4">
						<span class="font-body text-base font-medium text-on-surface pr-4">{faq.question}</span>
						<Icon name="lucide:chevron-down" class="w-5 h-5 text-on-surface-variant group-open:rotate-180 transition-transform flex-shrink-0" />
					</summary>
					<div class="px-4 pb-5 -mx-4">
						<p class="font-body text-sm text-on-surface-variant leading-relaxed">
							{faq.answer}
						</p>
					</div>
				</details>
			))}
		</div>
	</div>
</section>
